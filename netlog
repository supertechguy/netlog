# ── Shared text classification ────────────────────────────────────────────────
# Used by the formats that give a message tag (Cisco mnemonics, Junos tags,
# Comware/Huawei modules, EXOS conditions) plus free text. Ordered; first hit
# wins. Each rule: (kind or callable(msg)->kind, tag regex, message regex).

_DOWN_UP = re.compile(r'\b(down|up|off-?line|on-?line|disabled|enabled)\b', re.I)


def _updown(msg, down, up):
    """Kind from the LAST up/down word in msg ('changed state to down')."""
    hits = _DOWN_UP.findall(msg)
    if not hits:
        return None
    w = hits[-1].lower()
    return down if w in ('down', 'offline', 'off-line', 'disabled') else up


_NBR_DOWN_RE = re.compile(
    r'\b(?:down|idle|active|connect|init|exstart|dead|reset|closed?|lost|expired|'
    r'notification|hold ?timer|backwardtransition)\b', re.I)
_NBR_UP_RE = re.compile(r'(?:to|state)\s+(?:full|established|up)\b|\bis up\b|\bUp\b', re.I)


def _neighbor_kind(msg):
    m = re.search(r'\bto\s+(\w+)', msg, re.I)       # "from FULL to DOWN", "to Established"
    if m:
        tgt = m.group(1).lower()
        if tgt in ('full', 'established', 'up', 'twoway', '2way'):
            return 'neighbor_up'
        return 'neighbor_down'
    if _NBR_UP_RE.search(msg):
        return 'neighbor_up'
    if _NBR_DOWN_RE.search(msg):
        return 'neighbor_down'
    return None


