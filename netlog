    '8021x_radius_timeout': 'failure', '8021x_deauth': 'disconnect',
    '8021x_client_deauth': 'disconnect', 'wpa_auth': 'auth', 'wpa_deauth': 'disconnect',
    'splash_auth': 'auth', 'mac_auth': 'auth', 'mac_auth_failure': 'failure',
    'wpa_auth_failure': 'failure', 'device_packet_flood': 'threat', 'dfs_event': 'hw',
    'rogue_ssid_detected': 'violation', 'ssid_spoofing_detected': 'violation',
    'vpn_connectivity_change': None, 'anyconnect_vpn_connect': 'vpn_up',
    'anyconnect_vpn_disconnect': 'vpn_down', 'anyconnect_vpn_auth_failure': 'login_fail',
    'client_vpn_connect': 'vpn_up', 'client_vpn_disconnect': 'vpn_down',
}
_MERAKI_MAP = {'client_mac': 'client_mac', 'mac': 'client_mac', 'src': 'src_ip', 'dst': 'dst_ip',
               'sport': 'src_port', 'dport': 'dst_port', 'protocol': 'proto', 'rssi': 'rssi',
               'identity': 'user', 'user': 'user', 'reason': 'reason', 'vap': 'vap',
               'signature': 'signature', 'priority': 'threat_sev', 'ssid': 'ssid',
               'peer_contact': 'peer', 'client_ip': 'client_ip', 'aid': 'aid'}


def _p_meraki(line):
    m = _MERAKI_RE.search(line)
    if not m:
        return None
    epoch, host, cat, rest = m.groups()
    raw = _kv_pairs(rest)
    f   = _map_fields(raw, _MERAKI_MAP)
    f.update(host=host, epoch=epoch.split('.')[0])
    for k in ('src_ip', 'dst_ip'):     # "1.2.3.4:5678"
        v = f.get(k, '')
        if v.count(':') == 1 and '.' in v:
            ip, port = v.split(':')
            f[k] = ip
            f.setdefault('src_port' if k == 'src_ip' else 'dst_port', port)
    if 'client_mac' in f:
        f['client_mac'] = norm_mac(f['client_mac']) or f.pop('client_mac')
    typ = raw.get('type', '')
    if cat == 'events':
        if typ:
            kind = _MERAKI_TYPE.get(typ)
            if typ == 'vpn_connectivity_change':
                kind = 'vpn_up' if raw.get('connectivity') == 'true' else 'vpn_down'
            if kind is None:
                kind = classify_text('', typ.replace('_', ' '))
            name = typ
        else:
            kind = classify_text('', rest)
            name = ' '.join(rest.split()[:3])
            f.update({k: v for k, v in _common_fields(rest, kind).items() if k not in f})
    elif cat in ('flows', 'firewall', 'vpn_firewall', 'cellular_firewall',
                 'bridge_anyconnect_client_vpn_firewall'):
        pat  = rest.split('pattern:', 1)[1].strip() if 'pattern:' in rest else ''
        kind = 'deny' if re.search(r'\bdeny\b|\bblock', pat, re.I) else 'allow'
        name = f'{cat} {"deny" if kind == "deny" else "allow"}'
        f['rule'] = pat[:60] or None
    elif cat in ('ids-alerts', 'security_event'):
        kind = 'threat'
        msg  = rest.split('message:', 1)[1].strip() if 'message:' in rest else ''
        name = msg or raw.get('signature') or typ or cat
        if 'malicious' in rest or 'block' in raw.get('action', ''):
            kind = 'threat'
    elif cat == 'airmarshal_events':
        kind = 'violation'
        name = typ or cat
    else:
        kind = 'session'
        name = cat
    f.update(name=name, kind=kind)
    return {k: v for k, v in f.items() if v is not None}


# CEF (ArcSight Common Event Format): UniFi Network, Fortinet, Check Point,
# Sophos, Trend, Zscaler and others can all send it.
_CEF_RE    = re.compile(r'CEF:\s?(\d+)\|((?:[^|\\]|\\.)*)\|((?:[^|\\]|\\.)*)\|((?:[^|\\]|\\.)*)\|'
                        r'((?:[^|\\]|\\.)*)\|((?:[^|\\]|\\.)*)\|((?:[^|\\]|\\.)*)\|(.*)$')
_CEF_EXT_RE = re.compile(r'([\w.\[\]-]+)=((?:[^=\\]|\\.)*?)(?=\s+[\w.\[\]-]+=|\s*$)')
_CEF_MAP = {'src': 'src_ip', 'dst': 'dst_ip', 'spt': 'src_port', 'dpt': 'dst_port',
            'proto': 'proto', 'act': 'action', 'suser': 'user', 'duser': 'user',
            'smac': 'client_mac', 'msg': 'msg', 'reason': 'reason', 'outcome': 'status',
            'deviceInboundInterface': 'iface', 'cs1': 'rule', 'dvchost': 'host',
            'UNIFIclientMac': 'client_mac', 'UNIFIclientIp': 'client_ip',
            'UNIFIwifiName': 'ssid', 'UNIFIaccessPointName': 'ap_name',
            'UNIFIconnectedToDeviceName': 'ap_name', 'UNIFIlastConnectedToDeviceName': 'ap_name',
            'UNIFIaccessPointMac': 'ap_mac', 'UNIFIconnectedToDeviceMac': 'ap_mac',
            'UNIFIlastConnectedToDeviceMac': 'ap_mac', 'UNIFIwifiRssi': 'rssi',
            'UNIFIrssi': 'rssi', 'UNIFIadmin': 'user', 'UNIFIhost': 'host',
            'UNIFIclientAlias': 'client_host', 'UNIFIclientHostname': 'client_host',
            'UNIFIdeviceName': 'ap_name', 'UNIFIdeviceMac': 'ap_mac',
            'UNIFIipsSignature': 'signature', 'UNIFIipsSessionId': 'session'}


def _cef_sev(s):
    s = s.strip().lower()
    if s.isdigit():
        n = int(s)
        return 1 if n >= 9 else 3 if n >= 7 else 4 if n >= 4 else 6
    return SEV_NAMES.get(s)


def _p_cef(line):
    m = _CEF_RE.search(line)
    if not m:
        return None
    _v, vendor, product, _ver, sig, name, sev, ext = m.groups()
    raw = {k: v.replace('\\=', '=').replace('\\\\', '\\') for k, v in _CEF_EXT_RE.findall(ext)}
    f   = _map_fields(raw, _CEF_MAP)
    for k in ('client_mac', 'ap_mac'):
        if k in f:
            f[k] = norm_mac(f[k]) or f.pop(k)
    act  = (raw.get('act') or '').lower()
    text = f'{name} {raw.get("msg", "")}'
    if re.search(r'deny|denied|drop|block|reject|prevent', act):
        kind = 'deny'
    elif re.search(r'ips|ids|intrusion|threat|malware|virus|attack|exploit|botnet', text, re.I) \
            and not act.startswith(('allow', 'accept', 'permit')):
        kind = 'threat'
    elif act.startswith(('allow', 'accept', 'permit', 'pass')):
        kind = 'allow'
    else:
        low = name.lower()
        kind = ('join' if re.search(r'client (?:connected|joined|associated)', low) else
                'disconnect' if re.search(r'client disconnected', low) else
                'roam' if 'roam' in low else
                'login' if re.search(r'admin (?:accessed|logged in)|login success', low) else
                'login_fail' if re.search(r'login fail|authentication fail', low) else
                'ap_down' if re.search(r'(?:device|ap|access point).*(?:offline|disconnected|lost)',
                                       low) else
                'ap_up' if re.search(r'(?:device|ap|access point).*(?:online|connected|adopted)',
                                     low) else
                classify_text(sig.upper(), text))
    if kind == 'threat' and 'signature' not in f:
        f['signature'] = name
    f.update(name=name, kind=kind, vsev=_cef_sev(sev), vendor=f'{vendor} {product}'.strip(),
             code=sig)
    if raw.get('rt', '').isdigit():
        f['epoch'] = raw['rt']
    return f


# LEEF (IBM Log Event Extended Format) 1.0/2.0
_LEEF_RE = re.compile(r'LEEF:\s?([12]\.0)\|([^|]*)\|([^|]*)\|([^|]*)\|([^|]*)\|(.*)$')
_LEEF_MAP = {'src': 'src_ip', 'dst': 'dst_ip', 'srcPort': 'src_port', 'dstPort': 'dst_port',
             'proto': 'proto', 'usrName': 'user', 'action': 'action', 'srcMAC': 'client_mac',
             'policy': 'rule', 'reason': 'reason', 'msg': 'msg', 'identSrc': 'src_ip'}


def _p_leef(line):
    m = _LEEF_RE.search(line)
    if not m:
        return None
    ver, vendor, product, _pv, eid, ext = m.groups()
    delim = '\t'
    if ver == '2.0' and '|' in ext:
        d, ext = ext.split('|', 1)
        delim = (bytes.fromhex(d[2:]).decode() if d.lower().startswith('x') and len(d) > 1
                 else d or '\t')
    raw = {}
    for part in ext.split(delim):
        if '=' in part:
            k, v = part.split('=', 1)
            raw[k.strip()] = v.strip()
    f   = _map_fields(raw, _LEEF_MAP)
    act = (raw.get('action') or '').lower()
    kind = ('deny' if re.search(r'deny|drop|block|reject', act) else
            'allow' if re.search(r'allow|accept|permit', act) else
            classify_text(eid.upper(), raw.get('msg', eid)))
    sev = raw.get('sev')
    f.update(name=eid, kind=kind, vendor=f'{vendor} {product}'.strip(),
             vsev=_cef_sev(sev) if sev else None)
    return f


# hostapd (UniFi APs, OpenWrt, many embedded APs):
#   hostapd: ath0: STA aa:bb:cc:dd:ee:ff IEEE 802.11: associated
_HOSTAPD_RE = re.compile(
    r'hostapd(?:\[\d+\])?:\s+(\S+):\s+STA ([0-9a-fA-F:]{17})\s+([^:]+):\s*(.*)$')


def _p_hostapd(line):
    m = _HOSTAPD_RE.search(line)
    if not m:
        return None
    vap, mac, mod, msg = m.groups()
    low = msg.lower()
    if re.search(r'fail|timeout|reject|invalid mic|mismatch|eap-failure|denied', low):
        kind = 'failure'
    elif re.search(r'disassociated|deauthenticated|sta left|inactivity', low):
        kind = 'disconnect'
    elif re.search(r'pairwise key handshake completed|authenticated|eap-success|authorized', low):
        kind = 'auth'
    elif re.search(r'\bassociated|reassociated', low):
        kind = 'join'
    else:
        kind = None
    name = f'{mod.strip()}: {msg.split("(")[0].strip()}'[:60]
    return {'name': name, 'kind': kind, 'client_mac': norm_mac(mac), 'iface': vap, 'msg': msg}


# Linux / BSD OpenSSH, sudo and PAM authentication messages.
_IP_ANY = r'(\d{1,3}(?:\.\d{1,3}){3}|[0-9a-fA-F]*:[0-9a-fA-F:]+)'
_SSHD_FAIL_RE = re.compile(
    r'(?:Failed (?:password|publickey|keyboard-interactive(?:/pam)?|none) for (?:invalid user )?(\S+)'
    r'|Invalid user (\S*)'
    r'|maximum authentication attempts exceeded for (?:invalid user )?(\S+)'
    r') from ' + _IP_ANY)
_SSHD_OK_RE   = re.compile(r'Accepted (\S+) for (\S+) from ' + _IP_ANY)
_SUDO_FAIL_RE = re.compile(r'\bsudo(?:\[\d+\])?:\s+(\S+) : (?:\d+ incorrect password attempts?'
                           r'|.*authentication failure)')
_PAM_FAIL_RE  = re.compile(r'pam_unix\(([\w-]+)(?::auth)?\): authentication failure;'
                           r'(?:.*?\brhost=(\S*))?(?:.*?\buser=(\S+))?')


def _p_linux_auth(line):
    m = _SSHD_FAIL_RE.search(line)
    if m and 'sshd' in line:
        user = m.group(1) or m.group(2) or m.group(3) or ''
        name = 'sshd invalid user' if 'nvalid user' in line else 'sshd login failure'
        d = {'name': name, 'kind': 'login_fail', 'src_ip': m.group(4), 'msg': line[m.start():]}
        if user:
            d['user'] = user
        return d
    m = _SSHD_OK_RE.search(line)
    if m and 'sshd' in line:
        return {'name': f'sshd login ({m.group(1)})', 'kind': 'login', 'user': m.group(2),
                'src_ip': m.group(3), 'msg': line[m.start():]}
    m = _SUDO_FAIL_RE.search(line)
    if m:
        return {'name': 'sudo authentication failure', 'kind': 'login_fail',
                'user': m.group(1), 'msg': line[m.start():]}
    m = _PAM_FAIL_RE.search(line)
    if m and not m.group(1).startswith('sshd'):     # sshd logs its own "Failed password"
        d = {'name': f'{m.group(1)} authentication failure', 'kind': 'login_fail',
             'msg': line[m.start():]}
        if m.group(2):
            d['src_ip'] = m.group(2)
        if m.group(3):
            d['user'] = m.group(3)
        return d
    return None


# UniFi AP station tracker:  stahtd[123]: [STA-TRACKER].stahtd_dump_event(): {"mac":..}
def _p_unifi_stahtd(line):
    i = line.find('[STA-TRACKER]')
    if i < 0:
        return None
    j = line.find('{', i)
    try:
        d = json.loads(line[j:]) if j >= 0 else {}
    except ValueError:
        return None
    et   = str(d.get('event_type', ''))
    kind = ('failure' if 'fail' in et else 'disconnect' if 'disassoc' in et or 'leave' in et
            else 'join' if et in ('success', 'fixup', 'associated', 'connected') else None)
    f = {'name': f"{d.get('message_type', 'STA_TRACKER')} {et}".strip(), 'kind': kind,
         'iface': d.get('vap'), 'ssid': d.get('essid') or d.get('ssid')}
    mac = norm_mac(str(d.get('mac', '')))
    if mac:
        f['client_mac'] = mac
    for k in ('assoc_status', 'auth_failures', 'wpa_auth_failures'):
        if str(d.get(k, '0')) not in ('0', ''):
            f['reason'] = f'{k}={d[k]}'
            break
    return {k: v for k, v in f.items() if v}


# Linux netfilter / iptables / nftables / UFW / UniFi & EdgeOS gateways:
#   kernel: [UFW BLOCK] IN=eth0 OUT= MAC=.. SRC=1.2.3.4 DST=.. PROTO=TCP SPT=.. DPT=22
#   kernel: [WAN_IN-4000-D]IN=eth0 ...
_NF_RE = re.compile(r'\bIN=(\S*) OUT=(\S*) .*?\bSRC=([\da-fA-F.:]+) DST=([\da-fA-F.:]+)')


def _p_netfilter(line):
    m = _NF_RE.search(line)
    if not m:
        return None
    prefix = line[:m.start()]
    f = {'iface': m.group(1) or m.group(2), 'src_ip': m.group(3), 'dst_ip': m.group(4)}
    for key, canon in (('PROTO', 'proto'), ('SPT', 'src_port'), ('DPT', 'dst_port')):
        v = re.search(r'\b' + key + r'=(\S+)', line)
        if v:
            f[canon] = v.group(1).lower() if canon == 'proto' else v.group(1)
    rule = re.search(r'\[([\w-]+?)-(?:\d+|default|RET)-?([ADR])?\]', prefix)
    tag  = re.search(r'\[(?:UFW )?([A-Z][A-Z ]*)\]|\b(ACCEPT|DROP|REJECT|DENY|BLOCK|ALLOW)\b',
                     prefix)
    word = ''
    if rule and rule.group(2):
        word = {'A': 'accept', 'D': 'drop', 'R': 'reject'}[rule.group(2)]
        f['rule'] = rule.group(0).strip('[]')
    elif tag:
        word = (tag.group(1) or tag.group(2) or '').lower()
        f['rule'] = word
    if re.search(r'drop|reject|deny|block', word, re.I):
        kind = 'deny'
    elif re.search(r'accept|allow|pass', word, re.I):
        kind = 'allow'
    else:
        kind = None
    f.update(name=f'netfilter {word}'.strip(), kind=kind)
    return f


# pfSense / OPNsense:  filterlog[123]: 5,,,1000000103,igb0,match,block,in,4,0x0,,64,...
def _p_filterlog(line):
    i = line.find('filterlog')
    if i < 0:
        return None
    j = line.find(': ', i)
    if j < 0:
        return None
    c = line[j + 2:].split(',')
    if len(c) < 10:
        return None
    f = {'rule': c[3] or c[0], 'iface': c[4], 'action': c[6]}
    try:
        if c[8] == '4':
            f.update(proto=c[16].lower(), src_ip=c[18], dst_ip=c[19])
            if f['proto'] in ('tcp', 'udp') and len(c) > 21:
                f.update(src_port=c[20], dst_port=c[21])
        elif c[8] == '6':
            f.update(proto=c[12].lower(), src_ip=c[15], dst_ip=c[16])
            if f['proto'] in ('tcp', 'udp') and len(c) > 18:
                f.update(src_port=c[17], dst_port=c[18])
    except IndexError:
        pass
    kind = 'deny' if c[6] in ('block', 'reject') else ('allow' if c[6] == 'pass' else None)
    f.update(name=f'filterlog {c[6]}', kind=kind)
    return {k: v for k, v in f.items() if v}


# MikroTik RouterOS:  firewall,info input: in:ether1 out:(unknown 0), src-mac .., proto TCP (SYN),
#                     1.2.3.4:51234->10.0.0.1:22, len 60
_MT_TOPICS = (r'system|firewall|wireless|interface|dhcp|account|caps|ipsec|ppp|pppoe|l2tp|ovpn|'
              r'hotspot|script|bridge|ospf|bgp|route|dns|ntp|ssh|web-proxy|e-mail|certificate|'
              r'health|lte|wireguard|stp|rstp|mstp|radius|dot1x|poe-out|ups|manager|async|gps|'
              r'sstp|pptp|vrrp|ike2|watchdog|isdn|wifi')
_MT_RE = re.compile(
    r'(?:^|\s)((?:' + _MT_TOPICS + r')(?:,(?:info|warning|error|critical|debug|account|raw|'
    r'packet|' + _MT_TOPICS + r'))+)\s+(.*)$')


def _p_mikrotik(line):
    m = _MT_RE.search(line)
    if not m:
        return None
    topics, msg = m.group(1).split(','), m.group(2)
    lvl  = next((t for t in topics if t in ('critical', 'error', 'warning', 'info', 'debug')), None)
    vsev = {'critical': 2, 'error': 3, 'warning': 4, 'info': 6, 'debug': 7}.get(lvl)
    f, kind = {}, None
    if 'firewall' in topics:
        s = re.search(r'([\da-fA-F.:]+?):(\d+)->([\da-fA-F.:]+?):(\d+)', msg) or \
            re.search(r'(\d{1,3}(?:\.\d{1,3}){3})->(\d{1,3}(?:\.\d{1,3}){3})', msg)
        if s and s.lastindex == 4:
            f.update(src_ip=s.group(1), src_port=s.group(2), dst_ip=s.group(3),
                     dst_port=s.group(4))
        elif s:
            f.update(src_ip=s.group(1), dst_ip=s.group(2))
        p = re.search(r'proto (\w+)', msg)
        if p:
            f['proto'] = p.group(1).lower()
        i = re.search(r'\bin:(\S+?)[ ,]', msg)
        if i:
            f['iface'] = i.group(1)
        pre = msg.split(':', 1)[0]
        kind = ('deny' if re.search(r'drop|reject|deny|block', pre, re.I) else
                'allow' if re.search(r'accept|allow', pre, re.I) else None)
        name = f'firewall {pre}'[:40]
    elif {'wireless', 'caps', 'wifi'} & set(topics):
        w = re.match(r'([0-9A-Fa-f:]{17})@(\S+):\s*(\w[\w ]*?)(?:,|$)', msg)
        if w:
            f.update(client_mac=norm_mac(w.group(1)), iface=w.group(2))
            word = w.group(3).lower()
            kind = ('failure' if re.search(r'reject|fail|not in local acl|timeout', msg, re.I) else
                    'disconnect' if 'disconnect' in word else
                    'join' if 'connect' in word else None)
            r = re.search(r'signal strength (-?\d+)', msg)
            if r:
                f['rssi'] = r.group(1)
            r = re.search(r'disconnected, (.+?)(?:, signal|$)', msg)
            if r:
                f['reason'] = r.group(1)
            name = f'wireless {word}'
        else:
            kind = classify_text('', msg)
            name = 'wireless'
    else:
        if re.search(r'login failure', msg):
            kind = 'login_fail'
        elif re.search(r'logged in', msg):
            kind = 'login'
        elif re.search(r'logged out', msg):
            kind = 'logout'
        elif re.search(r'(?:changed|added|removed) by', msg):
            kind = 'config'
        elif 'interface' in topics:
            kind = _updown(msg, 'link_down', 'link_up')
        else:
            kind = classify_text(topics[0].upper(), msg)
        u = re.search(r'user (\S+)', msg)
        if u and kind in ('login_fail', 'login', 'logout', 'config'):
            f['user'] = u.group(1)
        ip = re.search(r'from (\d{1,3}(?:\.\d{1,3}){3})', msg)
        if ip:
            f['src_ip'] = ip.group(1)
        if 'interface' in topics:
            f['iface'] = msg.split()[0]
        name = f'{topics[0]} ' + ' '.join(msg.split()[:3])
    f.update(name=name[:60], kind=kind, vsev=vsev, msg=msg)
    return f


# SonicWall:  id=firewall sn=C0EAE4.. time="2024-03-01 12:00:00" fw=1.2.3.4 pri=6 c=262144 m=98
#             msg="Connection Opened" src=10.0.0.1:1234:X0 dst=8.8.8.8:53:X1 proto=udp/dns
def _p_sonicwall(line):
    if 'id=' not in line or ' m=' not in line or ('sn=' not in line and 'fw=' not in line):
        return None
    raw = _kv_pairs(line)
    if 'm' not in raw:
        return None
    f   = {}
    for k, ip_k, port_k in (('src', 'src_ip', 'src_port'), ('dst', 'dst_ip', 'dst_port')):
        parts = raw.get(k, '').split(':')
        if parts and parts[0]:
            f[ip_k] = parts[0]
            if len(parts) > 1 and parts[1]:
                f[port_k] = parts[1]
            if len(parts) > 2 and k == 'src':
                f['iface'] = parts[2]
    if raw.get('proto'):
        f['proto'] = raw['proto'].split('/')[0]
    user = raw.get('usr') or raw.get('user')
    if user:
        f['user'] = user
    msg = raw.get('msg', '')
    act = raw.get('fw_action', '').lower()
    low = msg.lower()
    if re.search(r'ips (?:detection|prevention)|anti-virus|anti-spyware|botnet|malware|attack|'
                 r'port scan|scan detected|flood', low):
        kind = 'threat'
    elif act in ('drop', 'deny', 'block') or re.search(r'dropped|denied|blocked', low):
        kind = 'deny'
    elif re.search(r'login (?:denied|failed)|authentication failed|incorrect', low):
        kind = 'login_fail'
    elif re.search(r'logged in|login allowed|login succeeded', low):
        kind = 'login'
    elif act == 'forward' or 'connection opened' in low:
        kind = 'allow'
    elif 'connection closed' in low:
        kind = 'session'
    else:
        kind = classify_text('', msg)
    pri = raw.get('pri', '')
    f.update(name=msg or f'm={raw["m"]}', kind=kind, code=raw['m'], msg=msg,
             vsev=int(pri) if pri.isdigit() and int(pri) < 8 else None)
    if raw.get('time'):
        f['when'] = raw['time'].replace(' ', 'T')
    return f


# Sophos Firewall (XG/SFOS):  device="SFW" date=2024-03-01 time=12:00:00 ... log_type="Firewall"
_SOPHOS_MAP = {'src_ip': 'src_ip', 'dst_ip': 'dst_ip', 'src_port': 'src_port',
               'dst_port': 'dst_port', 'protocol': 'proto', 'fw_rule_id': 'rule',
               'user_name': 'user', 'src_mac': 'client_mac', 'in_interface': 'iface',
               'message': 'msg', 'status': 'status', 'signature_msg': 'signature',
               'device_name': 'host', 'reason': 'reason'}


def _p_sophos(line):
    if 'log_type=' not in line or 'log_component=' not in line:
        return None
    raw = _kv_pairs(line)
    f   = _map_fields(raw, _SOPHOS_MAP)
    lt, sub = raw.get('log_type', ''), raw.get('log_subtype', '')
    text = f"{raw.get('message', '')} {sub} {raw.get('status', '')}"
    if lt in ('IDP', 'Anti-Virus', 'ATP', 'Anti-Spam', 'Sandstorm') or sub == 'Alert':
        kind = 'threat'
    elif lt in ('Firewall', 'Content Filtering', 'Application Filter', 'Web Filter'):
        kind = 'deny' if sub in ('Denied', 'Drop', 'Blocked') or \
            raw.get('status', '').lower() in ('deny', 'drop', 'blocked') else 'allow'
    elif re.search(r'authentication', lt + raw.get('log_component', ''), re.I) or \
            sub == 'Authentication':
        kind = 'login_fail' if re.search(r'fail', text, re.I) else 'login'
    else:
        kind = classify_text(raw.get('log_component', '').upper(), text)
    if 'client_mac' in f:
        f['client_mac'] = norm_mac(f['client_mac']) or f.pop('client_mac')
    if 'date' in raw and 'time' in raw:
        f['when'] = f"{raw['date']}T{raw['time']}"
    f.update(name=f"{lt}/{sub}".strip('/') or raw.get('log_component', 'sophos'), kind=kind,
             vsev=SEV_NAMES.get(raw.get('priority', '').lower()))
    return f


# Check Point (syslog exporter):  ... [action:"Drop"; src:"1.2.3.4"; dst:".."; ...]
_CP_KV_RE = re.compile(r'(\w+):"((?:[^"\\]|\\.)*)"')


def _p_checkpoint(line):
    if 'product:"' not in line and 'origin:"' not in line:
        return None
    raw = dict(_CP_KV_RE.findall(line))
    if 'action' not in raw and 'product' not in raw:
        return None
    f = _map_fields(raw, {'src': 'src_ip', 'dst': 'dst_ip', 's_port': 'src_port',
                          'service': 'dst_port', 'proto': 'proto', 'rule_name': 'rule',
                          'rule': 'rule', 'src_user_name': 'user', 'user': 'user',
                          'ifname': 'iface', 'protection_name': 'signature',
                          'attack': 'signature', 'severity': 'threat_sev', 'reason': 'reason',
                          'origin': 'host', 'src_machine_name': 'client_host'})
    if f.get('proto') in _PROTO_NUM:
        f['proto'] = _PROTO_NUM[f['proto']]
    act = raw.get('action', '').lower()
    if act in ('prevent', 'detect') or raw.get('protection_name') or raw.get('attack'):
        kind = 'threat'
    elif act in ('drop', 'reject', 'block'):
        kind = 'deny'
    elif act in ('accept', 'allow'):
        kind = 'allow'
    elif act in ('failed log in', 'log in failed') or 'fail' in raw.get('auth_status', '').lower():
        kind = 'login_fail'
    elif act in ('log in', 'logged in') or raw.get('auth_status', '').lower() == 'successful login':
        kind = 'login'
    elif act in ('key install',):
        kind = 'vpn_up'
    else:
        kind = classify_text(raw.get('product', '').upper(), act)
    f.update(name=f"{raw.get('product', 'Check Point')} {act}".strip(), kind=kind)
    return f


# FreeRADIUS:  Auth: (123) Login incorrect (mschap: ...): [alice] (from client wlc port 0 cli aa-bb-..)
_FR_RE = re.compile(r'\bAuth: (?:\(\d+\) )?(Login OK|Login incorrect|Invalid user)'
                    r'(?: \(([^)]*)\))?: \[([^\]]*)\](?: \(from client (\S+) port (\S+)'
                    r'(?: cli ([0-9A-Fa-f:.\-]+))?)?')


_FR_UNKNOWN_RE = re.compile(r'from unknown client ([0-9a-fA-F.:]+) port \d+')
_FR_SECRET_RE  = re.compile(r'(?:Received packet|from client) (?:from )?([0-9a-fA-F.:]+) with invalid '
                            r'Message-Authenticator|Shared secret is incorrect')
_FR_HOME_RE    = re.compile(r'Marking home server ([0-9a-fA-F.:]+) port (\d+) as (dead|alive|zombie)')


def _p_freeradius(line):
    ts = _ts_ctime(line) if ' : ' in line[:40] else None      # radius.log "Fri Mar  1 ... 2024 : "
    m = _FR_RE.search(line)
    if not m:
        u = _FR_UNKNOWN_RE.search(line)
        if u:
            return {'name': 'RADIUS request from unknown client', 'kind': 'radius',
                    'status': 'unknown client', 'src_ip': u.group(1), 'vsev': 4, 'ts': ts}
        u = _FR_SECRET_RE.search(line)
        if u:
            ip = u.group(1) or _first(re.compile(r'from (?:client )?([0-9a-fA-F.:]+)'), line)
            return {'name': 'RADIUS shared secret mismatch', 'kind': 'radius',
                    'status': 'bad secret', 'src_ip': ip, 'vsev': 3, 'ts': ts}
        u = _FR_HOME_RE.search(line)
        if u:
            up = u.group(3) == 'alive'
            return {'name': f'RADIUS home server {u.group(3)}',
                    'kind': 'service_up' if up else 'service_down',
                    'service': f'RADIUS {u.group(1)}:{u.group(2)}', 'ts': ts}
        return None
    res, reason, user, nas, port, cli = m.groups()
    f = {'name': f'radius {res}', 'kind': 'auth' if res == 'Login OK' else 'failure',
         'user': user.split('/')[0] or None, 'reason': reason, 'nas': nas, 'ts': ts}
    if cli and norm_mac(cli):
        f['client_mac'] = norm_mac(cli)
    return {k: v for k, v in f.items() if v}


# Cisco ISE:  CISE_Failed_Attempts 0000123 1 0 2024-03-01 12:00:00.000 +00:00 0000001 5400 NOTICE
#             Failed-Attempt: Authentication failed, ConfigVersionId=1, UserName=alice, ...
_ISE_RE = re.compile(r'\b(CISE_\w+) \d+ \d+ \d+ (\d{4}-\d{2}-\d{2} [\d:.]+ [+-]\d{2}:?\d{2}) '
                     r'\d+ (\d{4,5}) (\w+) ([^:,]+):\s*([^,]*),?(.*)$')


def _p_ise(line):
    m = _ISE_RE.search(line)
    if not m:
        return None
    cat, when, code, sevw, klass, text, rest = m.groups()
    raw = {}
    for part in re.split(r',\s*(?=[\w\-. ]+=)', rest):
        if '=' in part:
            k, v = part.split('=', 1)
            raw[k.strip()] = v.strip()
    f = _map_fields(raw, {'UserName': 'user', 'User-Name': 'user', 'Calling-Station-ID': 'client_mac',
                          'NetworkDeviceName': 'nas', 'NAS-Port-Id': 'iface',
                          'FailureReason': 'reason', 'Location': 'ap_loc',
                          'NAS-IP-Address': 'nas_ip', 'Framed-IP-Address': 'client_ip',
                          'SSID': 'ssid'})
    if 'client_mac' in f:
        f['client_mac'] = norm_mac(f['client_mac']) or f.pop('client_mac')
    called = raw.get('Called-Station-ID', '')
    if ':' in called and 'ssid' not in f:
        f['ssid'] = called.rsplit(':', 1)[1]
    kind = ('failure' if 'Failed' in cat or code in ('5400', '5405', '5411', '5417', '5440')
            else 'auth' if 'Passed' in cat or code in ('5200', '5236') else
            'login_fail' if 'Administrator' in cat and 'fail' in text.lower() else
            'config' if 'Administrative' in cat else None)
    f.update(name=f'ISE {code} {text.strip()}'[:60], kind=kind,
             vsev=SEV_NAMES.get(sevw.lower()), when=when.replace(' ', 'T', 1).replace(' ', ''))
    return f


# Extreme Networks EXOS:  <Info:vlan.msgs.portLinkStateDown> Port 1:1 link down
_EXOS_RE = re.compile(r'<(Emer|Alrt|Crit|Erro|Warn|Noti|Info|Dbug|Summ|Verb)\w*:([\w.]+)>\s*(.*)$')


def _p_exos(line):
    m = _EXOS_RE.search(line)
    if not m:
        return None
    lvl, tag, msg = m.groups()
    kind = classify_text(tag.upper().replace('.', '_'), msg)
    if 'LinkStateDown' in tag:
        kind = 'link_down'
    elif 'LinkStateUp' in tag:
        kind = 'link_up'
    f = _common_fields(msg, kind)
    p = re.search(r'\bPort (\d+(?::\d+)?)', msg)
    if p:
        f['iface'] = p.group(1)
    f.update(name=tag, kind=kind, vsev=SEV_NAMES.get(lvl.lower()), msg=msg)
    return f


# Ruckus ICX / Brocade FastIron switches (no message tags):
#   Interface ethernet1/1/1, state down / Security: SSH login by admin from src IP ...
_ICX_RE = re.compile(
    r'\b(Interface (?:ethernet|ve|lag|management)\s?\S+, state (?:up|down)|'
    r'Security: |STP: |MSTP: |DOT1X: |MAC Authentication |Loop Detection: |'
    r'System: (?:Module|Fan|PoE|Power|Temperature)|PoE: |Port \S+ is (?:shut down|disabled))(.*)$')


def _p_icx(line):
    m = _ICX_RE.search(line)
    if not m:
        return None
    msg  = m.group(0)
    head = m.group(1).split(':')[0].split(',')[0].strip()
    kind = classify_text(head.upper().replace(' ', '_'), msg)
    if head.startswith('Interface'):
        kind = 'link_down' if msg.rstrip().endswith('down') or 'state down' in msg else 'link_up'
    elif head == 'Security' and re.search(r'fail|reject|denied|invalid', msg, re.I):
        kind = 'login_fail'
    elif head == 'Security' and 'login' in msg.lower():
        kind = 'login'
    f = _common_fields(msg, kind)
    if head.startswith('Interface'):
        f['iface'] = head.split()[1]
    f.update(name=head if not head.startswith('Interface') else 'Interface state', kind=kind,
             msg=msg)
    return f


# Dell EMC OS10:  %Node.1-Unit.1:PRI:OS10 %Dell EMC (OS10) %IFM_OSTATE_DN: Interface ...
_OS10_RE = re.compile(r'%Dell EMC \(OS10\) %([A-Z][A-Z0-9_]+):\s*(.*)$')


def _p_os10(line):
    m = _OS10_RE.search(line)
    if not m:
        return None
    tag, msg = m.groups()
    kind = 'link_down' if tag.endswith(('_DN', '_DOWN')) and 'OSTATE' in tag else \
        'link_up' if tag.endswith('_UP') and 'OSTATE' in tag else classify_text(tag, msg)
    f = _common_fields(msg, kind)
    f.update(name=tag, kind=kind, msg=msg)
    return f


# ── Linux servers and services ───────────────────────────────────────────────
#
# Web servers (Apache, nginx, Squid), DNS (BIND, dnsmasq), DHCP (ISC dhcpd,
# dnsmasq), Samba, mail (Postfix, Dovecot), FTP, fail2ban, systemd and auditd.
# Their high-volume events (requests, queries, leases, mail, file operations)
# get service kinds that are aggregated by ServiceStats instead of kept.

@functools.lru_cache(maxsize=4096)
def _epoch_parts(y, mon, d, h, mi, s, tz=''):
    """Epoch for date parts (month as a number or name); tz like '+0100'."""
    try:
        mo = int(mon) if mon.isdigit() else _MONTHS[mon[:3].lower()]
        dt = datetime.datetime(int(y), mo, int(d), int(h), int(mi), int(s))
        if tz:
            off = datetime.timedelta(hours=int(tz[1:3]), minutes=int(tz[3:5]))
            dt  = dt.replace(tzinfo=datetime.timezone(off if tz[0] == '+' else -off))
        return dt.timestamp()
    except (ValueError, KeyError, OverflowError):
        return None


_TS_CTIME_RE = re.compile(r'\b\w{3} (\w{3}) +(\d{1,2}) (\d\d):(\d\d):(\d\d)(?:\.\d+)? (\d{4})\b')
_TS_SLASH_RE = re.compile(r'(\d{4})/(\d\d)/(\d\d) (\d\d):(\d\d):(\d\d)')
_TS_DMY_RE   = re.compile(r'\b(\d{1,2})-(\w{3})-(\d{4}) (\d\d):(\d\d):(\d\d)')


def _ts_ctime(text):
    """'Fri Mar  1 12:00:00 2024' (Apache error, radius.log, vsftpd.log)."""
    m = _TS_CTIME_RE.search(text[:60])
    return _epoch_parts(m.group(6), m.group(1), m.group(2), *m.group(3, 4, 5)) if m else None


def _ts_slash(text):
    m = _TS_SLASH_RE.search(text[:60])
    return _epoch_parts(*m.groups()) if m else None


def _strip_port(addr):
    """'1.2.3.4:5678' / '[2001:db8::1]:5678' / '2001:db8::1:5678' → address."""
    addr = addr.strip('[]')
    if addr.count(':') == 1:
        return addr.split(':')[0]
    if '[' in addr or ']:' in addr:
        return addr.split(']')[0].strip('[')
    head, _, tail = addr.rpartition(':')
    if head and tail.isdigit() and len(tail) <= 5 and ip_scope(head):
        return head
    return addr


def _short_msg(msg, n=60):
    """A message with paths, quoted strings and numbers blanked, for grouping."""
    msg = re.sub(r'"[^"]*"|\'[^\']*\'', '"…"', msg)
    msg = re.sub(r'(?<![\w/])/[\w./\-~%]+', '/…', msg)
    msg = re.sub(r'\b\d[\d.:]*\b', 'N', msg)
    return msg.strip()[:n]


# Web attack signatures, checked on the request (raw and URL-decoded), the
# user agent and the referer. One combined regex; the group says which.
_WEB_ATTACKS = [
    ('log4shell', 'Log4Shell (JNDI)', r'\$\{(?:jndi|lower:|upper:|env:|sys:|date:|::-|\$\{)'),
    ('traversal', 'path traversal', r'\.\./|\.\.\\|\.\.%2f|%2e%2e|/etc/(?:passwd|shadow)\b'
                                    r'|win\.ini|boot\.ini|/proc/self/environ'),
    ('cmdi', 'command injection',
     r'(?:;|\||`|\$\(|%3b|%7c|%60)\s*(?:wget|curl|cat|id|uname|whoami|bash|sh|nc|ncat|chmod|'
     r'busybox|powershell|tftp)\b|/bin/(?:ba)?sh\b|cmd\.exe'),
    ('sqli', 'SQL injection',
     r'union(?:\s|\+|%20|/\*.*?\*/)+(?:all(?:\s|\+|%20)+)?select|\bselect(?:\s|\+|%20)+\S*'
     r'(?:\s|\+|%20)+from(?:\s|\+|%20)|\'\s*or\s+\'?\d+\'?\s*=\s*\'?\d|(?:\s|\+|%20)or(?:\s|\+|%20)'
     r'+1=1|\bsleep\(\s*\d|benchmark\(|information_schema|waitfor(?:\s|\+|%20)+delay|pg_sleep'),
    ('xss', 'cross-site scripting',
     r'<script|%3cscript|javascript:|onerror\s*=|onload\s*=|<svg[\s/]|%3csvg|document\.cookie'),
    ('webshell', 'web shell',
     r'/(?:shell|cmd|c99|r57|wso|b374k|webshell|alfa)\.php|eval-stdin\.php'),
    ('sensitive', 'sensitive file',
     r'/\.env(?:\.\w+)?(?:$|[?/\s])|/\.git/|/\.svn/|/\.hg/|/\.aws/|/\.ssh/|/\.htpasswd|wp-config\.php'
     r'|/(?:backup|db|dump|database)\.(?:sql|zip|tar\.gz|tgz)|/phpinfo\.php|/\.ds_store|/id_rsa'),
    ('probe', 'exploit probe',
     r'/(?:phpmyadmin|pma|myadmin|adminer)\b|/wp-admin/(?:setup-config|install)\.php|/hnap1'
     r'|/boaform|/vendor/phpunit|/actuator(?:/|$|\s)|/solr/admin|/manager/html|/owa/auth'
     r'|/remote/fgt_lang|/\+cscoe\+|/_ignition/|/telescope/|/druid/|/geoserver/|/cgi-bin/'),
    ('scanner', 'scanner user agent',
     r'sqlmap|nikto|\bnmap\b|masscan|zgrab|nuclei|wpscan|dirbuster|gobuster|\bffuf\b|acunetix'
     r'|nessus|openvas|feroxbuster|wfuzz|zmeu|l9explore|netsparker|whatweb'),
]
_WEB_ATTACK_RX = {g: re.compile(rx, re.I) for g, _l, rx in _WEB_ATTACKS}
WEB_ATTACK_LABELS = {g: label for g, label, _rx in _WEB_ATTACKS}
# Cheap substring gates (lowercase): a signature's regex only runs when one
# of its keywords is in the request, so ordinary requests cost a few
# substring checks. Checked in this order, most serious first.
_WEB_ATTACK_KEYS = [
    ('traversal', ('..', '/etc/', 'win.ini', 'boot.ini', '/proc/')),
    ('cmdi', (';', '|', '`', '$(', '/bin/', 'cmd.exe')),
    ('sqli', ('union', 'select', "'", 'sleep(', 'benchmark(', 'information_schema', 'waitfor',
              'or+1', 'or 1', 'or%201')),
    ('xss', ('<', 'javascript:', 'onerror', 'onload', 'document.cookie')),
    ('webshell', ('.php',)),
    ('sensitive', ('/.', 'wp-config', 'backup.', 'db.', 'dump.', 'database.', 'phpinfo', 'id_rsa')),
    ('probe', ('phpmyadmin', 'pma', 'myadmin', 'adminer', 'wp-admin/', 'hnap1', 'boaform', 'phpunit',
               'actuator', 'solr', 'manager/html', 'owa/', 'fgt_lang', 'cscoe', '_ignition',
               'telescope', 'druid', 'geoserver', 'cgi-bin')),
]
_SCANNER_KEYS = ('sqlmap', 'nikto', 'nmap', 'masscan', 'zgrab', 'nuclei', 'wpscan', 'dirbuster',
                 'gobuster', 'ffuf', 'acunetix', 'nessus', 'openvas', 'feroxbuster', 'wfuzz', 'zmeu',
                 'l9explore', 'netsparker', 'whatweb')
# A 2xx answer to these suggests the attack worked.
# (Log4Shell isn't here: its payload is usually in a header, so the status says nothing.)
WEB_ATTACK_SERIOUS = {'traversal', 'cmdi', 'webshell', 'sensitive'}


def web_attack(path, ua=None, ref=None):
    """Attack id for a request (its path/URL, user agent, referer), or None."""
    path = path or ''
    hdrs = f'{ua or ""} {ref or ""}'
    if '${' in path or '${' in hdrs:
        if _WEB_ATTACK_RX['log4shell'].search(f'{path} {hdrs}'):
            return 'log4shell'
    low = path.lower()
    if '%' in low:
        low = f'{low} {urllib.parse.unquote_plus(low)}'
        if '${' in low and _WEB_ATTACK_RX['log4shell'].search(low):
            return 'log4shell'
    if '() {' in hdrs:
        return 'cmdi'                      # Shellshock
    for g, keys in _WEB_ATTACK_KEYS:
        for k in keys:
            if k in low:
                if _WEB_ATTACK_RX[g].search(low):
                    return g
                break
    if ua:
        lua = ua.lower()
        for k in _SCANNER_KEYS:
            if k in lua:
                return 'scanner'
    return None


# Apache / nginx combined and common log format, optionally with a leading
# "vhost:port" (vhost_combined) or a syslog header.
_CLF_RE = re.compile(
    r'(\S+) (\S+) (\S+|"[^"]*") \[(\d{2})/(\w{3})/(\d{4}):(\d{2}):(\d{2}):(\d{2}) ([+-]\d{4})\] '
    r'"((?:[^"\\]|\\.)*)" (\d{3}|-) (\d+|-)(?: "((?:[^"\\]|\\.)*)" "((?:[^"\\]|\\.)*)")?')
_VHOST_RE = re.compile(r'([A-Za-z0-9.\-]+):\d+ $')


def _http_fields(src, method, path, code, size, ua, ref, user, site):
    attack = web_attack(path, ua, ref)
    vsev   = 3 if code >= 500 else 4 if attack else 5 if code >= 400 else 6
    f = {'name': f'HTTP {code}' if code else 'HTTP request', 'kind': 'http', 'vsev': vsev,
         'src_ip': src, 'method': method, 'path': (path or '-')[:200], 'code': code,
         'bytes': size, 'ua': (ua or '')[:150], 'site': site, 'attack': attack}
    if user and user not in ('-', '""'):
        f['user'] = user.strip('"')
    bare = (path or '').split('?')[0]
    if code == 401 and 'user' in f:
        f.update(name='HTTP auth failure', kind='login_fail')
    elif method == 'POST' and bare.endswith('/wp-login.php') and code in (200, 302):
        f.update(name='WordPress login' + (' failure' if code == 200 else ''),
                 kind='login_fail' if code == 200 else 'login')
    return f


def _p_web_access(line):
    m = _CLF_RE.search(line)
    if not m:
        return None
    (src, _ident, user, dd, mon, yy, hh, mi, ss, tz, req, status, size, ref, ua) = m.groups()
    parts = req.split(' ')
    if len(parts) == 3 and parts[2].startswith('HTTP/'):
        method, path = parts[0], parts[1]
    elif len(parts) == 2 and parts[0].isupper():
        method, path = parts
    else:
        method, path = None, req[:80] or '-'
    v = _VHOST_RE.search(line, 0, m.start())
    f = _http_fields(src, method, path, int(status) if status != '-' else 0,
                     0 if size == '-' else int(size), ua, ref, user,
                     v.group(1) if v and v.end() == m.start() else None)
    f['ts'] = _epoch_parts(yy, mon, dd, hh, mi, ss, tz)
    return f


# Squid native access.log:
#   1709294400.123    234 10.0.0.5 TCP_MISS/200 5120 GET http://example.com/ - HIER_DIRECT/1.2.3.4 text/html
_SQUID_RE = re.compile(r'(?:^|\s)(\d{9,10})\.\d{3}\s+(\d+) (\S+) ([A-Z_]+)/(\d{3}) (\d+) (\S+) (\S+)'
                       r' (\S+) ([A-Z_]+)/(\S+)')


def _p_squid(line):
    m = _SQUID_RE.search(line)
    if not m:
        return None
    epoch, _ms, src, result, code, size, method, url, user, _hier, peer = m.groups()
    u    = urllib.parse.urlsplit(url if '://' in url else f'//{url}')
    site = u.hostname or url.split(':')[0]
    f = _http_fields(src, method, (u.path or '/') + (f'?{u.query}' if u.query else ''), int(code),
                     int(size), None, None, user, site)
    f.update(ts=int(epoch), result=result, proxy=True)
    if result.endswith('DENIED'):
        f['name'] = 'proxy denied'
    return f


# Apache error log, 2.4 and 2.2:
#   [Fri Mar 01 12:00:00.123456 2024] [core:error] [pid 12:tid 34] [client 1.2.3.4:5678] AH00126: ...
#   [Fri Mar 01 12:00:00 2024] [error] [client 1.2.3.4] File does not exist: /var/www/x
_APACHE_ERR_RE = re.compile(
    r'\[\w{3} \w{3} +\d{1,2} [\d:.]+ \d{4}\] \[(?:([\w-]+):)?(\w+)\](?: \[pid \d+(?::tid \d+)?\])?'
    r'(?: \[remote [^\]]*\])?(?: \[client ([^\]]+)\])? ?(?:(AH\d{5}): )?(.*)$')
_HTTPD_AUTH_RE = re.compile(r'user [\'"]?([^\s:\'"]+)[\'"]?:? (?:authentication failure|not found'
                            r'|was not found|password mismatch)', re.I)
_MODSEC_RE = re.compile(r'ModSecurity: (.*?)(?: \[file |$)')


def _modsec(msg, f):
    """mod_security alerts become threat events."""
    m = _MODSEC_RE.search(msg)
    if not m:
        return False
    sig = re.search(r'\[msg "([^"]*)"\]', msg)
    sev = re.search(r'\[severity "([^"]*)"\]', msg)
    uri = re.search(r'\[uri "([^"]*)"\]', msg)
    f.update(kind='threat', name='ModSecurity', signature=(sig.group(1) if sig else m.group(1))[:80],
             threat_sev=(sev.group(1).lower() if sev else None), path=uri.group(1) if uri else None)
    return True


def _p_apache_error(line):
    m = _APACHE_ERR_RE.search(line)
    if not m:
        return None
    module, level, client, code, msg = m.groups()
    f = {'kind': None, 'vsev': SEV_NAMES.get(level.lower(), 7 if level.startswith('trace') else None),
         'module': module, 'ah': code, 'msg': msg[:300], 'ts': _ts_ctime(line)}
    if client:
        f['src_ip'] = _strip_port(client)
    a = _HTTPD_AUTH_RE.search(msg)
    if a:
        f.update(kind='login_fail', name='HTTP auth failure', user=a.group(1))
    elif not _modsec(msg, f):
        f['name'] = (f'{code} ' if code else '') + _short_msg(msg.split(', referer:')[0], 50)
        f['attack'] = web_attack(msg)
    return f


# nginx error log:  2024/03/01 12:00:00 [error] 123#123: *5 open() "/x" failed (2: ...), client: ...
_NGINX_ERR_RE = re.compile(r'(\d{4})/(\d\d)/(\d\d) (\d\d):(\d\d):(\d\d) \[(\w+)\] \d+#\d+: (?:\*\d+ )?(.*)$')
_NGINX_KV_RE  = re.compile(r', (client|server|request|upstream|host): ("[^"]*"|[^,]*)')
_UPSTREAM_BAD = re.compile(r'upstream timed out|connect\(\) failed .* while connecting to upstream'
                           r'|no live upstreams|upstream prematurely closed', re.I)


def _p_nginx_error(line):
    m = _NGINX_ERR_RE.search(line)
    if not m:
        return None
    level, msg = m.group(7), m.group(8)
    kv   = {k: v.strip('"') for k, v in _NGINX_KV_RE.findall(msg)}
    text = msg.split(', client:')[0]
    f = {'kind': None, 'vsev': SEV_NAMES.get(level.lower()), 'msg': msg[:300],
         'ts': _epoch_parts(*m.groups()[:6]), 'site': kv.get('server') or kv.get('host')}
    if kv.get('client'):
        f['src_ip'] = kv['client']
    req = kv.get('request', '').split(' ')
    if len(req) >= 2:
        f.update(method=req[0], path=req[1][:200])
    a = _HTTPD_AUTH_RE.search(text)
    if a:
        f.update(kind='login_fail', name='HTTP auth failure', user=a.group(1))
    elif _modsec(msg, f):
        pass
    elif _UPSTREAM_BAD.search(text):
        up = urllib.parse.urlsplit(kv.get('upstream', '')).netloc or kv.get('upstream') or 'upstream'
        f.update(kind='service_down', name='nginx upstream failure', service=up)
    else:
        f['name'] = _short_msg(re.sub(r'^\S+\(\) ', '', text) if 'limiting' not in text
                               else 'limiting requests', 50)
        f['attack'] = web_attack(f.get('path'))
    return f


# BIND named: query log, security (denied), zone transfers, zone loading, resolver.
_BIND_CLIENT_RE = re.compile(r'\bclient (?:@0x[0-9a-fA-F]+ )?([0-9a-fA-F.:]+)#\d+(?: \(([^)]*)\))?:'
                             r' (?:view [^:]+: )?(.*)$')
_BIND_QUERY_RE  = re.compile(r'^query: (\S+) (?:IN|CH|HS) (\S+)')
_BIND_QUOTED_RE = re.compile(r"'([^'/]*)/([^'/]*)(?:/([^']*))?'")
_BIND_CAT_RE    = re.compile(r'\b(?:queries|security|xfer-in|xfer-out|lame-servers|query-errors|'
                             r'resolver|general|update-security|notify|default|client): '
                             r'(?:info|notice|warning|error|critical|debug \d+): ')


def _p_bind(line):
    if 'named' not in line and not _BIND_CAT_RE.search(line):
        return None
    m  = _TS_DMY_RE.search(line[:40])
    ts = _epoch_parts(m.group(3), m.group(2), m.group(1), *m.group(4, 5, 6)) if m else None
    f  = {'kind': 'dns', 'ts': ts}
    c  = _BIND_CLIENT_RE.search(line)
    if c:
        src, qname, msg = c.groups()
        f['src_ip'] = src
        q = _BIND_QUERY_RE.search(msg)
        if q:
            f.update(name='DNS query', status='query', query=q.group(1), qtype=q.group(2), vsev=6)
            return f
        quoted = _BIND_QUOTED_RE.search(msg)
        if quoted:
            f.update(query=quoted.group(1), qtype=quoted.group(2) if quoted.group(3) else None)
        elif qname:
            f['query'] = qname
        if msg.endswith('denied') or 'denied' in msg.split("'")[-1]:
            st = ('zone transfer denied' if 'transfer' in msg else
                  'update denied' if msg.startswith('update') else 'query denied')
            f.update(name=f'DNS {st}', status=st, vsev=4)
            if f.get('qtype') in ('AXFR', 'IXFR'):
                f['status'] = 'zone transfer denied'
            return f
        if 'zone transfer' in msg and 'denied' in msg or 'bad zone transfer request' in msg:
            f.update(name='DNS zone transfer denied', status='zone transfer denied', vsev=4)
            return f
        if 'rate limit' in msg:
            f.update(name='DNS rate limited', status='rate limited', vsev=5)
            return f
        f.update(name='DNS ' + _short_msg(msg, 40), status='client', vsev=None)
        return f
    msg = line
    z = re.search(r"\bzone ([^/\s]+)/\w+(?:/\S+)?: (.*)$", msg)
    if z:
        zone, text = z.groups()
        bad = re.search(r'fail|error|not loaded|expired|refused|timed out|bad|unable', text, re.I)
        f.update(name='DNS zone ' + ('problem' if bad else 'event'), zone=zone,
                 status='zone problem' if bad else 'zone event', msg=text[:200], vsev=3 if bad else 6)
        return f
    x = re.search(r"transfer of '([^'/]+)/[^']*' from ([0-9a-fA-F.:]+)#\d+: (.*)$", msg)
    if x:
        zone, peer, text = x.groups()
        bad = re.search(r'fail|refused|error|timed out', text, re.I)
        f.update(name='DNS zone transfer' + (' failed' if bad else ''), zone=zone, peer=peer,
                 status='zone problem' if bad else 'zone transfer', msg=text[:200],
                 vsev=3 if bad else 6)
        return f
    if re.search(r'SERVFAIL|lame server|network unreachable resolving|timed out resolving'
                 r'|FORMERR|format error', msg):
        f.update(name='DNS resolution failure', status='resolution failure', vsev=5,
                 msg=_msg_part(msg)[:200])
        return f
    return None


# dnsmasq DNS and DHCP.
_DNSMASQ_Q_RE    = re.compile(r'\bdnsmasq\[\d+\]: (?:\d+ [\d.:a-f]+/\d+ )?query\[(\w+)\] (\S+) from (\S+)')
_DNSMASQ_DHCP_RE = re.compile(r'\b(DHCP[A-Z]+)\((\S+)\)(?: ([\d.]+))?(?: ([0-9a-fA-F:]{17}))?(?: (.*))?$')


def _p_dnsmasq(line):
    if 'dnsmasq' not in line:
        return None
    m = _DNSMASQ_Q_RE.search(line)
    if m:
        return {'name': 'DNS query', 'kind': 'dns', 'status': 'query', 'qtype': m.group(1),
                'query': m.group(2), 'src_ip': m.group(3), 'vsev': 6}
    m = _DNSMASQ_DHCP_RE.search(line)
    if m and 'dnsmasq-dhcp' in line:
        typ, iface, ip, mac, rest = m.groups()
        return _dhcp_event(typ, ip, mac, iface, (rest or '').strip(), line)
    i = line.find('dnsmasq[')
    msg = line[line.find(':', i) + 1:].strip() if i >= 0 else ''
    if re.match(r'(?:forwarded|reply|cached|config|/\S+|validation|dnssec-query|query)\b', msg):
        st = 'nxdomain' if msg.endswith('NXDOMAIN') else 'reply'
        return {'name': 'DNS ' + st, 'kind': 'dns', 'status': st, 'vsev': 7}
    if 'Maximum number of concurrent DNS queries' in msg:
        return {'name': 'DNS server overloaded', 'kind': 'dns', 'status': 'overloaded', 'vsev': 4}
    return None


# ISC dhcpd:  DHCPACK on 10.0.0.5 to aa:bb:cc:dd:ee:ff (host) via eth1
_DHCPD_RE = re.compile(r'\b(DHCP(?:DISCOVER|OFFER|REQUEST|ACK|NAK|RELEASE|DECLINE|INFORM|LEASEQUERY))'
                       r' (?:on|for|of|from|to) (.*)$')
_DHCP_VIA_RE  = re.compile(r'\bvia (\S+?)(?::|\s|$)')
_DHCP_HOST_RE = re.compile(r'\(([^()\d][^()]*)\) via')


def _dhcp_event(typ, ip, mac, iface, rest, line):
    st = typ[4:].lower()
    if 'no free leases' in rest or 'no address available' in rest:
        # Left to the "DHCP pool exhausted" text detector.
        return {'name': f'{typ} (pool exhausted)', 'kind': None, 'mac': mac,
                'iface': iface, 'vsev': 3, 'dhcp': st, 'status': 'no free leases'}
    vsev = 4 if st in ('nak', 'decline') else 6
    return {'name': typ, 'kind': 'dhcp', 'dhcp': st, 'ip': ip, 'client_mac': mac, 'iface': iface,
            'vsev': vsev, 'msg': rest[:120] or None}


def _p_dhcpd(line):
    m = _DHCPD_RE.search(line)
    if not m:
        a = re.search(r'Abandoning IP address ([\d.]+): (.*)$', line)
        if a:
            return {'name': 'DHCP address abandoned', 'kind': 'dhcp', 'dhcp': 'abandon',
                    'ip': a.group(1), 'msg': a.group(2), 'vsev': 4}
        p = re.search(r'failover peer (\S+?): I move from (\S+) to (\S+)', line)
        if p:
            return {'name': 'DHCP failover state change', 'kind': 'failover', 'peer': p.group(1),
                    'msg': f'{p.group(2)} → {p.group(3)}'}
        return None
    typ, rest = m.groups()
    ip  = IP4_RE.search(rest)
    mac = MAC_RE.search(rest)
    via = _DHCP_VIA_RE.search(rest)
    f   = _dhcp_event(typ, ip.group() if ip else None, mac.group() if mac else None,
                      via.group(1) if via else None, rest, line)
    h = _DHCP_HOST_RE.search(rest)
    if h and f:
        f['hostname'] = h.group(1)
    return f


# Samba: auth audit (4.x), check_ntlm_password, hosts deny, full_audit VFS module.
_SMB_AUDIT_RE = re.compile(r'Auth: \[([^\]]*)\] user \[([^\]]*)\]\\\[([^\]]*)\] at \[[^\]]*\] with \[([^\]]*)\]'
                           r' status \[(\w+)\](?: workstation \[([^\]]*)\])?(?: remote host \[([^\]]*)\])?')
_SMB_NTLM_RE  = re.compile(r'check_ntlm_password:\s+Authentication for user \[([^\]]*)\](?: -> \[[^\]]*\])*'
                           r' (FAILED with error (\w+)|succeeded)', re.I)
_SMB_FULL_RE  = re.compile(r'\bsmbd_audit(?:\[\d+\])?: ([^|]*)\|([^|]*)\|([^|]*)\|([^|]*)\|(\w+)\|(\w+)\|(.*)$')
_SMB_HDR_RE   = re.compile(r'^\[(\d{4})/(\d\d)/(\d\d) (\d\d):(\d\d):(\d\d)(?:\.\d+)?,\s*(\d+)[^\]]*\]')
_SMB_CONN_RE  = re.compile(r'\(ipv[46]:([^)]+)\) (?:signed )?connect to service (\S+) initially as user (\S+)')
_SMB_LAST = [None, None]        # (ts, vsev) from the last "[date, level]" header line


def _p_samba(line):
    h = _SMB_HDR_RE.match(line)
    if h:
        lvl = int(h.group(7))
        _SMB_LAST[:] = [_epoch_parts(*h.groups()[:6]), (3, 4, 5)[lvl] if lvl < 3 else 6]
        return None                      # the message is on the next line
    ts, vsev = _SMB_LAST
    _SMB_LAST[:] = [None, None]
    m = _SMB_AUDIT_RE.search(line)
    if m:
        proto, dom, user, method, status, ws, remote = m.groups()
        f = {'kind': 'login' if status == 'NT_STATUS_OK' else 'login_fail',
             'name': 'Samba login' if status == 'NT_STATUS_OK' else f'Samba {status}',
             'user': user or None, 'domain': dom or None, 'status': status, 'workstation': ws,
             'auth': method, 'ts': ts}
        if remote and remote.startswith('ipv'):
            f['src_ip'] = _strip_port(remote.split(':', 1)[1])
        if status == 'NT_STATUS_ACCOUNT_LOCKED_OUT':
            f['locked'] = 1
        if not user:
            return None if status == 'NT_STATUS_OK' else f
        return f
    m = _SMB_NTLM_RE.search(line)
    if m:
        user, res, err = m.groups()
        ok = res.lower() == 'succeeded'
        f = {'kind': 'login' if ok else 'login_fail',
             'name': 'Samba login' if ok else f'Samba {err}', 'user': user, 'status': err,
             'ts': ts}
        if err == 'NT_STATUS_ACCOUNT_LOCKED_OUT':
            f['locked'] = 1
        return f
    m = _SMB_FULL_RE.search(line)
    if m:
        user, ip, machine, share, op, res, arg = m.groups()
        return {'name': f'file {op}', 'kind': 'file_op', 'user': user, 'src_ip': ip,
                'workstation': machine, 'share': share, 'op': op, 'status': res,
                'path': arg.split('|')[-1][:200], 'vsev': 4 if res == 'fail' else 6}
    m = _SMB_CONN_RE.search(line)
    if m:
        return {'name': 'share connect', 'kind': 'file_op', 'op': 'connect',
                'src_ip': _strip_port(m.group(1)), 'share': m.group(2), 'user': m.group(3),
                'ts': ts, 'vsev': 6}
    d = re.search(r'Denied connection from (\S+)', line)
    if d:
        return {'name': 'Samba hosts deny', 'kind': 'deny', 'src_ip': d.group(1),
                'dst_port': 445, 'proto': 'tcp', 'rule': 'samba hosts deny', 'ts': ts}
    if ts is not None and line[:1].isspace():
        return {'name': 'Samba ' + _short_msg(line.strip(), 50), 'kind': None, 'ts': ts,
                'vsev': vsev, 'msg': line.strip()[:200]}
    return None


# Postfix
_PF_RE      = re.compile(r'\bpostfix(?:/[\w.-]+)+\[\d+\]: (.*)$')
_PF_SASL_RE = re.compile(r'warning: (\S+?)\[([0-9a-fA-F.:]+)\]: SASL (\S+) authentication failed')
_PF_CLIENT  = re.compile(r'^\w+: client=(\S+?)\[([0-9a-fA-F.:]+)\](?:.*?sasl_username=([^,\s]+))?')
_PF_REJECT  = re.compile(r'(?:^|: )reject: (\w+) from (\S+?)\[([0-9a-fA-F.:]+)\]: (?:\d{3} [\d.]+ )?(.*?)'
                         r'(?:; from=<([^>]*)>)?(?: to=<[^>]*>)?(?: proto=|$)')
_PF_STATUS  = re.compile(r'to=<([^>]*)>.*? status=(sent|deferred|bounced|expired)(?: \((.*)\))?')
_PF_FROM    = re.compile(r'^\w+: from=<([^>]*)>, size=(\d+), nrcpt=(\d+)')
_PF_LOST    = re.compile(r'(?:lost connection|timeout) after (\w+)(?: \([^)]*\))? from (\S+?)\[([0-9a-fA-F.:]+)\]')


def _reject_reason(text):
    t = re.sub(r'<[^>]*>: ', '', text)
    b = re.search(r'blocked using (\S+?)[;,]?(?:\s|$)', t)
    if b:
        return f'blocked by {b.group(1)}'
    return _short_msg(t.split(';')[0], 60)


def _p_postfix(line):
    m = _PF_RE.search(line)
    if not m:
        return None
    msg = m.group(1)
    f = {'kind': 'mail', 'vsev': 6}
    a = _PF_SASL_RE.search(msg)
    if a:
        return {'name': 'SMTP AUTH failure', 'kind': 'login_fail', 'src_ip': a.group(2),
                'auth': a.group(3), 'service': 'smtp'}
    a = _PF_CLIENT.search(msg)
    if a:
        if a.group(3):
            return {'name': 'SMTP AUTH login', 'kind': 'login', 'src_ip': a.group(2),
                    'user': a.group(3), 'service': 'smtp', 'status': 'submitted'}
        f.update(name='mail received', status='received', src_ip=a.group(2))
        return f
    a = _PF_REJECT.search(msg)
    if a:
        stage, _host, ip, text, sender = a.groups()
        reason = _reject_reason(text)
        f.update(name='mail rejected', status='rejected', src_ip=ip, reason=reason, stage=stage,
                 sender=sender or None, vsev=4 if 'relay access denied' in text.lower() else 5)
        return f
    a = _PF_STATUS.search(msg)
    if a:
        rcpt, st, why = a.groups()
        f.update(name=f'mail {st}', status=st, rcpt=rcpt, reason=_short_msg(why or '', 60) or None,
                 vsev=6 if st == 'sent' else 4)
        return f
    a = _PF_FROM.search(msg)
    if a:
        f.update(name='mail queued', status='queued', sender=a.group(1) or '<>',
                 nrcpt=a.group(3))
        return f
    a = _PF_LOST.search(msg)
    if a:
        f.update(name=f'SMTP lost connection after {a.group(1)}', status='lost', stage=a.group(1),
                 src_ip=a.group(3), vsev=5)
        return f
    w = re.match(r'(warning|error|fatal|panic): (.*)$', msg)
    if w:
        return {'name': f'postfix {w.group(1)}: ' + _short_msg(w.group(2), 50), 'kind': None,
                'vsev': {'warning': 4, 'error': 3, 'fatal': 2, 'panic': 0}[w.group(1)],
                'msg': w.group(2)[:200]}
    f.update(name='mail', status='other', vsev=7)
    return f


# Dovecot IMAP / POP3
_DOVE_RE   = re.compile(r'\bdovecot(?:\[\d+\])?: (?:(imap|pop3|submission|managesieve|lmtp)-login: )?(.*)$')
_DOVE_USER = re.compile(r'user=<([^>]*)>')
_DOVE_RIP  = re.compile(r'rip=([0-9a-fA-F.:]+)')


def _p_dovecot(line):
    m = _DOVE_RE.search(line)
    if not m:
        return None
    proto, msg = m.groups()
    u, r = _DOVE_USER.search(msg), _DOVE_RIP.search(msg)
    f = {'service': proto, 'user': (u.group(1) or None) if u else None,
         'src_ip': r.group(1) if r else None}
    if proto and 'auth failed' in msg:
        f.update(name=f'{proto.upper()} login failure', kind='login_fail')
        return f
    if proto and msg.startswith('Login:'):
        f.update(name=f'{proto.upper()} login', kind='login')
        return f
    w = re.match(r'(?:[\w-]+(?:\(\S*\))?: )?(Error|Fatal|Panic|Warning): (.*)$', msg)
    if w:
        f.update(name=f'dovecot {w.group(1).lower()}: ' + _short_msg(w.group(2), 50), kind=None,
                 vsev={'Error': 3, 'Fatal': 2, 'Panic': 0, 'Warning': 4}[w.group(1)])
        return f
    f.update(name='mail', kind='mail', status='other', vsev=7)
    return f


# FTP servers
_VSFTPD_RE  = re.compile(r'\[([^\]]*)\] (OK|FAIL) (LOGIN|UPLOAD|DOWNLOAD|MKDIR|DELETE|RENAME|RMDIR):'
                         r' Client "(?:::ffff:)?([^"]+)"(?:, "([^"]*)")?')
_PROFTPD_RE = re.compile(r'proftpd\[\d+\]: \S+ \((\S*?)\[([^\]]+)\]\) - (.*)$')
_PUREFTP_RE = re.compile(r'pure-ftpd(?:\[\d+\])?: \((\S*?)@([^)]+)\) \[(\w+)\] (.*)$')


def _p_ftp(line):
    m = _VSFTPD_RE.search(line)
    if m:
        user, res, op, ip, path = m.groups()
        f = {'user': user or None, 'src_ip': ip, 'service': 'ftp', 'ts': _ts_ctime(line)}
        if op == 'LOGIN':
            f.update(kind='login' if res == 'OK' else 'login_fail',
                     name='FTP login' + (' failure' if res == 'FAIL' else ''))
        else:
            f.update(kind='file_op', name=f'FTP {op.lower()}', op=op.lower(), path=path,
                     status='ok' if res == 'OK' else 'fail', vsev=6 if res == 'OK' else 4)
        return f
    m = _PROFTPD_RE.search(line)
    if m:
        _h, ip, msg = m.groups()
        f = {'src_ip': ip, 'service': 'ftp'}
        u = re.match(r'USER (\S+?)(?::| \(Login failed\):) (.*)$', msg)
        if u:
            ok = 'successful' in u.group(2).lower()
            f.update(user=u.group(1), kind='login' if ok else 'login_fail',
                     name='FTP login' + ('' if ok else ' failure'))
            return f
        if 'Maximum login attempts' in msg:
            f.update(kind='login_fail', name='FTP login failure')
            return f
        return None
    m = _PUREFTP_RE.search(line)
    if m:
        _u, ip, _lvl, msg = m.groups()
        a = re.search(r'Authentication failed for user \[([^\]]*)\]', msg)
        if a:
            return {'kind': 'login_fail', 'name': 'FTP login failure', 'user': a.group(1),
                    'src_ip': ip, 'service': 'ftp'}
        a = re.match(r'(\S+) is now logged in', msg)
        if a:
            return {'kind': 'login', 'name': 'FTP login', 'user': a.group(1), 'src_ip': ip,
                    'service': 'ftp'}
    return None


# fail2ban:  2024-03-01 12:00:00,123 fail2ban.actions [123]: NOTICE [sshd] Ban 203.0.113.5
_F2B_RE = re.compile(r'fail2ban\.\w+\s*\[\d+\]:\s*(\w+)\s+\[([^\]]+)\]\s+(Restore Ban|Increase Ban|Ban|Unban'
                     r'|Found)\s+([0-9a-fA-F.:]+)')


def _p_fail2ban(line):
    m = _F2B_RE.search(line)
    if not m:
        return None
    level, jail, action, ip = m.groups()
    st = {'Restore Ban': 'ban', 'Increase Ban': 'ban', 'Ban': 'ban', 'Unban': 'unban',
          'Found': 'found'}[action]
    return {'name': f'fail2ban {st}', 'kind': 'ban', 'status': st, 'jail': jail, 'src_ip': ip,
            'vsev': 5 if st == 'ban' else 6}


# systemd unit failures
_SYSTEMD_RE   = re.compile(r'\bsystemd\[\d+\]: (.*)$')
_UNIT         = r'(\S+\.(?:service|socket|mount|timer|target|scope|path|swap|automount|slice))'
_UNIT_FAIL_RE = re.compile(_UNIT + r': (Failed with result \'([^\']+)\'|Start request repeated too '
                           r'quickly|Scheduled restart job, restart counter is at (\d+))')
_UNIT_OLD_RE  = re.compile(r'^Unit ' + _UNIT + r' entered failed state')


def _p_systemd(line):
    m = _SYSTEMD_RE.search(line)
    if not m:
        return None
    msg = m.group(1)
    u = _UNIT_FAIL_RE.match(msg) or _UNIT_OLD_RE.match(msg)
    if u:
        what = 'restart loop' if 'restart' in u.group(0).lower() or 'quickly' in u.group(0) \
            else 'failed'
        return {'name': f'service {what}', 'kind': 'unit_fail', 'service': u.group(1),
                'msg': msg[:200]}
    if msg.startswith('Failed to start '):
        return {'name': 'systemd: failed to start', 'kind': None, 'vsev': 3, 'msg': msg[:200]}
    return None


# Linux audit (auditd)
_AUDIT_RE   = re.compile(r'\btype=(\w+) msg=audit\((\d+)\.\d+:\d+\): (.*)$')
_AUDIT_KV   = re.compile(r'\b(acct|addr|res|exe|op|id|terminal)=("[^"]*"|\S+)')
_AUDIT_ACCT = ('ADD_USER', 'DEL_USER', 'ADD_GROUP', 'DEL_GROUP', 'USER_MGMT', 'GRP_MGMT',
               'USER_CHAUTHTOK', 'ROLE_ASSIGN', 'ROLE_REMOVE', 'ACCT_LOCK', 'ACCT_UNLOCK')


def _audit_acct(v):
    v = v.strip('"')
    if len(v) >= 4 and len(v) % 2 == 0 and re.fullmatch(r'[0-9A-F]+', v):
        try:
            return bytes.fromhex(v).decode('utf-8', 'replace')
        except ValueError:
            pass
    return v


def _p_auditd(line):
    m = _AUDIT_RE.search(line)
    if not m:
        return None
    typ, epoch, rest = m.groups()
    kv = {k: v.strip('"').rstrip("'") for k, v in _AUDIT_KV.findall(rest)}
    f  = {'ts': int(epoch), 'name': f'audit {typ}', 'kind': None, 'vsev': 6}
    if 'acct' in kv and kv['acct'] not in ('?', '(unknown)'):
        f['user'] = _audit_acct(kv['acct'])
    if kv.get('addr') not in (None, '?', ''):
        f['src_ip'] = kv['addr']
    exe = kv.get('exe', '').rsplit('/', 1)[-1]
    res = kv.get('res', '').rstrip("'")
    if typ == 'USER_AUTH' and res == 'failed':
        f.update(kind='login_fail', name=f'{exe or "PAM"} authentication failure (audit)')
    elif typ == 'USER_LOGIN' and res == 'success':
        f.update(kind='login', name=f'{exe or "login"} login (audit)')
    elif typ in _AUDIT_ACCT:
        f.update(kind='config', name=f'account change: {typ}', vsev=5)
    elif typ == 'ANOM_ABEND':
        f.update(name='process crashed (ANOM_ABEND)', vsev=3)
    elif typ == 'AVC':
        f.update(name='SELinux AVC denied' if 'denied' in rest else 'SELinux AVC', vsev=4)
    return f


