                   help='Wrap long lines, indenting the continuation rows (default; '
                        'press l in the viewer or follow mode to toggle, and it is remembered)')
    w.add_argument('--no-wrap', dest='wrap', action='store_false',
                   help='Cut long lines at the screen edge instead (←/→ scroll in the viewer)')
    a = p.add_argument_group(
        'analysis', 'For wireless, switch, router, firewall and NAC logs from the vendors listed '
                    'by --formats (Cisco, Aruba/HPE, Juniper, Ruckus, Fortinet, Palo Alto, '
