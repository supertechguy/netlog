# Kinds that need BOTH a matching tag and matching text when the source has
# tags: "failed" alone in some %SYS-3-... message is not a client auth failure.
_TAG_AND_TEXT = {'failure', 'auth'}
_TEXT_RULES = [(k, re.compile(t) if t else None, re.compile(m, re.I) if m else None)
               for k, t, m in _TEXT_RULES]


def classify_text(tag, msg):
    """Event kind from a vendor tag (e.g. 'LINK-UPDOWN', 'RPD_OSPF_NBRDOWN')
    and/or message text, or None."""
    tag = (tag or '').upper()
    for kind, tag_re, msg_re in _TEXT_RULES:
        if kind in _TAG_AND_TEXT and tag:
            hit = (tag_re is not None and tag_re.search(tag)) and \
                  (msg_re is not None and msg and msg_re.search(msg))
        else:
            hit = (tag_re is not None and tag and tag_re.search(tag)) or \
                  (msg_re is not None and msg and msg_re.search(msg))
        if not hit:
            continue
        k = kind(msg or '') if callable(kind) else kind
        if k:
            return k
    return None


