    'failover': {'104001', '104002', '104500', '104502'},
    'hw':     {'105005', '105008', '105009', '105011', '105043', '199010', '735005',
               '735011', '735012'},
    'link_up': {'411001', '411003'},
    'link_down': {'411002', '411004'},
}
_ASA_ID = {i: k for k, ids in _ASA_KIND.items() for i in ids}
_ASA_DESC = {
    '106001': 'inbound TCP denied', '106006': 'inbound UDP denied', '106007': 'inbound DNS denied',
    '106014': 'inbound ICMP denied', '106015': 'TCP denied (no connection)',
    '106021': 'reverse-path check denied', '106023': 'denied by ACL', '106100': 'ACL hit',
    '302013': 'built TCP', '302014': 'teardown TCP', '302015': 'built UDP', '302016': 'teardown UDP',
    '113004': 'AAA auth successful', '113005': 'AAA auth rejected', '605004': 'login denied',
    '605005': 'login permitted', '611101': 'user auth succeeded', '611102': 'user auth failed',
    '611103': 'user logged out', '111008': 'command executed', '111010': 'config change',
    '713050': 'VPN connection terminated', '713119': 'IKE phase 1 completed',
