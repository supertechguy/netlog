        elif sv.mail_senders:
            out += H('Top envelope senders')
            out += _table([[u[:60], f'{n:,}'] for u, n in sv.mail_senders.most_common(top)], s, 'lr')

    if sv.file_ops or sv.locked:
        out += H('File shares and FTP')
        if sv.file_ops:
            out.append('  Operations: ' + ', '.join(f'{o} {n:,}' for o, n in sv.file_ops.most_common(10)))
            rows = [_hdr('User', 'Operations', 'Changes')]
            for u, n in sv.file_users.most_common(top):
                rows.append([u, f'{n:,}', f'{sv.file_change_n.get(u, 0):,}'])
            out += _table(rows, s, 'lrr')
            if sv.file_shares:
                out.append('  Shares: ' + ', '.join(f'{sh} {n:,}' for sh, n in sv.file_shares.most_common(8)))
        if sv.locked:
            out.append('  Locked-out accounts: ' + ', '.join(f'{u} ({n})' for u, n in sv.locked.most_common(8)))

    if sv.bans or sv.f2b_found:
        out += H('fail2ban')
        jails = set(sv.bans) | set(sv.f2b_found)
        rows = [_hdr('Jail', 'Bans', 'Matches')]
        for j in sorted(jails, key=lambda j: -sv.bans.get(j, 0)):
            rows.append([j, f'{sv.bans.get(j, 0):,}', f'{sv.f2b_found.get(j, 0):,}'])
        out += _table(rows, s, 'lrr')
        if sv.banned:
            out.append('  Most banned: ' + ', '.join(f'{ip} ({n})' for ip, n in sv.banned.most_common(6)))

    if sv.radius:
        out += H('RADIUS server problems')
        out += _table([[st, src, f'{n:,}'] for (st, src), n in
                       sorted(sv.radius.items(), key=lambda kv: -kv[1])[:top]], s, 'llr')


def _summary_infra(out, rep, s, H, rules, top):
    names = {'vpn_down': 'VPN down', 'vpn_up': 'VPN up', 'service_down': 'Service down',
             'service_up': 'Service up', 'failover': 'Failover', 'hw': 'Hardware',
             'reboot': 'Reboot', 'ap_down': 'AP down', 'ap_up': 'AP up',
             'unit_fail': 'Service failed'}
    bad = {'vpn_down', 'service_down', 'ap_down', 'hw', 'failover', 'reboot', 'unit_fail'}
    out += H('VPN, services, access points and hardware')
    rows = [['Type', 'Subject', 'Count', 'Last', 'Detail']]
    items = sorted(rep.infra.items(), key=lambda kv: (kv[0][0] not in bad, -kv[1][0]))
    for (kind, subject), (n, last_ts, sample) in items[:top * 2]:
        rows.append([(names.get(kind, kind), '1;31' if kind in bad else ANSI_EV_ALLOW),
                     subject, str(n), _fmt_ts(last_ts), sample[:60]])
    out += _table(rows, s, 'llrll')


# ── Findings: every detector, ranked ─────────────────────────────────────────

LEVELS      = ('critical', 'high', 'medium', 'low')
_LEVEL_CODE = ('1;37;41', '1;31', '1;33', '2;37')

# (level, title) for the network/security findings Report produces.
_FINDING_INFO = {
    'flap': (1, 'Interface flapping'), 'errdisable': (1, 'Err-disabled port'),
    'loop': (1, 'Layer-2 loop / MAC flap'), 'violation': (2, 'Port security / snooping violation'),
    'routing': (1, 'Routing neighbor down'), 'brute': (1, 'Login attack (brute force)'),
    'threat': (1, 'Threat signature'), 'vpn': (1, 'VPN tunnel down'),
    'service': (1, 'Server / service unreachable'), 'ap': (1, 'Access point down'),
    'failover': (2, 'Failover / redundancy change'), 'hw': (1, 'Hardware / environment'),
    'reboot': (2, 'Reboot / restart'), 'unitfail': (1, 'Service failed'),
}


class Alert:
    __slots__ = ('level', 'title', 'subject', 'detail', 'weight')

    def __init__(self, level, title, subject, detail, weight=1):
        self.level, self.title, self.subject = level, title, subject
        self.detail, self.weight = detail, weight

    def __repr__(self):
        return f'Alert({LEVELS[self.level]}, {self.title!r}, {self.subject!r}, {self.detail!r})'


def _service_alerts(rep, add):
    """Findings from ServiceStats: web, DNS, DHCP, mail, file shares, fail2ban, RADIUS."""
    sv, rules = rep.svc, rep.rules
    if not sv:
        return
    lab = WEB_ATTACK_LABELS

    # Web attacks, by source.
    for src, (kinds, ok, sample, ok_sample) in sv.web_attack_src.items():
        n = sum(kinds.values())
        if ok:
            add(0, 'Web attack may have succeeded', src,
                f'{ok} attack request{"s" * (ok != 1)} got a 2xx response, e.g. {ok_sample}', ok)
        what = ', '.join(f'{lab[k]} {c}' for k, c in kinds.most_common(4))
        if 'log4shell' in kinds:
            add(1, 'Log4Shell exploit attempts', src,
                f'{kinds["log4shell"]} JNDI lookup request{"s" * (kinds["log4shell"] != 1)}',
                kinds['log4shell'])
        internal = ip_scope(src) == 'private'
        if kinds.keys() - {'log4shell'}:
            add(1 if internal else 2, 'Web attack attempts' + (' from internal host' if internal else ''),
                src, f'{n} request{"s" * (n != 1)}: {what} — e.g. {sample}', n)
    for src, paths in sv.web_nf_src.items():
        if len(paths) >= rules.web_scan:
            internal = ip_scope(src) == 'private'
            add(1 if internal else 2, 'Web vulnerability scan' + (' from internal host' if internal
                                                                  else ''), src,
                f'{len(paths)}{"+" if len(paths) >= ServiceStats._CAP else ""} different URLs not '
                f'found (404)', len(paths))
    for site, n5 in sv.web_site_5xx.items():
        total = sv.web_sites.get(site, 0)
        if n5 >= 20 and total and n5 / total >= 0.05:
            top = sv.web_5xx.most_common(1)
            add(2, 'Web server errors', site, f'{n5:,} of {total:,} requests ({n5 / total:.0%}) '
                f'failed with 5xx' + (f'; most on {top[0][0]}' if top else ''), n5)

    # DNS
    for src, (n, n_any, q) in sv.dns_denied.items():
        public = ip_scope(src) == 'public'
        if n_any >= 20 and public:
            add(1, 'DNS amplification attempt', src,
                f'{n_any} refused ANY queries from an internet address (e.g. {q})', n_any)
        elif n >= 10:
            add(2, 'DNS queries refused', src,
                f'{n} refused queries/updates' + (f' (e.g. {q})' if q else '')
                + (' — open-resolver probing?' if public else ''), n)
    for src, (n, zone) in sv.dns_axfr.items():
        add(1, 'Zone transfer attempt', src,
            f'{n} refused zone transfer request{"s" * (n != 1)}' + (f' for {zone}' if zone else ''), n)
    for zone, (n, msg) in sv.dns_zone.items():
        add(2, 'DNS zone problem', zone, f'{n}× {msg[:90]}', n)
    for (src, base), n in sv.dns_long.items():
        if n >= 20:
            add(1, 'Possible DNS tunneling', src,
                f'{n} queries with very long names under {base} (data exfiltration / C2?)', n)
    nfail = sv.dns_status.get('resolution failure', 0)
    if nfail >= 20:
        add(3, 'DNS resolution failures', 'resolver',
            f'{nfail:,} SERVFAIL / lame-server / unreachable resolver messages', nfail)
    if sv.dns_status.get('overloaded'):
        n = sv.dns_status['overloaded']
        add(2, 'DNS server overloaded', 'dnsmasq', f'concurrent query limit reached {n}×', n)

    # DHCP
    for ip, (n, mac) in sv.dhcp_decline.items():
        add(2, 'IP address conflict (DHCP decline)', ip,
            f'{n} decline/abandon message{"s" * (n != 1)}' + (f' (client {mac})' if mac else '')
            + ' — another device is using this address', n)
    for mac, n in sv.dhcp_nak.items():
        if n >= 5:
            add(3, 'DHCP NAKs', mac, f'{n} NAKs — client asking for an address from the wrong '
                f'network or a stale lease', n)
    for mac, n in sv.dhcp_disc.items():
        if n >= 20 and not sv.dhcp_acks.get(mac):
            add(2, 'Client not getting a DHCP lease', mac,
                f'{n} DISCOVERs and no ACK', n)

    # Mail
    for src, n in sv.mail_relay.items():
        if n >= 5:
            add(2, 'Open-relay probing', src, f'{n} relay attempts refused ("Relay access denied")', n)
    for user, ips in sv.mail_sasl_ip.items():
        public = [ip for ip in ips if ip_scope(ip) == 'public']
        if len(public) >= 5:
            add(1, 'Mail account used from many addresses', user,
                f'authenticated SMTP from {len(public)} internet addresses — compromised '
                f'password?', len(public))
    for user, n in sv.mail_sasl.items():
        if n >= 500:
            add(2, 'High mail volume from one account', user,
                f'{n:,} messages submitted (spam from a compromised account?)', n)
    ms = sv.mail_status
    deliv = ms.get('sent', 0) + ms.get('deferred', 0) + ms.get('bounced', 0)
    if ms.get('deferred', 0) >= 20 and ms['deferred'] / deliv >= 0.2:
        why = sv.mail_defer.most_common(1)
        add(2, 'Mail delivery problems', 'outbound mail',
            f'{ms["deferred"]:,} of {deliv:,} deliveries deferred'
            + (f'; most: {why[0][0]}' if why else ''), ms['deferred'])
    if ms.get('bounced', 0) >= 50:
        add(3, 'Bounced mail', 'outbound mail', f'{ms["bounced"]:,} messages bounced', ms['bounced'])

    # File shares
    for user, n in sv.locked.items():
        add(1, 'Account locked out', user, f'{n} lockout{"s" * (n != 1)} (NT_STATUS_ACCOUNT_LOCKED_OUT)', n)
    for user, times in sv.file_changes.items():
        times.sort()
        n = _max_in_window(times, 300) if times else 0
        if n >= rules.mass_change:
            add(1, 'Mass file changes (possible ransomware)', user,
                f'{n:,} deletes/renames/writes within 5 min ({sv.file_change_n[user]:,} total)', n)

    # fail2ban
    if sv.bans:
        n = sum(sv.bans.values())
        add(3, 'fail2ban bans', f'{len(sv.banned):,} address{"es" * (len(sv.banned) != 1)}',
            f'{n:,} bans: ' + ', '.join(f'{j} {c}' for j, c in sv.bans.most_common(4)), n)
    for ip, n in sv.banned.items():
        if n >= 3:
            jails = ', '.join(sorted(sv.ban_jails.get(ip, ())))
            add(2, 'Repeat offender (fail2ban)', ip, f'banned {n}× ({jails})', n)

    # RADIUS
    for (st, src), n in sv.radius.items():
        if st == 'unknown client':
            add(1 if ip_scope(src) == 'public' else 2, 'RADIUS request from unknown client', src,
                f'{n} request{"s" * (n != 1)} ignored — not in clients.conf', n)
        elif st == 'bad secret':
            add(1, 'RADIUS shared secret mismatch', src,
                f'{n} packet{"s" * (n != 1)} with an invalid Message-Authenticator', n)


def collect_alerts(rep, vendors=None):
    """Every problem the detectors found, as Alerts sorted most serious first."""
    vendors, rules = vendors or {}, rep.rules
    A = []

    def add(level, title, subject, detail, weight=1):
        A.append(Alert(level, title, str(subject), detail, weight))

    # Network / security findings from Report.
    for cat, _sev, subj, text in rep.findings:
        level, title = _FINDING_INFO.get(cat, (2, cat))
        if cat == 'brute' and text.startswith('successful login'):
            level, title = 0, 'Login succeeded after brute force'
        elif cat == 'routing' and 'recovered' in text:
            level = 2
        elif cat == 'scan':
            title = 'Host sweep' if 'host sweep' in text else 'Port scan'
            internal = ip_scope(subj) == 'private'
            level = 1 if internal else 2
            if internal:
                title += ' from internal host'
            text = text.replace('possible port scan: ', '').replace('possible host sweep: ', '')
        add(level, title, subj, text)

    # Authentication: password spraying and distributed attacks.
    by_src, by_user = {}, {}
    for ev in rep.events:
        if ev.kind != 'login_fail':
            continue
        f, user = ev.fields, ev.fields.get('user')
        src = f.get('src_ip')
        if src and user:
            by_src.setdefault(src, Counter())[user] += 1
        if user and src:
            by_user.setdefault(user, set()).add(src)
    for src, users in by_src.items():
        if len(users) >= rules.spray_accounts:
            eg = ', '.join(u for u, _ in users.most_common(4))
            add(1, 'Password spraying', src,
                f'login failures against {len(users)} different accounts (e.g. {eg})', len(users))
    for user, srcs in by_user.items():
        if len(srcs) >= rules.spray_sources:
            add(1, 'Distributed login attack', f'account {user}',
                f'login failures from {len(srcs)} different source addresses', len(srcs))

    # Firewall exposure.
    fw = rep.fw
    for (dst, port), (n, srcs) in fw.exposed.items():
        add(0, 'Risky service allowed from internet', f'{dst}:{port} ({RISKY_PORTS[port]})',
            f'{n:,} allowed connection{"s" * (n != 1)} from {len(srcs)}'
            f'{"+" if len(srcs) >= 512 else ""} internet source{"s" * (len(srcs) != 1)}', n)
    for (src, port), (n, dsts) in fw.outbound.items():
        if port == 25:
            if len(dsts) >= 10:
                add(2, 'Possible spam bot', src,
                    f'SMTP to {len(dsts)} different internet mail servers ({n:,} connections)', n)
        elif n >= 3:
            add(1, 'Internal host using risky service on internet', src,
                f'{n:,} connections to {RISKY_PORTS.get(port, port)}/{port} on {len(dsts)} '
                f'internet host{"s" * (len(dsts) != 1)} (worm / malware / data leak?)', n)

    # Error volume: spikes over time, noisy devices, silent devices.
    if len(rep.ev_buckets) >= 6:
        # Baseline: the median over spike_window buckets that have any events (so
        # gaps, or logs from devices with different clocks, don't drag it to 0).
        buckets = sorted(rep.ev_buckets)
        counts  = sorted(rep.err_buckets.get(b, 0) for b in buckets)
        base    = counts[len(counts) // 2]
        limit   = max(rules.spike_min, rules.spike_factor * base)
        win     = rules.spike_window
        run, spikes = [], []
        for b in buckets + [None]:
            n = rep.err_buckets.get(b, 0) if b is not None else 0
            if b is not None and n >= limit and (not run or b == run[-1][0] + 1):
                run.append((b, n))
                continue
            if run:
                spikes.append(run)
            run = [(b, n)] if b is not None and n >= limit else []
        spikes = [r for r in spikes if len(r) <= max(1, len(buckets) // 4)]
        for run in sorted(spikes, key=lambda r: -sum(n for _, n in r))[:5]:
            total = sum(n for _, n in run)
            start, end = run[0][0] * win, (run[-1][0] + 1) * win
            add(1, 'Spike in errors / warnings', f'{_fmt_ts(start)} → {_fmt_ts(end)}',
                f'{total:,} errors and warnings in {_fmt_dur(end - start)} '
                f'(usual {base} per {_fmt_dur(win).replace("m00s", "m")})', total)
    sv = rep.severity
    total_ev = sum(sv.values())
    if total_ev >= 100 and sv['error'] / total_ev >= 0.25:
        add(2, 'High overall error rate', 'all devices',
            f'{sv["error"]:,} of {total_ev:,} events ({sv["error"] / total_ev:.0%}) are errors',
            sv['error'])
    # "End of log" is the latest last-seen time among devices whose clocks
    # agree with the majority, so one device with a wrong clock or year
    # doesn't make every other device look silent.
    lasts = sorted(d.last for d in rep.devices.values() if d.last is not None and d.events >= 20)
    end   = None
    if lasts:
        mid = lasts[len(lasts) // 2]
        end = max(t for t in lasts if abs(t - mid) <= 7 * 86400)
    firsts = [d.first for d in rep.devices.values() if d.first is not None and
              end is not None and abs(d.first - end) <= 7 * 86400]
    span = (end - min(firsts)) if firsts else 0
    for d in rep.devices.values():
        if d.host == '(no host)':
            continue
        err = d.severity['error']
        if d.events >= 20 and err / d.events >= 0.3:
            top_issue = d.issues.most_common(1)[0][0] if d.issues else ''
            add(2, 'Device with high error rate', d.host,
                f'{err:,} errors in {d.events:,} events ({err / d.events:.0%})'
                + (f', mostly {top_issue}' if top_issue else ''), err)
        if end is None or d.last is None or d.events < 20:
            continue
        gap = end - d.last
        if abs(gap) > 7 * 86400 or (d.first is not None and abs(d.first - end) > 7 * 86400
                                     and abs(gap) > 7 * 86400):
            add(3, 'Device clock / timestamp mismatch', d.host,
                f'timestamps are {_fmt_dur(abs(gap))} {"behind" if gap > 0 else "ahead of"} the '
                'other devices — check NTP, time zone, or a missing year in its syslog format')
        elif span >= 7200 and gap > max(1800, 0.2 * span):
            add(2, 'Device stopped logging', d.host,
                f'last message {_fmt_ts(d.last)}, {_fmt_dur(gap)} before the other devices '
                f'stopped ({d.events:,} events before that)')

    # Critical / alert / emergency syslog messages.
    for (host, name), (n, sev, last_ts, sample) in rep.critical.items():
        add(0 if sev <= 1 else 1, 'Emergency / alert message' if sev <= 1 else 'Critical message',
            host, f'{n}× {name}' + (f', last {_fmt_ts(last_ts)}' if last_ts else ''), n)

    # Switch layer-2 counters not already reported as findings.
    stp = Counter()
    for (kind, host, where), n in rep.l2.items():
        if kind == 'stp':
            stp[host] += n
        elif kind == 'port_error':
            add(2, 'Interface errors', f'{host} {where}'.strip(),
                f'{n}× {rep.l2_msg[(kind, host, where)][:90]}', n)
        elif kind == 'poe':
            add(3, 'PoE fault', f'{host} {where}'.strip(),
                f'{n}× {rep.l2_msg[(kind, host, where)][:90]}', n)
    for host, n in stp.items():
        if n >= 5:
            add(2, 'Spanning-tree instability', host, f'{n} topology change / STP events', n)

    # Text detectors (any log line).
    for (tid, host), (n, first, last, sample) in rep.text_issues.items():
        level, title = TEXT_ISSUE_INFO[tid]
        if tid == 'authtext':
            level = 2 if n >= 2 * rules.brute_threshold else 3
        elif tid == 'stptext':
            level = 2 if n >= 5 else 3
        when = f', last {_fmt_ts(last)}' if last else ''
        add(level, title, host, f'{n:,}×{when} — {_msg_part(sample)[:100]}', n)

    # Wireless.
    for lp in rep.loops:
        cs   = rep.clients[lp.client]
        span = _fmt_dur(lp.end - lp.start) if lp.timed else '?'
        aps  = ', '.join(a for a, _ in lp.aps.most_common(2)) or 'unknown AP'
        rec  = (f'recovered after {_fmt_dur(lp.recovery.eff - lp.start)}' if lp.recovery
                else 'no recovery seen')
        add(2, 'Wireless failure loop', _client_label(cs, vendors),
            f'{lp.count} × {lp.names.most_common(1)[0][0]} in {span} @ {aps} — {rec}', lp.count)
    for table, title in ((rep.aps, 'AP failure hotspot'), (rep.locations, 'Location failure hotspot')):
        base = rep.ap_baseline if table is rep.aps else rep.loc_baseline
        for ss in table.values():
            if getattr(ss, 'flagged', False):
                add(2, title, ss.key, f'{ss.rate:.0%} of attempts fail ({ss.failures} failures) '
                    f'vs {base:.0%} overall', ss.failures)
    titles = {'legacy': 'Legacy SSID in use', 'identity': 'Identity inconsistency',
              'roam': 'Rapid roaming', 'rssi': 'Low signal'}
    for cs in rep.clients.values():
        for cat, text in cs.findings:
            if cat in titles:
                add(3, titles[cat], _client_label(cs, vendors), text)

    _service_alerts(rep, add)

    order = {}
    for a in A:
        order.setdefault((a.level, a.title), 0)
        order[(a.level, a.title)] += a.weight
    A.sort(key=lambda a: (a.level, -order[(a.level, a.title)], a.title, -a.weight, a.subject))
    return A


def _msg_part(line):
    """The message part of a raw log line (after the syslog header)."""
    m = _HDR_RE.match(line)
    return line[m.end():].strip() if m else line.strip()


def _summary_findings(out, rep, vendors, s, H, top):
    """The ranked findings list: up to `top` rows per kind of problem."""
    alerts = collect_alerts(rep, vendors)
    out += H('Findings')
    if not alerts:
        out.append(s('  No problems detected.', ANSI_EV_ALLOW))
        return
    counts = Counter(a.level for a in alerts)
    out.append('  ' + '   '.join(s(f'{counts[i]} {LEVELS[i]}', _LEVEL_CODE[i] if counts[i] else None)
                                 for i in range(4)))
    out.append('')
    groups = {}
    for a in alerts:                       # already ordered most serious first
        groups.setdefault((a.level, a.title), []).append(a)
    rows, breaks = [], []                  # breaks: (row index after group, hidden count, title)
    for (level, title), items in groups.items():
        for a in items[:top]:
            subj = a.subject if len(a.subject) <= 44 else a.subject[:43] + '…'
            rows.append([(LEVELS[level].upper(), _LEVEL_CODE[level]), title, subj, a.detail])
        if len(items) > top:
            breaks.append((len(rows), len(items) - top, title))
    lines = _table(rows, s, 'llll')
    for at, hidden, title in reversed(breaks):
        lines.insert(at, s(f'  {"":8}  … and {hidden} more: {title}', '2;37'))
    out += lines


def format_summary(rep, vendors, color=False, sources=''):
    s, rules, top = _Style(color), rep.rules, rep.rules.top
    H   = lambda t: ['', s(t, '1;37'), s('─' * len(t), '2;37')]
    out = [s(f'netlog health summary{" — " + sources if sources else ""}', '1;36'),
           s('═' * 60, '2;37')]

    span = ''
    if rep.first_ts is not None:
        span = (f'{_fmt_ts(rep.first_ts)} → {_fmt_ts(rep.last_ts)} '
                f'({_fmt_dur(rep.last_ts - rep.first_ts)})')
    out.append(f'Lines read: {rep.lines:,}   Recognised events: {rep.parsed:,}'
               + (f'   Span: {span}' if span else ''))
    if not rep.parsed:
        out.append('')
        out.append('No recognised events. netlog understands the vendor formats listed by')
        out.append('`netlog --formats`, plus any key=value log with fields such as clientMac=,')
        out.append('userName=, apName=, apLocation=, ssid=, rssi=.')
        return '\n'.join(out)

    fmts = ' · '.join(f'{FORMAT_BY_ID[f].short if f in FORMAT_BY_ID else f} {n:,}'
                      for f, n in rep.formats.most_common())
    out.append(f'Sources: {fmts}' + (f' · unrecognised {rep.unparsed:,}' if rep.unparsed else ''))
    if rep.clients or rep.aps:
        out.append(f'Clients: {len(rep.clients):,}   Users: {len(rep.users):,}   '
                   f'APs: {len(rep.aps):,}   Locations: {len(rep.locations):,}')
    sv = rep.severity
    out.append('Severity: ' + '   '.join([
        s(f'✗ {sv["error"]:,} errors', ANSI_EV_DENY),
        s(f'! {sv["warning"]:,} warnings', ANSI_EV_ERROR),
        s(f'✓ {sv["success"]:,} success', ANSI_EV_ALLOW),
        f'· {sv["info"]:,} info']))

    _summary_findings(out, rep, vendors, s, H, top)

    devs = [d for d in rep.devices.values() if d.host != '(no host)']
    if len(devs) > 1 or (devs and len(rep.formats) > 1):
        out += H('Devices')
        rows = [['Device', 'Format', 'Events', 'Errors', 'Warnings', 'Top issue']]
        for d in sorted(devs, key=lambda d: (-d.severity['error'], -d.severity['warning'],
                                             -d.events, d.host))[:top]:
            fid = d.formats.most_common(1)[0][0]
            rows.append([d.host, FORMAT_BY_ID[fid].short if fid in FORMAT_BY_ID else fid,
                         f'{d.events:,}',
                         (f'{d.severity["error"]:,}', '1;31' if d.severity['error'] else None),
                         (f'{d.severity["warning"]:,}', '1;33' if d.severity['warning'] else None),
                         (d.issues.most_common(1)[0][0][:50] if d.issues else '-')])
        out += _table(rows, s, 'llrrrl')
        if len(devs) > top:
            out.append(f'  … and {len(devs) - top} more')

    if rep.issues:
        out += H('Errors and warnings by event type')
        rows = []
        for (sev, label), n in sorted(rep.issues.items(),
                                      key=lambda kv: (kv[0][0] != 'error', -kv[1]))[:top]:
            g = '✗' if sev == 'error' else '!'
            rows.append([(g, _SEV_CODE[sev]), label[:60], f'{n:,}'])
        out += _table(rows, s, 'llr')

    has_wifi = bool(rep.clients or rep.aps or rep.fail_by_event)
    if has_wifi:
        out += _banner('Wireless & client access', s)
        _summary_wireless(out, rep, vendors, s, H, rules, top)
    if rep.links or rep.neighbors or rep.l2:
        out += _banner('Switching & routing', s)
        _summary_network(out, rep, s, H, rules, top)
    if rep.fw.deny or rep.fw.allow or rep.fw.session or rep.threats:
        out += _banner('Firewall & security', s)
        _summary_firewall(out, rep, s, H, rules, top)
    if rep.login_src or rep.login_ok_after or rep.configs:
        out += _banner('Authentication & administration', s)
        _summary_auth(out, rep, s, H, rules, top)
    if rep.svc:
        out += _banner('Servers & services', s)
        _summary_services(out, rep, s, H, rules, top)
    if rep.infra:
        out += _banner('Infrastructure', s)
        _summary_infra(out, rep, s, H, rules, top)

    return '\n'.join(out)


_STATE_LABEL = {'join': 'Join', 'auth': 'Authorization', 'roam': 'Roaming',
                'disconnect': 'Disconnect'}


def _state_label(ev):
    if ev.kind == 'failure':
        n = ev.name.lower()
        if 'join' in n or 'assoc' in n:
            return 'Join Failure'
        if 'auth' in n:
            return 'Auth Failure'
        return ev.name or 'Failure'
    return _STATE_LABEL.get(ev.kind)


def session_path(events, loops=()):
    """Compress a client's events into a lifecycle path, e.g.
    'Join Failure ×4 (retry loop) → Join → Authorization → Roaming ×2'."""
    in_loop = {id(e) for lp in loops for e in lp.events}
    steps   = []    # [label, count, looped]
    for ev in events:
        label = _state_label(ev)
        if not label:
            continue
        if steps and steps[-1][0] == label:
            steps[-1][1] += 1
            steps[-1][2] |= id(ev) in in_loop
        else:
            steps.append([label, 1, id(ev) in in_loop])
    return ' → '.join(f'{l}{f" ×{n}" if n > 1 else ""}{" (retry loop)" if lp else ""}'
                      for l, n, lp in steps)


def _event_details(ev, show_user):
    f    = ev.fields
    bits = []
    if ev.ap:
        bits.append(ev.ap + (f' [{f["ap_loc"]}]' if f.get('ap_loc') else ''))
    if f.get('ssid'):
        bits.append(f'ssid {f["ssid"]}')
    if f.get('rssi'):
        bits.append(f'rssi {f["rssi"]}')
    if show_user and f.get('user'):
        bits.append(f'user {f["user"]}')
    if f.get('reason'):
        bits.append(f'reason {f["reason"]}')
    if f.get('status') and ev.kind == 'failure':
        bits.append(f'status {f["status"]}')
    return ' · '.join(bits)


def format_timeline(rep, query, vendors, color=False):
    """Chronological narrative for one client MAC or user. Returns
    (text, found)."""
    s     = _Style(color)
    macs  = rep.clients_matching(query)
    qnorm = None if norm_mac(query) else norm_user(query)
    out   = []

    groups = [(m, rep.clients[m].events) for m in sorted(macs) if m in rep.clients]
    if qnorm:
        # Events naming the user but no client MAC.
        orphans = [e for e in rep.events if 'client_mac' not in e.fields
                   and 'user' in e.fields and norm_user(e.fields['user']) == qnorm]
        if orphans:
            groups.append((None, orphans))
    context = {m: [e for e in rep.context
                   if any(norm_mac(x.group()) == m for x in MAC_RE.finditer(e.raw))]
               for m in macs}
    if not groups and not any(context.values()):
        return f'No events found for {query}.', False
    # MACs seen only in other lines (DHCP, RADIUS, ...): show those lines.
    groups += [(m, []) for m in sorted(macs) if m not in rep.clients and context.get(m)]

    if qnorm and len(groups) > 1:
        out.append(s(f'User {query}: {len(groups)} device'
                     f'{"s" * (len(groups) != 1)}', '1;36'))

    for mac, evs in groups:
        cs = rep.clients.get(mac) if mac else None
        if out:
            out.append('')
        if cs:
            vend = _vendor(vendors, mac)
            out.append(s(f'Client {mac}' + (f'  ({vend})' if vend else ''), '1;36'))
            out.append(s('═' * 60, '2;37'))
            if cs.users:
                out.append(f'Users:  {", ".join(u for u, _ in cs.users.most_common())}')
            if cs.aps:
                out.append(f'APs:    {", ".join(a for a, _ in cs.aps.most_common(6))}'
                           + (f' (+{len(cs.aps) - 6} more)' if len(cs.aps) > 6 else ''))
            if cs.ssids:
                out.append(f'SSIDs:  {", ".join(x for x, _ in cs.ssids.most_common())}')
            loops = cs.loops
        elif mac:
            vend = _vendor(vendors, mac)
            out.append(s(f'Client {mac}' + (f'  ({vend})' if vend else ''), '1;36'))
            out.append(s('═' * 60, '2;37'))
            out.append(f'No wireless events; {len(context[mac])} other log line'
                       f'{"s" * (len(context[mac]) != 1)} mention it.')
            loops = []
        else:
            out.append(s(f'User {query} — events with no client MAC', '1;36'))
            out.append(s('═' * 60, '2;37'))
            loops = find_failure_loops(evs, rep.rules)
        times = [e.ts for e in evs if e.ts is not None]
        nfail = sum(e.kind == 'failure' for e in evs)
        line  = f'Events: {len(evs)}  ({nfail} failure{"s" * (nfail != 1)}'
        line += f', {len(loops)} loop{"s" * (len(loops) != 1)})' if loops else ')'
        if times:
            line += f'   {_fmt_ts(min(times))} → {_fmt_ts(max(times))}'
        if evs:
            out.append(line)
        path = session_path(evs, loops)
        if path:
            out.append('Path:   ' + path)
        if cs and cs.findings:
            out.append(s('Findings:', '1;33'))
            for cat, text in cs.findings:
                out.append(s(f'  ⚠ {text}', '1;31' if cat == 'loop' else '1;33'))
        out.append('')

        items     = _chronological(list(evs) + (context.get(mac, []) if mac else []))
        loop_of   = {id(e): lp for lp in loops for e in lp.events}
        open_loop = None
        show_user = len(cs.users) > 1 if cs else False
        for ev in items:
            lp = loop_of.get(id(ev))
            if lp is not None and open_loop is not lp:
                span = (f' in {_fmt_dur(lp.end - lp.start)}' if lp.timed else ' in a row')
                aps  = ', '.join(a for a, _ in lp.aps.most_common(3))
                out.append(s(f'  ┏━ ⚠ FAILURE LOOP: {lp.count} failures{span}'
                             + (f' @ {aps}' if aps else ''), '1;31'))
                open_loop = lp
            gutter = s('  ┃ ', '1;31') if open_loop else '  '
            when   = s(_fmt_ts(ev.ts), '2;37')
            if ev.severity == 'other':
                out.append(f'{gutter}{when}  {s("· " + ev.raw.strip(), "2;37")}')
            else:
                g = _STRUCT_GLYPH.get(ev.severity) or _STRUCT_GLYPH.get(ev.kind)
                glyph = s(g[0], g[1]) if g else '  '
                name  = s(f'{ev.label:<22}', g[1] if g else None)
                det   = _event_details(ev, show_user)
                warn  = ''.join(s(f'  ⚠ {w}', '1;33') for w in ev.findings)
                out.append(f'{gutter}{when}  {glyph}{name} {det}{warn}'.rstrip())
            if open_loop is not None and ev is open_loop.events[-1]:
                if open_loop.recovery is not None:
                    r = open_loop.recovery
                    out.append(s(f'  ┗━ recovered via {r.name} at {_fmt_ts(r.ts, False)}'
                                 f' after {_fmt_dur(r.eff - open_loop.start)}', ANSI_EV_ALLOW))
                else:
                    out.append(s('  ┗━ no recovery seen', '1;31'))
                open_loop = None
    return '\n'.join(out), True


