    'allow':  {'106100'},
    'session': {'302013', '302014', '302015', '302016', '302020', '302021', '305011',
                '305012', '609001', '609002'},
    'login_fail': {'113005', '113006', '605004', '611102', '716039', '113015', '772003'},
    'login':  {'113004', '113008', '605005', '611101', '113012', '502103'},
