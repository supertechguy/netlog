class LogFormat:
    """One recognised log format.

    hint     : substrings, any of which must appear in the line before the
               (slower) parser is tried; None = always try.
    examples : (line, expected kind, {field: value}) — documentation, the
               --formats listing, and unit tests all use these.
    """
    def __init__(self, id, vendor, product, classes, hint, parse, examples, note=''):
        self.id, self.vendor, self.product = id, vendor, product
        self.short = _SHORT_NAMES.get(id, vendor)
        self.classes, self.hint, self.parse = classes, hint, parse
        self.examples, self.note = examples, note

    @property
    def label(self):
        return f'{self.vendor} {self.product}'.strip()


