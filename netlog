# ── Curses line drawing ───────────────────────────────────────────────────────

WRAP_INDENT = 4     # extra indent of wrapped continuation rows
_WORDS_RE   = re.compile(r'\s+|\S+')


def _line_cells(text, count, vendors, mac_map, ctr, search_term, search_is_regex,
                show_ln, linenum, dedup_on, hidden_cols=0, current=False):
    """One view line as (prefix, chunks) of (text, curses attr): prefix is
    the fixed lead (event glyph, or the line number), chunks the content."""
    if show_ln:
        prefix = [(f'{linenum+1:6} ', curses.A_DIM)]
    else:
        # Event type comes from the original text BEFORE column stripping so
        # the glyph still reflects the event when the keyword column is hidden.
        ev = _event_type(text)
        if ev:
            attr = curses.color_pair(ev[2]) | (curses.A_BOLD if ev[3] else 0)
            prefix = [(ev[0], attr)]
        else:
            prefix = [('  ', 0)]
    if hidden_cols:
        text = _strip_cols(text, hidden_cols)

    chunks = []
    prev   = 0
    for src_s, src_e, disp, _ansi, pair, bold, geo in \
            _collect_segments(text, vendors, mac_map, ctr, search_term, search_is_regex):
        if current and pair == _P_SRCH:
            pair = _P_SRCH_CUR
        if src_s > prev:
            chunks.append((text[prev:src_s], 0))
        chunks.append((disp, curses.color_pair(pair) | (curses.A_BOLD if bold else 0)))
        if geo:
            chunks.append((f' ({geo})', curses.color_pair(_P_GEO)))
        prev = src_e
    if prev < len(text):
        chunks.append((text[prev:], 0))
    if dedup_on and count > 1:
        chunks.append((f' [×{count}]', curses.color_pair(_P_DEDUP) | curses.A_BOLD))
    return prefix, chunks


def _layout(prefix, chunks, width, wrap=False, hoff=0, max_rows=None):
    """Place one line's cells on screen rows. Returns ([(row, x, text, attr)],
    rows used). Without wrap the content is cut at the screen edge after
    skipping `hoff` columns; with wrap it continues on following rows,
    indented WRAP_INDENT past where the content starts."""
    limit = width - 1
    out, x = [], 0
    for t, a in prefix:
        t = t[:max(0, limit - x)]
        if t:
            out.append((0, x, t, a))
            x += len(t)
    cont = x + WRAP_INDENT
    if not wrap or limit - cont < 8:          # too narrow to wrap usefully
        skip = 0 if wrap else hoff
        for t, a in chunks:
            if skip:
                if len(t) <= skip:
                    skip -= len(t)
                    continue
                t, skip = t[skip:], 0
            room = limit - x
            if room <= 0:
                break
            t = t[:room]
            out.append((0, x, t, a))
            x += len(t)
        return out, 1
    # Word wrap: a word that doesn't fit moves to the next row unless it is
    # longer than a whole row, in which case it is split.
    row, full = 0, limit - cont
    for t, a in chunks:
        for word in _WORDS_RE.findall(t):
            while word:
                room = limit - x
                if len(word) <= room:
                    out.append((row, x, word, a))
                    x += len(word)
                    break
                if word.isspace():
                    word = ''                  # spaces at a break are dropped
                elif len(word) <= full and x > cont:
                    pass                       # whole word onto the next row
                else:
                    out.append((row, x, word[:room], a))
                    word = word[room:]
                row += 1
                if max_rows is not None and row >= max_rows:
                    return out, row
                x = cont
    return out, row + 1


# ── Curses status bar ─────────────────────────────────────────────────────────

def _draw_status(win, height, width, term, is_regex, filt, offset, total,
                 dedup_on, show_ln, alert_pat, large_file=False, hidden_cols=0, msg='',
                 shown=None, wrap=False, hoff=0):
    mode  = "REGEX" if is_regex else "TEXT"
    parts = [f"[Search: {term or 'None'} ({mode})]"]
    if msg:         parts.append(f"[{msg}]")
    if large_file:  parts.append("[LARGE FILE]")
    if hidden_cols: parts.append(f"[COLS HIDDEN: {hidden_cols}]")
    if filt:        parts.append(f"[Filter: {filt}]")
    if dedup_on:    parts.append("DEDUP")
    if show_ln:     parts.append("#")
    if wrap:        parts.append("WRAP")
    elif hoff:      parts.append(f"→col {hoff + 1}")
    if alert_pat:   parts.append(f"ALERT:{alert_pat}")
    end   = min(offset + (shown if shown is not None else height - 2), total)
    line1 = "  ".join(parts) + f"  {min(offset + 1, total)}-{end}/{total}"
    pan   = "" if wrap else "  ←→=pan"
    if large_file:
        line2 = ("↑↓/WS=scroll  PgUp/Dn/Space=page  g/G=top/bot  /=text  r=regex  n/p=match  "
                 f"f=filter  l=wrap{pan}  h/u=hide-col  x=analytics  c=clear  q=quit")
    else:
        line2 = ("↑↓/WS=scroll  PgUp/Dn/Space=page  g/G=top/bot  /=text  r=regex  n/p=match  "
                 f"f=filter  l=wrap{pan}  d=dedup  #=linenum  h/u=hide-col  x=analytics  "
                 "e=export  c=clear  q=quit")
    try:
        win.addstr(height - 2, 0, line1[:width - 1], curses.color_pair(_P_STAT))
        win.clrtoeol()
        win.addstr(height - 1, 0, line2[:width - 1], curses.color_pair(_P_KEYS))
        win.clrtoeol()
    except curses.error:
        pass

# ── Curses full render ────────────────────────────────────────────────────────

def _render(win, view, offset, cells, wrap=False, hoff=0):
    """Draw view lines from `offset`; `cells(i)` gives line i's (prefix,
    chunks). Returns how many lines fit completely on screen."""
    height, width = win.getmaxyx()
    rows = height - 2
    win.erase()
    y, idx, shown = 0, offset, 0
    while y < rows and idx < len(view):
        prefix, chunks = cells(idx)
        placed, used = _layout(prefix, chunks, width, wrap, hoff, rows - y)
        for r, x, t, a in placed:
            if y + r < rows:
                try:
                    win.addstr(y + r, x, t, a)
                except curses.error:
                    pass
        if y + used <= rows:
            shown += 1
        y   += used
        idx += 1
    return shown


def _fit_back(end, rows, cells, width, wrap):
    """First line index such that lines [start, end) fill at most `rows`
    screen rows (at least one line)."""
    if not wrap:
        return max(0, end - rows)
    used, i = 0, end
    while i > 0:
        _, n = _layout(*cells(i - 1), width, True)
        if used + n > rows and i < end:
            break
        used += n
        i    -= 1
        if used >= rows:
            break
    return i


# ── Stats popup ───────────────────────────────────────────────────────────────

_SGR_FG = {'30': 0, '31': _P_EV_DENY, '32': _P_EV_ALLOW, '33': _P_EV_ERROR,
           '34': _P_IP4, '35': _P_MAC + 2, '36': _P_EV_START, '37': _P_EV_END}


def _ansi_to_cells(text):
    """Split an ANSI-colored string into [(text, curses attr)]."""
    cells, attr = [], 0
    pos = 0
    for m in re.finditer(r'\x1b\[([0-9;]*)m', text):
        if m.start() > pos:
            cells.append((text[pos:m.start()], attr))
        pos  = m.end()
        attr = 0 if m.group(1) in ('', '0') else attr
        for code in m.group(1).split(';'):
            if code == '1':
                attr |= curses.A_BOLD
            elif code == '2':
                attr |= curses.A_DIM
            elif code in _SGR_FG and _SGR_FG[code]:
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(_SGR_FG[code])
            elif code.startswith('4') and len(code) == 2 and code != '49':
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(_P_SEV)
    if pos < len(text):
        cells.append((text[pos:], attr))
    return cells


def _draw_stats(stdscr, view, vendors, cache=None, label=''):
    """Scrollable statistics popup for the current view. `cache` (a dict)
    keeps the last result so reopening the popup is instant."""
    height, width = stdscr.getmaxyx()
    key = (id(view), len(view), label)
    if cache is not None and cache.get('key') == key:
        lines = cache['lines']
    else:
        total = len(view)
        bw  = min(56, width - 4)
        bwin = curses.newwin(6, bw, (height - 6) // 2, (width - bw) // 2)
        bar_w = bw - 4
        stdscr.nodelay(True)

        def _progress(done, tot):
            pct  = done / tot if tot else 1.0
            fill = int(pct * bar_w)
            bwin.erase()
            bwin.box()
            try:
                bwin.addstr(0, 2, " Analysing ", curses.A_BOLD)
                bwin.addstr(2, 2, f"[{'#' * fill}{' ' * (bar_w - fill)}]")
                bwin.addstr(3, 2, f"{int(pct * 100):3d}%  {done:,} / {tot:,} lines"[:bar_w])
                bwin.addstr(4, 2, "Esc to cancel"[:bar_w], curses.A_DIM)
            except curses.error:
                pass
            bwin.refresh()
            if stdscr.getch() == 27:
                raise StatsCancelled()

        try:
            if total > 2000:
                _progress(0, total)
            lines = build_stats(view, vendors, _progress if total > 2000 else None,
                                color=True, label=label)
        except StatsCancelled:
            return
        finally:
            stdscr.nodelay(False)
            del bwin
        if cache is not None:
            cache['key'], cache['lines'] = key, lines

    rows  = [_ansi_to_cells(l) for l in lines]
    top, left = 0, 0
    while True:
        height, width = stdscr.getmaxyx()
        pw, ph = max(20, width - 4), max(6, height - 2)
        win = curses.newwin(ph, pw, (height - ph) // 2, (width - pw) // 2)
        win.erase()
        win.box()
        inner = ph - 2
        top   = max(0, min(top, len(rows) - inner))
        title = (f" Analytics — {top + 1}-{min(top + inner, len(rows))}/{len(rows)}  "
                 "↑↓ PgUp/PgDn g/G scroll · ←→ pan · q/Esc close ")
        try:
            win.addstr(0, 2, title[:pw - 4], curses.color_pair(_P_STAT) | curses.A_BOLD)
        except curses.error:
            pass
        for r in range(inner):
            if top + r >= len(rows):
                break
            x, skip = 2, left
            for t, a in rows[top + r]:
                if skip:
                    if len(t) <= skip:
                        skip -= len(t)
                        continue
                    t, skip = t[skip:], 0
                room = pw - 2 - x
                if room <= 0:
                    break
                try:
                    win.addstr(1 + r, x, t[:room], a)
                except curses.error:
                    pass
                x += len(t[:room])
        win.refresh()
        ch = stdscr.getch()
        if ch in (ord('q'), ord('Q'), 27, ord('x'), 10, 13):
            break
        elif ch in (curses.KEY_DOWN, ord('s'), ord('j')):
            top += 1
        elif ch in (curses.KEY_UP, ord('w'), ord('k')):
            top -= 1
        elif ch in (curses.KEY_NPAGE, ord(' ')):
            top += inner - 1
        elif ch == curses.KEY_PPAGE:
            top -= inner - 1
        elif ch == ord('g'):
            top = 0
        elif ch == ord('G'):
            top = len(rows)
        elif ch == curses.KEY_RIGHT:
            left += 20
        elif ch == curses.KEY_LEFT:
            left = max(0, left - 20)
        elif ch == curses.KEY_HOME:
            left = 0
        del win


# ── Input helper ──────────────────────────────────────────────────────────────

def _read_line(stdscr, prompt):
    """Read a line of input on the status row; None if cancelled with Esc."""
    height, width = stdscr.getmaxyx()
    curses.curs_set(1)
    buf, cx = [], len(prompt)
    stdscr.addstr(height - 2, 0, (prompt + ' ' * width)[:width - 1],
                  curses.color_pair(_P_STAT))
    stdscr.move(height - 2, cx)
    stdscr.refresh()
    while True:
        ch = stdscr.getch()
        if ch in (10, 13, curses.KEY_ENTER):
            break
        if ch == 27:                       # Esc cancels
            curses.curs_set(0)
            return None
        elif ch in (curses.KEY_BACKSPACE, 127, 8):
            if buf:
                buf.pop(); cx -= 1
                try:
                    stdscr.addch(height - 2, cx, ' ')
                    stdscr.move(height - 2, cx)
                except curses.error:
                    pass
        elif 32 <= ch < 127 and cx < width - 1:
            buf.append(chr(ch))
            try:
                stdscr.addch(height - 2, cx, chr(ch)); cx += 1
            except curses.error:
                pass
        stdscr.refresh()
    curses.curs_set(0)
    return ''.join(buf)

# ── Interactive TUI ───────────────────────────────────────────────────────────

def _tui(stdscr, lines, vendors, mac_map, ctr, alert_pat=None, col_hidden=None, file_base=None,
         prefs=None):
    _init_colors()
    curses.curs_set(0)
    stdscr.keypad(True)
    if hasattr(curses, 'set_escdelay'):
        curses.set_escdelay(25)            # Esc cancels prompts without a 1 s lag

    prefs       = prefs if prefs is not None else {}
    large_file  = isinstance(lines, LargeFile)
    filtered    = lines if large_file else lines[:]
    filt_idx    = None      # large files: array of matching line numbers
    dedup_on    = False
    show_ln     = False
    wrap        = bool(prefs.get('wrap', True))
    hoff        = 0         # horizontal scroll when not wrapping
    offset      = 0
    shown       = 1         # lines that fit on the last drawn screen
    term        = None
    is_regex    = False
    matches     = []
    cur         = None      # index of the current search match
    msg         = ''        # one-shot status message
    filt        = None
    hidden_cols = (col_hidden or {}).get(file_base or '', 0)
    stats_cache = {}

    def get_view():
        if large_file:
            return LargeFileView(lines, filt_idx)
        return dedup_lines(filtered) if dedup_on else as_view(filtered)

    def cells(i):
        text, count = view[i]
        return _line_cells(text, count, vendors, mac_map, ctr, term, is_regex,
                           show_ln, i, dedup_on, hidden_cols, i == cur)

    def status_msg(text):
        h, w = stdscr.getmaxyx()
        try:
            stdscr.addstr(h - 2, 0, text[:w - 1], curses.color_pair(_P_STAT))
            stdscr.clrtoeol(); stdscr.refresh()
        except curses.error:
            pass

    def filter_large(pred):
        """Matching line numbers of the large file, or None if cancelled."""
        idx, n = array.array('Q'), len(lines)
        stdscr.nodelay(True)
        try:
            for i in range(n):
                if pred(lines[i]):
                    idx.append(i)
                if i % 20000 == 0:
                    status_msg(f"Filtering… {i * 100 // max(1, n)}%  "
                               f"({len(idx):,} matches, Esc to cancel)")
                    if stdscr.getch() == 27:
                        return None
        finally:
            stdscr.nodelay(False)
        return idx

    view = get_view()

    while True:
        height, width = stdscr.getmaxyx()
        rows = max(1, height - 2)

        shown = _render(stdscr, view, offset, cells, wrap, hoff)
        _draw_status(stdscr, height, width, term, is_regex, filt, offset, len(view),
                     dedup_on, show_ln, alert_pat, large_file, hidden_cols, msg,
                     shown, wrap, hoff)
        stdscr.refresh()
        msg = ''

        def goto(start, step, new_search=False):
            """Move to the next match from `start`; returns the status message."""
            nonlocal cur, offset
            if large_file:
                status_msg("Searching…")
            idx, wrapped = next_match(view, term, is_regex, start, step,
                                      None if large_file else matches)
            if idx is None:
                cur = None
                return f"No matches for {term!r}"
            cur    = idx
            offset = max(0, idx - 2)
            where  = (f"match {bisect.bisect_left(matches, idx) + 1}/{len(matches)}"
                      if not large_file else f"match at line {idx + 1}")
            if wrapped and not new_search:
                where += ", wrapped to " + ("top" if step > 0 else "bottom")
            return where

        ch = stdscr.getch()

        if ch == curses.KEY_RESIZE:
            continue
        elif ch in (curses.KEY_UP, ord('w'), ord('W')):
            offset -= 1
        elif ch in (curses.KEY_DOWN, ord('s'), ord('S')):
            offset += 1
        elif ch == curses.KEY_PPAGE:
            offset = _fit_back(offset, rows, cells, width, wrap)
        elif ch in (curses.KEY_NPAGE, ord(' ')):
            offset += max(1, shown)
        elif ch == ord('g'):
            offset = 0
        elif ch == ord('G'):
            offset = len(view)

        elif ch == ord('l'):
            wrap = not wrap
            hoff = 0
            prefs['wrap'] = wrap
            msg = "Wrapping long lines" if wrap else "Not wrapping: ←/→ to scroll sideways"

        elif ch in (curses.KEY_LEFT, curses.KEY_RIGHT, curses.KEY_HOME):
            if wrap:
                msg = "Lines are wrapped: press l to turn wrapping off and scroll sideways"
            elif ch == curses.KEY_HOME:
                hoff = 0
            else:
                step = max(8, (width - 10) // 2)
                hoff = max(0, hoff + (step if ch == curses.KEY_RIGHT else -step))

        elif ch in (ord('/'), ord('r')):
            regex = ch == ord('r')
            t = _read_line(stdscr, "Search (regex): " if regex else "Search (plain text): ")
            if t:
                try:
                    if regex:
                        re.compile(t, re.I)
                except re.error as e:
                    msg = f"Invalid regex: {e}"
                else:
                    term, is_regex = t, regex
                    if not large_file:
                        matches = find_matches(view, term, is_regex)
                    msg = goto(offset, 1, new_search=True)

        elif ch in (ord('n'), ord('p')):
            step = 1 if ch == ord('n') else -1
            if not term:
                msg = "No search yet: press / or r"
            else:
                # Continue from the current match if it's still on screen,
                # otherwise from the screen position (like less).
                if cur is not None and offset <= cur < offset + max(1, shown):
                    start = cur + step
                else:
                    start = offset if step > 0 else offset - 1
                msg = goto(start, step)

        elif ch == ord('f'):
            t = _read_line(stdscr, "Filter (a|b = any of, !x = exclude, r:regex, "
                                   "empty = remove filter): ")
            changed = False
            if t is None:
                pass
            elif not t:
                if filt:
                    filtered, filt_idx, filt = (lines if large_file else lines[:]), None, None
                    msg, changed = "Filter removed", True
                else:
                    msg = "No filter to remove"
            else:
                try:
                    pred = make_line_filter(t)
                except (ValueError, re.error) as e:
                    msg = f"Invalid filter: {e}"
                    pred = None
                if pred is not None:
                    if large_file:
                        hits = filter_large(pred)
                    else:
                        hits = [l for l in lines if pred(l)]
                    if hits is None:
                        msg = "Filter cancelled"
                    elif not hits:
                        msg = f"No lines match {t!r}: filter not applied"
                    else:
                        if large_file:
                            filt_idx = hits
                        else:
                            filtered = hits
                        filt, changed = t, True
                        msg = f"{len(hits):,} of {len(lines):,} lines match"
            if changed:
                view    = get_view()
                offset  = 0
                cur     = None
                matches = find_matches(view, term, is_regex) if term and not large_file else []

        elif ch == ord('d'):
            if large_file:
                msg = "Dedup not available in large file mode"
            else:
                dedup_on = not dedup_on
                view    = get_view()
                offset  = max(0, min(offset, max(0, len(view) - 1)))
                cur     = None
                matches = find_matches(view, term, is_regex) if term else []

        elif ch == ord('#'):
            if not large_file:
                show_ln = not show_ln

        elif ch == ord('x'):
            what = f"{len(view):,} lines" + (f", filter {filt!r}" if filt else "")
            _draw_stats(stdscr, view, vendors, stats_cache, what)

        elif ch == ord('e'):
            if large_file:
                msg = "Export not available in large file mode"
            else:
                export = 'logview_filtered_export.txt'
                try:
                    Path(export).write_text('\n'.join(t for t, _ in view))
                    msg = f"Exported {len(view)} lines to {export}"
                except OSError as e:
                    msg = f"Export failed: {e}"

        elif ch == ord('h'):
            hidden_cols += 1

        elif ch == ord('u'):
            hidden_cols = max(0, hidden_cols - 1)

        elif ch == ord('c'):
            filtered = lines if large_file else lines[:]
            filt_idx = filt = term = cur = None
            is_regex = dedup_on = False
            matches  = []
            offset   = hoff = 0
            view     = get_view()
            msg      = "Search and filter cleared"

        elif ch == ord('q'):
            break

        last   = _fit_back(len(view), rows, cells, width, wrap) if len(view) else 0
        offset = max(0, min(offset, last))

    if col_hidden is not None and file_base:
        col_hidden[file_base] = hidden_cols
    save_color_map(COLOR_FILE, mac_map, ctr[0], col_hidden)

