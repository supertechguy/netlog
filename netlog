    a.add_argument('--legacy-ssid', default=r'[-_](?:old|legacy)$', metavar='REGEX',
                    help='SSIDs matching this regex count as legacy '
                         '(default: names ending in -old/-legacy)')
    a.add_argument('--low-rssi', type=int, default=-75, metavar='DBM',
