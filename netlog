def _glyph_for(kind, severity, name=''):
    if severity == 'error':
        return _STRUCT_GLYPH['error']
    if kind == 'session' and _SESSION_END.search(name or ''):
        return _KIND_GLYPH['disconnect']
    g = _KIND_GLYPH.get(kind)
    if g:
        return g
    return _STRUCT_GLYPH.get(severity) if severity in ('warning', 'success') else None


def _structured_glyph(text):
    p = parse_event(text)
    if p is None:
        return None
    return _glyph_for(p.kind, event_severity(p), p.name)


def failure_label(name, fields):
    """Name to report a failure under: the event name, plus the status when
    the name alone doesn't say it failed (clientAuthorization result=failure)."""
    name = name or '(unnamed)'
    st   = fields.get('status')
    if st and not _FAIL_WORD.search(name):
        return f'{name} ({st})'
    return name


