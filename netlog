def build_arg_parser():
    p = argparse.ArgumentParser(
        prog='netlog',
        description='Terminal network log viewer with MAC/IP/syslog highlighting.',
        epilog=(
            'Examples:\n'
            '  netlog /var/log/syslog                 Interactive TUI viewer\n'
            '  netlog -f /var/log/syslog               Follow mode (like tail -f)\n'
            '  netlog -f -n 50 /var/log/syslog          Follow, last 50 lines first\n'
            '  netlog -f "deny|drop" /var/log/fw.log    Follow, egrep-filtered\n'
            '  netlog -f --alert DENY /var/log/fw.log   Follow with alert bell\n'
            '  cat file.log | netlog                    Piped/ANSI mode\n'
            '  netlog --summary /var/log/wlc.log        Health summary report\n'
            '  netlog --client alice /var/log/wlc.log   Timeline for one user or MAC\n'
            '  netlog --setup-geoip                     Configure MaxMind GeoIP'
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument('-f', dest='follow', action='store_true',
                    help='Follow mode (tail -f style)')
    p.add_argument('-n', dest='tail_lines', type=int, default=10, metavar='N',
                    help='Lines to show initially in follow mode (default: 10)')
    p.add_argument('--alert', dest='alert_pat', metavar='PATTERN',
                    help='Bell + highlight new lines matching this regex in follow mode')
    p.add_argument('--setup-geoip', dest='setup_geoip', action='store_true',
                    help='Configure (or reconfigure) MaxMind GeoIP credentials, then exit')
    a = p.add_argument_group(
        'analysis', 'For logs with key="value" fields (clientMac=, userName=, apName=, '
                    'apLocation=, ssid=, rssi=, ...). Both modes read the FILEs, '
                    'or stdin if none are given.')
    a.add_argument('--summary', action='store_true',
                    help='Print a health summary: top failing clients/users, AP and '
                         'location failure rates, failure types, and anomalies')
    a.add_argument('--client', metavar='MAC|USER',
                    help='Print a chronological timeline for one client MAC (any notation) '
                         'or username (alice, alice@corp.org and CORP\\alice all match)')
    a.add_argument('--loop-threshold', type=int, default=3, metavar='N',
                    help='Failures needed to call it a failure loop (default: 3)')
    a.add_argument('--loop-window', type=_duration_arg, default=300, metavar='TIME',
                    help='Rolling window for failure loops, e.g. 300, 90s, 5m (default: 5m)')
    a.add_argument('--legacy-ssid', default=r'[-_](?:old|legacy)$', metavar='REGEX',
                    help='SSIDs matching this regex count as legacy '
                         '(default: names ending in -old/-legacy)')
    a.add_argument('--low-rssi', type=int, default=-75, metavar='DBM',
                    help='RSSI below this is flagged as low signal (default: -75)')
    a.add_argument('--top', type=int, default=10, metavar='N',
                    help='Rows per section in --summary (default: 10)')
    p.add_argument('--version', action='version', version=f'netlog {VERSION}')
    p.add_argument('args', nargs='*', metavar='FILE',
                    help='Log file(s) to view; shell globs are supported. In follow mode, '
                         'if two or more FILE arguments are given, the first is treated as '
                         'an egrep-style filter pattern instead of a filename.')
    return p


def _duration_arg(text):
    """'300' / '90s' / '5m' / '1h' → seconds."""
    m = re.fullmatch(r'\s*(\d+(?:\.\d+)?)\s*([smh]?)\s*', text, re.I)
    if not m or float(m.group(1)) <= 0:
        raise argparse.ArgumentTypeError(f'invalid duration: {text!r} (try 300, 90s, 5m)')
    return float(m.group(1)) * {'': 1, 's': 1, 'm': 60, 'h': 3600}[m.group(2).lower()]


def parse_cli(argv=None):
    """Parse the command line. Returns the argparse namespace plus
    log_files (expanded globs) and egrep_pat."""
    p  = build_arg_parser()
    ns = p.parse_args(argv)
    if ns.follow and (ns.summary or ns.client):
        p.error('-f cannot be combined with --summary or --client')
    if ns.loop_threshold < 1:
        p.error('--loop-threshold must be at least 1')
    if ns.top < 1:
        p.error('--top must be at least 1')
    try:
        re.compile(ns.legacy_ssid)
    except re.error as e:
        p.error(f'invalid --legacy-ssid regex: {e}')

    positionals = ns.args
    if ns.follow and len(positionals) >= 2:
        ns.egrep_pat, *file_args = positionals
    else:
        ns.egrep_pat, file_args = None, positionals

    ns.log_files = []
    for a in file_args:
        matches = sorted(glob.glob(a))
        for f in (matches or [a]):
            ns.log_files.append(Path(f))
    return ns


def parse_args(argv=None):
    """Legacy tuple form of parse_cli()."""
    ns = parse_cli(argv)
    return ns.follow, ns.tail_lines, ns.log_files, ns.alert_pat, ns.egrep_pat, ns.setup_geoip


def main():
    global _GEO_READER, RULES
    opts = parse_cli()
    follow, tail_lines, log_files = opts.follow, opts.tail_lines, opts.log_files
    alert_pat, egrep_pat, setup_geoip = opts.alert_pat, opts.egrep_pat, opts.setup_geoip
    RULES = Rules(loop_threshold=opts.loop_threshold, loop_window=opts.loop_window,
                  legacy_ssid=opts.legacy_ssid, low_rssi=opts.low_rssi, top=opts.top)

    cfg = load_config()
    if setup_geoip:
        setup_geoip_cmd(cfg)   # exits the process

    if opts.summary or opts.client:
        missing = [f for f in log_files if not f.exists()]
        if missing:
            sys.exit(f"File not found: {missing[0]}")
        if not log_files and sys.stdin.isatty():
            sys.exit('Usage: netlog --summary|--client MAC|USER <file> [file2 ...]  '
                     '(or pipe the log in)')
        analysis_mode(log_files, load_oui(OUI_FILE), opts.summary, opts.client)
        return

    vendors = load_oui(OUI_FILE)
    mac_map, idx, col_hidden = load_color_map(COLOR_FILE)
    ctr = [idx]

    # Never prompt interactively when stdin isn't a real terminal — e.g. piped
    # log input, cron, or CI would otherwise have input() read from the pipe.
    _GEO_READER = load_geoip(cfg, allow_prompt=sys.stdin.isatty())
    if _GEO_READER is None and not HAS_GEOIP:
        print("GeoIP: install 'maxminddb' for IP location lookup  (pip install maxminddb)",
              file=sys.stderr)

    if not sys.stdin.isatty():
        piped_mode(vendors, mac_map, ctr)
    elif follow:
        if not log_files:
            sys.exit('Usage: netlog -f [-n N] [--alert PATTERN] ["egrep_pattern"] <file>')
        lf = log_files[0]
        if not lf.exists():
            sys.exit(f"File not found: {lf}")
        file_base = _file_base(lf)
        tail_mode(lf, tail_lines, vendors, mac_map, ctr, alert_pat, col_hidden, file_base, egrep_pat)
    elif log_files:
        missing = [f for f in log_files if not f.exists()]
        if missing:
            sys.exit(f"File not found: {missing[0]}")
        file_base = _file_base(log_files[0])
        interactive_mode(log_files, vendors, mac_map, ctr, alert_pat, col_hidden, file_base)
    else:
        print('Usage: netlog [-f] [-n N] [--alert PATTERN] ["egrep_pattern"] <file> [file2 ...]',
              file=sys.stderr)
        print("Or:    cat file.log | netlog", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
