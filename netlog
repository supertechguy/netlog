class FirewallStats:
    """Running totals for firewall traffic: these lines can number millions,
    so they're aggregated as they're read instead of being kept."""
    _CAP = 512     # per-source distinct port / host sets stop growing here

    def __init__(self, rules):
        self.rules   = rules
        self.deny    = 0
        self.allow   = 0
        self.session = 0
        self.sources = {}
        self.ports   = Counter()      # (port, proto) → denies
        self.rule    = Counter()
        self.dsts    = Counter()
        self.allow_ports = Counter()  # (port, proto) → allowed connections
        self.allow_src   = Counter()  # source → allowed connections ("top talkers")
        self.protos      = Counter()  # protocol → all firewall events

        self.exposed     = {}         # (dst, port) → [allowed count, public sources set]
        self.outbound    = {}         # (src, port) → [count, public destinations set]

    _KEYS_CAP = 50000  # distinct keys kept per allow counter

    def _risk(self, kind, f, dpt):
        """Track risky services allowed in from the internet, and internal
        hosts reaching risky ports (or many mail servers) on the internet."""
        try:
            port = int(dpt)
        except (TypeError, ValueError):
            return
        if port not in RISKY_PORTS and port != 25:
            return
        src, dst = f.get('src_ip'), f.get('dst_ip')
        if not src or not dst:
            return
        s_scope, d_scope = ip_scope(src), ip_scope(dst)
        if kind == 'allow' and s_scope == 'public' and d_scope == 'private' and port in RISKY_PORTS:
            st = self.exposed.get((dst, port))
            if st is None:
                if len(self.exposed) >= self._KEYS_CAP:
                    return
                st = self.exposed[(dst, port)] = [0, set()]
            st[0] += 1
            if len(st[1]) < 512:
                st[1].add(src)
        elif s_scope == 'private' and d_scope == 'public' and \
                (port in OUTBOUND_RISKY or port == 25):
            st = self.outbound.get((src, port))
            if st is None:
                if len(self.outbound) >= self._KEYS_CAP:
                    return
                st = self.outbound[(src, port)] = [0, set()]
            st[0] += 1
            if len(st[1]) < 512:
                st[1].add(dst)

    def add(self, p):
        kind = p.kind
        f    = p.fields
        proto = (f.get('proto') or '').lower()
        if proto:
            self.protos[proto] += 1
        if kind != 'deny':
            if kind == 'allow':
                self.allow += 1
                dpt, src = f.get('dst_port'), f.get('src_ip')
                if dpt:
                    self._risk('allow', f, dpt)
                if dpt and ((dpt, proto) in self.allow_ports
                            or len(self.allow_ports) < self._KEYS_CAP):
                    self.allow_ports[(dpt, proto)] += 1
                if src and (src in self.allow_src or len(self.allow_src) < self._KEYS_CAP):
                    self.allow_src[src] += 1
            else:
                self.session += 1
            return
        self.deny += 1
        src  = f.get('src_ip') or '?'
        dpt  = f.get('dst_port')
        dst  = f.get('dst_ip')
        if dpt:
            self._risk('deny', f, dpt)
        if dpt:
            self.ports[(dpt, (f.get('proto') or '').lower())] += 1
        if f.get('rule'):
            self.rule[f['rule']] += 1
        if dst:
            self.dsts[dst] += 1
        st = self.sources.get(src)
        if st is None:
            st = self.sources[src] = _DenySource()
        st.count += 1
        ts = p.ts
        if ts is not None:
            st.first = ts if st.first is None else min(st.first, ts)
            st.last  = ts if st.last is None else max(st.last, ts)
        if dpt and len(st.ports) < self._CAP:
            st.ports.add(dpt)
        if dst and len(st.dsts) < self._CAP:
            st.dsts.add(dst)
        # Scan detection in fixed time buckets (sliding windows would mean
        # keeping every deny).
        bucket = int(ts // self.rules.scan_window) if ts is not None else 0
        if bucket != st.bucket:
            st.bucket, st.b_ports, st.b_dsts = bucket, set(), set()
        if dpt and len(st.b_ports) < self._CAP:
            st.b_ports.add(dpt)
        if dst and len(st.b_dsts) < self._CAP:
            st.b_dsts.add(dst)
        st.max_ports = max(st.max_ports, len(st.b_ports))
        st.max_dsts  = max(st.max_dsts, len(st.b_dsts))


class Analyzer:
    """Feeds log lines in; keeps structured events for Report and running
    totals for the high-volume ones (firewall traffic)."""
    def __init__(self, rules=None, keep_raw=False, context_macs=None):
        self.rules        = rules or RULES
        self.keep_raw     = keep_raw
        self.context_macs = context_macs   # keep non-structured lines naming these MACs
        self.events       = []
        self.context      = []
        self.lines        = 0
        self.unparsed     = 0
        self.formats      = Counter()
        self.severity     = Counter()
        self.issues       = Counter()      # (severity, label) for errors and warnings
        self.devices      = {}
        self.fw           = FirewallStats(self.rules)
        self.text_issues  = {}             # (id, host) → [count, first_ts, last_ts, sample]
        self.err_buckets  = Counter()      # 5-minute bucket → error + warning events
        self.ev_buckets   = Counter()      # 5-minute bucket → all events
        self.critical     = {}             # (host, name) → [count, syslog sev, last_ts, sample]

    def _text_issue(self, line, host, ts, issue=None):
        issue = issue or text_issue(line)
        if issue is None:
            return
        key = (issue, host or '(no host)')
        st  = self.text_issues.get(key)
        if st is None:
            if len(self.text_issues) >= 20000:
                return
            st = self.text_issues[key] = [0, ts, ts, line.strip()[:200]]
        st[0] += 1
        if ts is not None:
            st[1] = ts if st[1] is None else min(st[1], ts)
            st[2] = ts if st[2] is None else max(st[2], ts)

    def _critical(self, host, name, sev, ts, line):
        key = (host or '(no host)', name[:80])
        st  = self.critical.get(key)
        if st is None:
            if len(self.critical) >= 5000:
                return
            st = self.critical[key] = [0, sev, ts, line.strip()[:200]]
        st[0] += 1
        st[1] = min(st[1], sev)
        if ts is not None:
            st[2] = ts

    def feed(self, line):
        self.lines += 1
        p = _parse_event(line)
        if p is None:
            if line.strip():
                self.unparsed += 1
                sev, host = syslog_header(line)
                issue = text_issue(line)
                ts = parse_timestamp(line) if issue or (sev is not None and sev <= 2) else None
                if issue:
                    self._text_issue(line, host, ts, issue)
                elif sev is not None and sev <= 2:
                    self._critical(host, _msg_part(line)[:60], sev, ts, line)
            if self.context_macs and MAC_RE.search(line):
                for m in MAC_RE.finditer(line):
                    if norm_mac(m.group()) in self.context_macs:
                        self.context.append(LogEvent(self.lines, parse_timestamp(line),
                                                     '', None, 'other', {}, [], line))
                        break
            return None
        findings = event_findings(p, self.rules) or ()
        sev      = event_severity(p, self.rules, findings)
        f        = p.fields
        label    = failure_label(p.name, f) if p.kind == 'failure' else (p.name or '(event)')
        self.formats[p.fmt] += 1
        self.severity[sev]  += 1
        host = f.get('host') or '(no host)'
        dev  = self.devices.get(host)
        if dev is None:
            dev = self.devices[host] = DeviceStats(host)
        dev.events += 1
        dev.severity[sev] += 1
        dev.formats[p.fmt] += 1
        if sev in ('error', 'warning'):
            self.issues[(sev, label)] += 1
            dev.issues[label] += 1
        ts = p.ts
        if ts is not None:
            if dev.first is None or ts < dev.first:
                dev.first = ts
            if dev.last is None or ts > dev.last:
                dev.last = ts
            b = int(ts // 300)
            self.ev_buckets[b] += 1
            if sev in ('error', 'warning'):
                self.err_buckets[b] += 1
        if p.kind is None:
            self._text_issue(line, f.get('host'), ts)
        if p.kind is None and p.vsev is not None and p.vsev <= 2:
            # Classified events are reported by their own rules.
            self._critical(host, p.name or '(event)', p.vsev, ts, line)

        has_entity = any(k in f for k in _ENTITY_FIELDS)
        if p.kind in ('deny', 'allow', 'session'):
            self.fw.add(p)
            if not ('client_mac' in f or 'user' in f):
                return None
        elif p.kind is None and not has_entity and p.fmt != 'kv':
            return None                # unclassified vendor message: counted only
        ev = LogEvent(self.lines, p.ts, p.name, p.kind, sev, f, findings,
                      line if self.keep_raw else None, p.fmt)
        self.events.append(ev)
        return ev


def _chronological(events):
    """Sort events by time, keeping input order for ties. Events with no
    timestamp inherit the previous event's time (set as .eff) so they stay
    next to their neighbours instead of all sorting to the start."""
    out  = sorted(events, key=lambda e: e.seq)
    last = None
    for ev in out:
        ev.eff = ev.ts if ev.ts is not None else (last if last is not None else 0.0)
        last   = ev.eff
    out.sort(key=lambda e: (e.eff, e.seq))
    return out


def _max_in_window(times, window):
    """Largest number of entries of the sorted list `times` within any `window`."""
    best, lo = 0, 0
    for hi, t in enumerate(times):
        while t - times[lo] > window:
            lo += 1
        best = max(best, hi - lo + 1)
    return best


class FailureLoop:
    def __init__(self, client, events, recovery):
        self.client   = client
        self.events   = events
        self.recovery = recovery
        self.count    = len(events)
        self.start    = events[0].eff
        self.end      = events[-1].eff
        self.timed    = all(e.ts is not None for e in events)
        self.aps      = Counter(e.ap for e in events if e.ap)
        self.names    = Counter(e.label for e in events)
        self.users    = Counter(e.fields['user'] for e in events if 'user' in e.fields)


def find_failure_loops(events, rules=None, client=None):
    """Failure loops in one client's chronological events.

    Failures are grouped into runs that end at a successful join/auth or a
    quiet gap longer than the loop window. A run is a loop when at least
    `loop_threshold` of its failures fall inside one `loop_window`. Events
    without timestamps count as simultaneous, so for logs with no times this
    becomes 'N failures in a row without a success'.
    """
    rules = rules or RULES
    loops, run = [], []

    def close(recovery):
        if len(run) >= rules.loop_threshold and \
           _max_in_window([e.eff for e in run], rules.loop_window) >= rules.loop_threshold:
            loops.append(FailureLoop(client, list(run), recovery))
        run.clear()

    for ev in events:
        if ev.kind == 'failure':
            if run and ev.eff - run[-1].eff > rules.loop_window:
                close(None)
            run.append(ev)
        elif ev.kind in ('join', 'auth') and run:
            close(ev)
    close(None)
    return loops


class SiteStats:
    """Failure / join counts for one AP or one location."""
    def __init__(self, key):
        self.key      = key
        self.ap_mac   = None
        self.location = None
        self.failures = 0
        self.joins    = 0
        self.auths    = 0
        self.total    = 0
        self.clients  = set()
        self.fail_by  = Counter()
        self.flagged  = False

    @property
    def successes(self):
        # Prefer joins as the "normal" baseline; fall back to authorizations
        # for logs that only record those.
        return self.joins or self.auths

    @property
    def rate(self):
        attempts = self.failures + self.successes
        return self.failures / attempts if attempts else 0.0


class LinkStats:
    """Up/down history for one interface on one device. Repeated downs with
    no up in between (LINK + LINEPROTO messages) count once."""
    def __init__(self, host, iface):
        self.host, self.iface = host, iface
        self.downs       = []
        self.ups         = 0
        self.state       = None
        self.last_ts     = None
        self.err_disable = 0
        self.flapping    = False

    def add(self, ev):
        if ev.kind == 'link_down':
            if self.state != 'down':
                self.downs.append(ev.eff)
            self.state = 'down'
        else:
            if self.state != 'up':
                self.ups += 1
            self.state = 'up'
        self.last_ts = ev.ts


class ClientStats:
    def __init__(self, mac):
        self.mac       = mac
        self.events    = []
        self.users     = Counter()
        self.aps       = Counter()
        self.ssids     = Counter()
        self.failures  = 0
        self.loops     = []
        self.findings  = []      # (category, text)
        self.legacy    = Counter()
        self.legacy_fail = 0
        self.low_rssi  = 0
        self.min_rssi  = None


class UserStats:
    def __init__(self, norm):
        self.norm     = norm
        self.forms    = Counter()
        self.macs     = set()
        self.failures = 0
        self.total    = 0

    @property
    def label(self):
        return self.forms.most_common(1)[0][0] if self.forms else self.norm


class Report:
    """Everything --summary and --client need, computed once from events."""
    def __init__(self, analyzer):
        rules        = analyzer.rules
        self.rules   = rules
        self.lines   = analyzer.lines
        self.events  = _chronological(analyzer.events)
        self.context = analyzer.context
        self.severity      = analyzer.severity
        self.formats       = analyzer.formats
        self.unparsed      = analyzer.unparsed
        self.devices       = analyzer.devices
        self.issues        = analyzer.issues
        self.fw            = analyzer.fw
        self.text_issues   = analyzer.text_issues
        self.err_buckets   = analyzer.err_buckets
        self.ev_buckets    = analyzer.ev_buckets
        self.critical      = analyzer.critical
        self.parsed        = sum(analyzer.formats.values())
        self.fail_by_event = Counter(e.label for e in self.events if e.kind == 'failure')
        times = [e.ts for e in self.events if e.ts is not None]
        self.first_ts = min(times) if times else None
        self.last_ts  = max(times) if times else None

        self.clients   = {}
        self.users     = {}
        self.aps       = {}
        self.locations = {}
        # Many controllers only include apLocation on some events; attribute
        # the rest to the location their AP reports elsewhere in the log.
        ap_loc = {}
        for ev in self.events:
            if ev.ap and ev.fields.get('ap_loc'):
                ap_loc.setdefault(ev.ap, ev.fields['ap_loc'])
        for ev in self.events:
            f   = ev.fields
            mac = f.get('client_mac')
            loc = f.get('ap_loc') or ap_loc.get(ev.ap)
            if mac:
                cs = self.clients.get(mac) or self.clients.setdefault(mac, ClientStats(mac))
                cs.events.append(ev)
                if 'user' in f:   cs.users[f['user']] += 1
                if ev.ap:         cs.aps[ev.ap] += 1
                if 'ssid' in f:   cs.ssids[f['ssid']] += 1
                if ev.kind == 'failure':
                    cs.failures += 1
                if 'ssid' in f and rules.legacy_re.search(f['ssid']):
                    cs.legacy[f['ssid']] += 1
                    if ev.kind == 'failure':
                        cs.legacy_fail += 1
                rssi = rssi_value(f)
                if rssi is not None and rssi < 0:
                    if rssi < rules.low_rssi:
                        cs.low_rssi += 1
                    cs.min_rssi = rssi if cs.min_rssi is None else min(cs.min_rssi, rssi)
            if 'user' in f:
                n  = norm_user(f['user'])
                us = self.users.get(n) or self.users.setdefault(n, UserStats(n))
                us.forms[f['user']] += 1
                us.total += 1
                if mac:
                    us.macs.add(mac)
                if ev.kind == 'failure':
                    us.failures += 1
            for table, key in ((self.aps, ev.ap), (self.locations, loc)):
                if not key:
                    continue
                ss = table.get(key) or table.setdefault(key, SiteStats(key))
                ss.total += 1
                if mac:
                    ss.clients.add(mac)
                if table is self.aps:
                    ss.ap_mac   = ss.ap_mac or f.get('ap_mac')
                    ss.location = ss.location or loc
                if ev.kind == 'failure':
                    ss.failures += 1
                    ss.fail_by[ev.label] += 1
                elif ev.kind == 'join':
                    ss.joins += 1
                elif ev.kind == 'auth':
                    ss.auths += 1

        self.loops = []
        for cs in self.clients.values():
            self._client_findings(cs, rules)
            self.loops.extend(cs.loops)
        self.loops.sort(key=lambda lp: (-lp.count, lp.start))

        self.ap_baseline  = self._flag_hotspots(self.aps.values(), rules)
        self.loc_baseline = self._flag_hotspots(self.locations.values(), rules)
        self.findings     = []      # network-wide: (category, severity, subject, text)
        self._network(rules)
        self._firewall(rules)

    # ── Switching, routing, auth and infrastructure ──────────────────────────

    def _network(self, rules):
        self.links     = {}         # (host, iface) → LinkStats
        self.neighbors = {}         # (host, neighbor) → [downs, ups, last_state, last_ts]
        self.l2        = Counter()  # (kind, host, iface) for loop / err_disable / stp / ...
        self.l2_msg    = {}
        self.login_src = {}         # src → [fail times]
        self.login_usr = Counter()
        self.login_ok_after = []    # (src, failures, ev) successful login after failures
        self.configs   = []
        self.threats   = Counter()
        self.threat_src = Counter()
        self.infra     = {}         # (category, subject) → [count, last_ts, sample]
        fails_since_ok = Counter()
        for ev in self.events:
            k, f = ev.kind, ev.fields
            host = f.get('host') or '?'
            if k in ('link_down', 'link_up'):
                key = (host, f.get('iface') or '?')
                ls  = self.links.get(key) or self.links.setdefault(key, LinkStats(*key))
                ls.add(ev)
            elif k in ('neighbor_down', 'neighbor_up'):
                key = (host, f.get('neighbor') or f.get('peer') or ev.name)
                st  = self.neighbors.setdefault(key, [0, 0, None, None, []])
                if k == 'neighbor_down':
                    st[0] += 1
                    st[4].append(ev.eff)
                else:
                    st[1] += 1
                st[2], st[3] = k, ev.ts
            elif k in ('loop', 'err_disable', 'stp', 'violation', 'port_error', 'poe'):
                key = (k, host, f.get('iface') or f.get('vlan') and f'vlan {f["vlan"]}' or '')
                self.l2[key] += 1
                self.l2_msg[key] = f.get('msg') or ev.name
                if k == 'err_disable':
                    ls = self.links.get((host, f.get('iface') or '?'))
                    if ls is None:
                        ls = self.links.setdefault((host, f.get('iface') or '?'),
                                                   LinkStats(host, f.get('iface') or '?'))
                    ls.err_disable += 1
                    ls.state, ls.last_ts = 'err-disabled', ev.ts
            elif k == 'login_fail':
                src = f.get('src_ip') or (f'user {f["user"]}' if 'user' in f else host)
                self.login_src.setdefault(src, []).append(ev.eff)
                if 'user' in f:
                    self.login_usr[f['user']] += 1
                fails_since_ok[src] += 1
            elif k == 'login':
                src = f.get('src_ip') or (f'user {f["user"]}' if 'user' in f else host)
                if fails_since_ok[src] >= rules.brute_threshold:
                    self.login_ok_after.append((src, fails_since_ok[src], ev))
                fails_since_ok[src] = 0
            elif k == 'config':
                self.configs.append(ev)
            elif k == 'threat':
                self.threats[f.get('signature') or ev.name] += 1
                self.threat_src[f.get('src_ip') or '?'] += 1
            elif k in ('vpn_down', 'vpn_up', 'service_down', 'service_up', 'failover', 'hw',
                       'reboot', 'ap_down', 'ap_up'):
                subject = {'vpn_down': f.get('peer') or f.get('tunnel') or host,
                           'vpn_up': f.get('peer') or f.get('tunnel') or host,
                           'ap_down': ev.ap or host, 'ap_up': ev.ap or host,
                           'reboot': ev.ap or host}.get(k, host)
                st = self.infra.setdefault((k, subject), [0, None, ''])
                st[0] += 1
                st[1] = ev.ts
                st[2] = f.get('msg') or ev.name

        F = self.findings
        for ls in self.links.values():
            n = _max_in_window(ls.downs, rules.flap_window) if ls.downs else 0
            ls.flapping = n >= rules.flap_threshold
            if ls.flapping:
                F.append(('flap', 'error', f'{ls.host} {ls.iface}',
                          f'interface flapping: {n} link downs within {_fmt_dur(rules.flap_window)} '
                          f'({len(ls.downs)} total)'))
            if ls.err_disable:
                F.append(('errdisable', 'error', f'{ls.host} {ls.iface}', 'port err-disabled'))
        for (kind, host, where), n in self.l2.items():
            if kind in ('loop', 'violation'):
                F.append((kind, 'error' if kind == 'loop' else 'warning',
                          f'{host} {where}'.strip(), f'{n} × {self.l2_msg[(kind, host, where)][:90]}'))
        for (host, nbr), (downs, ups, last, last_ts, times) in self.neighbors.items():
            if downs:
                flaps = _max_in_window(sorted(times), rules.flap_window)
                state = 'currently down' if last == 'neighbor_down' else 'recovered'
                F.append(('routing', 'error', f'{host} → {nbr}',
                          f'routing neighbor down {downs}× ({state})'
                          + (f', flapping ({flaps} within {_fmt_dur(rules.flap_window)})'
                             if flaps >= 2 else '')))
        for src, times in self.login_src.items():
            times.sort()
            n = _max_in_window(times, rules.brute_window)
            if n >= rules.brute_threshold:
                F.append(('brute', 'error', src, f'{n} login failures within '
                          f'{_fmt_dur(rules.brute_window)} ({len(times)} total)'))
        for src, n, ev in self.login_ok_after:
            F.append(('brute', 'error', src, f'successful login'
                      + (f' as {ev.fields["user"]}' if 'user' in ev.fields else '')
                      + f' after {n} failures — check this account'))
        labels = {'vpn_down': ('vpn', 'error', 'VPN tunnel down'),
                  'service_down': ('service', 'error', 'server/service unreachable'),
                  'ap_down': ('ap', 'error', 'access point down/disconnected'),
                  'failover': ('failover', 'warning', 'failover / redundancy change'),
                  'hw': ('hw', 'warning', 'hardware / environment'),
                  'reboot': ('reboot', 'warning', 'reboot / restart')}
        for (kind, subject), (n, last_ts, sample) in self.infra.items():
            if kind in labels:
                cat, sev, text = labels[kind]
                F.append((cat, sev, subject, f'{text}: {n}×' +
                          (f', last {_fmt_ts(last_ts)}' if last_ts else '') +
                          (f' — {sample[:70]}' if sample and kind in ('hw', 'service_down') else '')))

    def _firewall(self, rules):
        for src, st in self.fw.sources.items():
            if st.max_ports >= rules.scan_ports:
                self.findings.append(('scan', 'warning', src,
                                      f'possible port scan: {st.max_ports} distinct ports denied '
                                      f'within {_fmt_dur(rules.scan_window)}'))
            if st.max_dsts >= rules.scan_hosts:
                self.findings.append(('scan', 'warning', src,
                                      f'possible host sweep: {st.max_dsts} distinct hosts denied '
                                      f'within {_fmt_dur(rules.scan_window)}'))
        for sig, n in self.threats.most_common(rules.top):
            self.findings.append(('threat', 'error', sig[:70], f'{n} threat event'
                                  f'{"s" * (n != 1)}'))

    @staticmethod
    def _client_findings(cs, rules):
        cs.loops = find_failure_loops(cs.events, rules, cs.mac)
        for lp in cs.loops:
            span = f' in {_fmt_dur(lp.end - lp.start)}' if lp.timed else ' in a row'
            cs.findings.append(('loop', f'failure loop: {lp.count} failures{span}'))

        if cs.legacy:
            names = ', '.join(cs.legacy)
            n     = sum(cs.legacy.values())
            fail  = f', {cs.legacy_fail} failed' if cs.legacy_fail else ''
            cs.findings.append(('legacy', f'legacy SSID {names} ({n} event{"s" * (n != 1)}{fail})'))

        by_norm = {}
        for u in cs.users:
            by_norm.setdefault(norm_user(u), set()).add(u)
        for forms in by_norm.values():
            if len(forms) > 1:
                cs.findings.append(('identity', 'username format varies: ' +
                                    ' vs '.join(sorted(forms, key=len))))
        if len(by_norm) > 1:
            cs.findings.append(('identity', 'multiple users on one device: ' +
                                ', '.join(sorted(by_norm))))

        roams = [e.ts for e in cs.events if e.kind == 'roam' and e.ts is not None]
        if roams and _max_in_window(roams, rules.roam_window) >= rules.roam_threshold:
            n = _max_in_window(roams, rules.roam_window)
            cs.findings.append(('roam', f'rapid roaming: {n} roams within '
                                        f'{_fmt_dur(rules.roam_window)}'))

        if cs.low_rssi:
            cs.findings.append(('rssi', f'low RSSI on {cs.low_rssi} event'
                                        f'{"s" * (cs.low_rssi != 1)} (min {cs.min_rssi} dBm)'))

    @staticmethod
    def _flag_hotspots(sites, rules):
        """Flag sites whose failure rate is well above the overall rate.
        Returns the overall (baseline) failure rate."""
        sites    = list(sites)
        failures = sum(s.failures for s in sites)
        attempts = failures + sum(s.successes for s in sites)
        baseline = failures / attempts if attempts else 0.0
        limit    = min(max(baseline * rules.hotspot_factor, 0.2), 0.9)
        for s in sites:
            s.flagged = s.failures >= rules.hotspot_min_failures and s.rate >= limit
        return baseline

    def clients_matching(self, query):
        """Client MACs for a MAC (any notation) or a username (any format)."""
        mac = norm_mac(query)
        if mac:
            return {mac}
        n = norm_user(query)
        us = self.users.get(n)
        return set(us.macs) if us else set()


