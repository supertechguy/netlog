def _summary_network(out, rep, s, H, rules, top):
    links = sorted((l for l in rep.links.values() if l.downs or l.err_disable),
                   key=lambda l: (-l.flapping, -l.err_disable, -len(l.downs), l.host, l.iface))
    if links:
        out += H('Interfaces with link-down events')
        rows = [['', 'Device', 'Interface', 'Downs', 'Ups', 'Err-dis', 'Now', 'Last change']]
        for l in links[:top]:
            flag = ('⚠', '1;31') if (l.flapping or l.err_disable) else ''
            rows.append([flag, l.host, (l.iface, '1;31' if l.flapping else None),
                         str(len(l.downs)), str(l.ups),
                         (str(l.err_disable), '1;31') if l.err_disable else '0',
                         (l.state or '?', '1;31' if l.state == 'down' else ANSI_EV_ALLOW),
                         _fmt_ts(l.last_ts)])
        out += _table(rows, s, 'lllrrrll')
        if len(links) > top:
            out.append(f'  … and {len(links) - top} more')
        if any(l.flapping for l in links):
            out.append(s(f'  ⚠ = flapping ({rules.flap_threshold}+ downs within '
                         f'{_fmt_dur(rules.flap_window)}) or err-disabled', '2;37'))
    if rep.neighbors:
        out += H('Routing neighbors')
        rows = [['Device', 'Neighbor', 'Downs', 'Ups', 'State', 'Last change']]
        for (host, nbr), (downs, ups, last, last_ts, _t) in sorted(
                rep.neighbors.items(), key=lambda kv: (-kv[1][0], kv[0]))[:top]:
            down = last == 'neighbor_down'
            rows.append([host, nbr, (str(downs), '1;31' if downs else None), str(ups),
                         ('down', '1;31') if down else ('up', ANSI_EV_ALLOW), _fmt_ts(last_ts)])
        out += _table(rows, s, 'llrrll')
    if rep.l2:
        out += H('Layer-2 events (loops, STP, security, errors, PoE)')
        rows = [['Type', 'Device', 'Where', 'Count', 'Last message']]
        names = {'loop': 'loop/MAC flap', 'err_disable': 'err-disable', 'stp': 'STP',
                 'violation': 'security', 'port_error': 'port errors', 'poe': 'PoE'}
        order = {'loop': 0, 'err_disable': 1, 'violation': 2, 'stp': 3, 'port_error': 4, 'poe': 5}
        for (kind, host, where), n in sorted(rep.l2.items(),
                                             key=lambda kv: (order[kv[0][0]], -kv[1]))[:top]:
            code = '1;31' if kind in ('loop', 'err_disable') else '1;33'
            rows.append([(names[kind], code), host, where or '-', str(n),
                         rep.l2_msg[(kind, host, where)][:60]])
        out += _table(rows, s, 'lllrl')


