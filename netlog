def _data_dir():
    """Where persistent state (OUI db, color map, config, GeoIP db) lives.

    A dev checkout (has .git next to the script) keeps state alongside the
    script, matching prior behavior. An installed copy (no .git — e.g. one
    placed in ~/.local/bin or /usr/local/bin by install.sh) uses the XDG
    data dir instead, since the install location may not be writable and
    is shared by anyone who installs the script.
    """
    override = os.environ.get('NETLOG_DATA_DIR')
    if override:
        return Path(override).expanduser()
    if (SCRIPT_DIR / '.git').exists():
        return SCRIPT_DIR
    xdg = os.environ.get('XDG_DATA_HOME')
    base = Path(xdg).expanduser() if xdg else Path.home() / '.local' / 'share'
    return base / 'netlog'


