def _event_type(text):
    """Return (glyph, ansi, pair, bold) for the line's event category, or None.

    Structured key=value events (e.g. clientJoinFailure clientMac=...) are
    classified by the analysis rules first; everything else falls back to
    the keyword table."""
    st = _structured_glyph(text)
    if st:
        return st
    for pat, glyph, ansi, pair, bold in _EV_TABLE:
        if pat.search(text):
            return glyph, ansi, pair, bold
    return None

