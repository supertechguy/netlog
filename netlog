# Aruba AOS-S / HP ProCurve:  00076 ports: port 1 is now off-line
_PROCURVE_SUBSYS = (r'ports|mgr|auth|FFI|stp|mstp|loop-protect|lldp|dot1x|mac-auth|macauth|'
                    r'web-auth|poe|chassis|system|vlan|ip|SNTP|snmp|lacp|dhcp-snoop|'
                    r'dhcp-snooping|arp-protect|dca|port-security|trunk|ssl|sshd|telnet|'
                    r'update|tftp|igmp|rate-limit|udld|ntp|radius|tacacs|cdp|ports-security')
_PROCURVE_RE = re.compile(
    r'(?:^|\s)(?:([IWMED]) \d\d/\d\d/\d\d \d\d:\d\d:\d\d )?(\d{5}) (' + _PROCURVE_SUBSYS +
    r'):\s+(.*)$')


def _p_procurve(line):
    m = _PROCURVE_RE.search(line)
    if not m:
        return None
    letter, code, sub, msg = m.groups()
    kind = classify_text(sub.upper(), msg)
    if sub == 'auth' and re.search(r'invalid|fail', msg, re.I):
        kind = 'login_fail'
    f = _common_fields(msg, kind)
    vsev = {'I': 6, 'W': 4, 'M': 2, 'E': 3, 'D': 7}.get(letter) if letter else None
    f.update(name=f'{sub} {code}', kind=kind, vsev=vsev, msg=msg)
    return f


