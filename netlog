class Rules:
    """Thresholds for the diagnostic rules (all overridable from the CLI)."""
    def __init__(self, loop_threshold=3, loop_window=300,
                 legacy_ssid=r'[-_](?:old|legacy)$', low_rssi=-75,
                 roam_threshold=3, roam_window=60,
                 hotspot_min_failures=3, hotspot_factor=2.0, top=10,
                 flap_threshold=3, flap_window=600, brute_threshold=5, brute_window=300,
                 scan_ports=15, scan_hosts=15, scan_window=300,
                 spray_accounts=5, spray_sources=5,
                 spike_min=20, spike_factor=5.0, spike_window=300,
                 web_scan=30, mass_change=100):
        self.loop_threshold       = loop_threshold
        self.loop_window          = loop_window
        self.legacy_ssid          = legacy_ssid
        self.legacy_re            = re.compile(legacy_ssid, re.I)
        self.low_rssi             = low_rssi
        self.roam_threshold       = roam_threshold
        self.roam_window          = roam_window
        self.hotspot_min_failures = hotspot_min_failures
        self.hotspot_factor       = hotspot_factor
        self.top                  = top
        self.flap_threshold       = flap_threshold     # link downs on one port...
        self.flap_window          = flap_window        # ...within this many seconds
        self.brute_threshold      = brute_threshold    # login failures from one source...
        self.brute_window         = brute_window
        self.scan_ports           = scan_ports         # distinct denied ports from one source...
        self.scan_hosts           = scan_hosts         # ...or distinct denied hosts...
        self.scan_window          = scan_window        # ...within one window
        self.spray_accounts       = spray_accounts     # distinct accounts failed from one source
        self.spray_sources        = spray_sources      # distinct sources failing one account
        self.spike_min            = spike_min          # errors+warnings in one bucket...
        self.spike_factor         = spike_factor       # ...and this many times the median
        self.spike_window         = spike_window       # bucket size in seconds
        self.web_scan             = web_scan           # distinct not-found URLs from one client
        self.mass_change          = mass_change        # file changes by one user in 5 minutes


RULES = Rules()


_RSSI_RE = re.compile(r'\s*(-?\d+)')


def rssi_value(fields):
    v = fields.get('rssi')
    return _rssi_int(v) if v else None


@functools.lru_cache(maxsize=1024)
def _rssi_int(text):
    m = _RSSI_RE.match(text)
    return int(m.group(1)) if m else None


def event_findings(p, rules=None):
    """Per-event (stateless) warnings: legacy SSID and low RSSI."""
    rules = rules or RULES
    out   = []
    ssid  = p.fields.get('ssid')
    if ssid and rules.legacy_re.search(ssid):
        out.append(f'legacy SSID {ssid}')
    rssi = rssi_value(p.fields)
    if rssi is not None and rssi < 0 and rssi < rules.low_rssi:
        out.append(f'low RSSI {rssi} dBm')
    return out


def _threat_tier(v):
    """Vendor threat severity (critical/high/medium/low, Meraki priority 1-3,
    Junos MAJOR/MINOR) → tier, or None."""
    v = (v or '').strip().lower()
    if v in ('critical', 'high', 'major', 'very-high', '1', 'emergency', 'alert'):
        return 'error'
    if v in ('medium', 'minor', 'warning', '2'):
        return 'warning'
    if v in ('low', 'informational', 'info', 'information', '3', '4', 'notice'):
        return 'info'
    return None


def event_severity(p, rules=None, findings=None):
    """'error' | 'warning' | 'success' | 'info' for a ParsedEvent.

    The event kind decides (a link-down is a warning however the device
    rates it); for hardware, STP, PoE and similar kinds the device's own
    syslog level decides; threats use the vendor's threat severity; events
    of unknown kind fall back to the syslog level.
    """
    kind = p.kind
    if kind == 'failure':
        return 'error'
    if kind == 'threat':
        return _threat_tier(p.fields.get('threat_sev')) or vendor_sev_tier(p.vsev) or 'error'
    if kind in _VENDOR_SEV_KINDS and p.vsev is not None:
        return vendor_sev_tier(p.vsev)
    base = KIND_SEVERITY.get(kind) if kind else None
    if base in (None, 'info', 'success') and \
            (findings if findings is not None else event_findings(p, rules)):
        return 'warning'
    if base:
        return base
    return vendor_sev_tier(p.vsev) or 'info'


_STRUCT_GLYPH = {
    'error':      ('✗ ', ANSI_EV_DENY,  _P_EV_DENY,  True),
    'warning':    ('! ', ANSI_EV_ERROR, _P_EV_ERROR, True),
    'success':    ('✓ ', ANSI_EV_ALLOW, _P_EV_ALLOW, True),
    'roam':       ('↔ ', ANSI_EV_START, _P_EV_START, False),
    'disconnect': ('↓ ', ANSI_EV_END,   _P_EV_END,   False),
}
# Kind-specific glyphs, used unless the event is an error.
_KIND_GLYPH = {
    'deny':       ('✗ ', ANSI_EV_DENY,  _P_EV_DENY,  True),
    'allow':      ('✓ ', ANSI_EV_ALLOW, _P_EV_ALLOW, True),
    'roam':       ('↔ ', ANSI_EV_START, _P_EV_START, False),
    'disconnect': ('↓ ', ANSI_EV_END,   _P_EV_END,   False),
    'logout':     ('↓ ', ANSI_EV_END,   _P_EV_END,   False),
    'link_down':  ('↓ ', ANSI_EV_ERROR, _P_EV_ERROR, True),
    'link_up':    ('↑ ', ANSI_EV_ALLOW, _P_EV_ALLOW, False),
    'session':    ('↑ ', ANSI_EV_START, _P_EV_START, False),
}
_SESSION_END = re.compile(r'teardown|close|end|deny|drop', re.I)


def _glyph_for(kind, severity, name=''):
    if severity == 'error':
        return _STRUCT_GLYPH['error']
    if kind == 'session' and _SESSION_END.search(name or ''):
        return _KIND_GLYPH['disconnect']
    g = _KIND_GLYPH.get(kind)
    if g:
        return g
    return _STRUCT_GLYPH.get(severity) if severity in ('warning', 'success') else None


def _structured_glyph(text):
    p = parse_event(text)
    if p is None:
        return None
    return _glyph_for(p.kind, event_severity(p), p.name)


def failure_label(name, fields):
    """Name to report a failure under: the event name, plus the status when
    the name alone doesn't say it failed (clientAuthorization result=failure)."""
    name = name or '(unnamed)'
    st   = fields.get('status')
    if st and not _FAIL_WORD.search(name):
        return f'{name} ({st})'
    return name


class LogEvent:
    """One structured event (or, with kind None and no fields, a plain line
    kept for --client context)."""
    __slots__ = ('seq', 'ts', 'eff', 'name', 'kind', 'severity', 'fields', 'findings', 'raw',
                 'fmt')

    def __init__(self, seq, ts, name, kind, severity, fields, findings, raw=None, fmt='kv'):
        self.seq, self.ts, self.eff = seq, ts, ts
        self.name, self.kind, self.severity = name, kind, severity
        self.fields, self.findings, self.raw = fields, findings, raw
        self.fmt = fmt

    @property
    def host(self):
        return self.fields.get('host')

    @property
    def client(self):
        return self.fields.get('client_mac')

    @property
    def ap(self):
        return self.fields.get('ap_name') or self.fields.get('ap_mac')

    @property
    def label(self):
        return failure_label(self.name, self.fields) if self.kind == 'failure' \
            else (self.name or '(event)')


