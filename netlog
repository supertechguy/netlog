def _geoip_fetch(account_id, license_key):
    import io
    base_url = "https://download.maxmind.com/geoip/databases/GeoLite2-City/download?suffix=tar.gz"
    sha_url  = base_url + ".sha256"
    mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    mgr.add_password(None, "https://download.maxmind.com/", account_id, license_key)
    opener = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(mgr))
    print("Downloading GeoLite2-City.mmdb...", file=sys.stderr)
    with opener.open(base_url, timeout=60) as r:
        data = r.read()
    with opener.open(sha_url, timeout=15) as r:
        expected_sha = r.read().decode().split()[0].strip()
    actual_sha = hashlib.sha256(data).hexdigest()
    if actual_sha != expected_sha:
        raise ValueError(f"SHA256 mismatch (got {actual_sha}, expected {expected_sha})")
    print("SHA256 verified.", file=sys.stderr)
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
        for member in tar.getmembers():
            if member.name.endswith("GeoLite2-City.mmdb"):
                GEOIP_DEST.write_bytes(tar.extractfile(member).read())
                print(f"Saved to {GEOIP_DEST}", file=sys.stderr)
                return True
    raise FileNotFoundError("GeoLite2-City.mmdb not found inside the downloaded archive.")


def update_geoip(cfg, prompt_if_missing=False):
    """Download or update GeoLite2-City.mmdb using stored or prompted credentials.
    Returns True if the file is ready, False otherwise."""
    import datetime
    today = datetime.date.today().isoformat()

    account_id  = cfg.get("maxmind_account_id", "")
    license_key = cfg.get("maxmind_license_key", "")

    if not account_id or not license_key:
        if not prompt_if_missing or cfg.get("geoip_setup_declined"):
            return GEOIP_DEST.exists()

        print("GeoIP lookup can annotate IP addresses with city/country using a free",
              file=sys.stderr)
        print("MaxMind GeoLite2 account (requires an Account ID + license key).",
              file=sys.stderr)
        try:
            reply = input("Set up MaxMind GeoIP now? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            reply = 'n'

        if reply not in ('y', 'yes'):
            cfg["geoip_setup_declined"] = True
            save_config(cfg)
            print("Skipping GeoIP setup. Run 'netlog --setup-geoip' to configure it later.",
                  file=sys.stderr)
            return False

        print("Sign up for a free account at:", file=sys.stderr)
        print("  https://www.maxmind.com/en/geolite2/signup", file=sys.stderr)
        print("Then get your Account ID and generate a license key at:", file=sys.stderr)
        print("  https://www.maxmind.com/en/accounts/current/license-key", file=sys.stderr)
        try:
            account_id  = input("MaxMind Account ID: ").strip()
            license_key = input("MaxMind License Key: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nSkipping GeoIP download.", file=sys.stderr)
            return False
        if not account_id or not license_key:
            print("No credentials provided, skipping GeoIP download.", file=sys.stderr)
            return False
        cfg["maxmind_account_id"]  = account_id
        cfg["maxmind_license_key"] = license_key
        cfg.pop("geoip_setup_declined", None)

    if cfg.get("last_geoip_check") == today and GEOIP_DEST.exists():
        return True

    try:
        if _geoip_fetch(account_id, license_key):
            cfg["last_geoip_check"] = today
            save_config(cfg)
            return True
    except Exception as e:
        print(f"Failed to download GeoLite2-City.mmdb: {e}", file=sys.stderr)
    return GEOIP_DEST.exists()


def setup_geoip_cmd(cfg):
    """Handler for `netlog --setup-geoip`: force the interactive credential
    prompt even if setup was previously declined or already configured."""
    if not HAS_GEOIP:
        sys.exit("GeoIP: install the 'maxminddb' package first (pip install maxminddb)")
    cfg.pop("maxmind_account_id", None)
    cfg.pop("maxmind_license_key", None)
    cfg.pop("geoip_setup_declined", None)
    ok = update_geoip(cfg, prompt_if_missing=True)
    if ok:
        print(f"GeoIP ready: {GEOIP_DEST}", file=sys.stderr)
    sys.exit(0 if ok else 1)


def load_geoip(cfg, allow_prompt=True):
    if not HAS_GEOIP:
        return None
    needs_download = not any(p.exists() for p in GEOIP_PATHS)
    update_geoip(cfg, prompt_if_missing=needs_download and allow_prompt)
    for path in GEOIP_PATHS:
        if path.exists():
            try:
                return maxminddb.open_database(str(path))
            except Exception:
                pass
    return None


def geo_lookup(ip_str):
    if _GEO_READER is None:
        return None
    if ip_str in _GEO_CACHE:
        return _GEO_CACHE[ip_str]
    try:
        addr = ipaddress.ip_address(ip_str)
        if not addr.is_global:
            _GEO_CACHE[ip_str] = None
            return None
        rec = _GEO_READER.get(ip_str)
        if rec:
            city  = (rec.get('city') or {}).get('names', {}).get('en', '')
            subs  = rec.get('subdivisions') or []
            state = (subs[0] if subs else {}).get('iso_code', '')
            country = (rec.get('country') or {}).get('iso_code', '')
            result  = ', '.join(filter(None, [city, state, country])) or None
        else:
            result = None
    except Exception:
        result = None
    _GEO_CACHE[ip_str] = result
    return result


# ── Segment builder (shared by ANSI + curses) ─────────────────────────────────

def _a(text, code):
    return f'\033[{code}m{text}\033[0m'


_ANSI_TOKEN = re.compile(r'(\x1b\[[0-9;]*[A-Za-z])|(\t)|([^\S\t]+)|([^\s\x1b]+)', re.S)


def _char_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1


def fit_ansi(text, width, wrap=True, indent=2 + 4):
    """Fit ANSI-colored output to a terminal `width`. With wrap, long lines
    continue on following rows indented by `indent` columns (the 2-column
    event glyph plus WRAP_INDENT); without, they are cut at the edge. Colors
    are carried over onto continuation rows. Handles multi-line text."""
    if width < indent + 10:
        return text
    return '\n'.join(_fit_ansi_line(l, width, wrap, indent) for l in text.split('\n'))


def _fit_ansi_line(line, width, wrap, indent):
    if len(line) <= width and '\t' not in line:
        return line                  # visible width can't exceed the length
    out, col, active = [], 0, ''
    full = width - indent

    def newline():
        nonlocal col
        out.append('\x1b[0m\n' + ' ' * indent + active if active else '\n' + ' ' * indent)
        col = indent

    for m in _ANSI_TOKEN.finditer(line):
        seq, tab, space, word = m.groups()
        if seq:
            out.append(seq)
            if seq.endswith('m'):
                active = '' if seq in ('\x1b[0m', '\x1b[m') else active + seq
            continue
        if tab or space:
            n = 8 - col % 8 if tab else len(space)
            if col + n > width:
                if not wrap:
                    out.append(' ' * (width - col))
                    break
                newline()                      # spaces at a break are dropped
            else:
                out.append(' ' * n)
                col += n
            continue
        w = sum(_char_width(ch) for ch in word)
        if col + w <= width:
            out.append(word)
            col += w
            continue
        if not wrap:
            for ch in word:
                cw = _char_width(ch)
                if col + cw > width:
                    break
                out.append(ch)
                col += cw
            break
        if w <= full and col > indent:
            newline()
            out.append(word)
            col += w
            continue
        for ch in word:                        # longer than a row: split it
            cw = _char_width(ch)
            if col + cw > width:
                newline()
            out.append(ch)
            col += cw
    if active:
        out.append('\x1b[0m')
    return ''.join(out)


class _Output:
    """Writes rendered lines to stdout, wrapping or cutting them to the
    terminal width when stdout is a terminal (left untouched otherwise)."""

    def __init__(self, prefs):
        self.prefs = prefs
        self.tty   = sys.stdout.isatty()

    def __call__(self, text, flush=False):
        if self.tty:
            text = fit_ansi(text, shutil.get_terminal_size().columns,
                            bool(self.prefs.get('wrap', True)))
        print(text, flush=flush)

def _collect_segments(line, vendors, mac_map, ctr, search_term=None, search_is_regex=False):
    """
    Returns sorted list of (src_start, src_end, display_text, ansi_code, pair_num, bold).
    No two segments overlap; priority order: MAC > IP4 > IP6 > SEV > PORT > IFACE.
    Search hits are drawn over all of these: a token that overlaps a hit is
    recolored as a hit (keeping its vendor/service/geo annotation), and the
    rest of the hit gets its own segments.
    pair_num / bold are used by the curses renderer; curses.color_pair() is NOT called here
    so this function is safe to use before curses.initscr().
    """
    segs    = []
    covered = []

    def overlaps(s, e):
        return any(cs < e and s < ce for cs, ce in covered)

    def add(s, e, disp, ansi, pair, bold=True, geo=''):
        if not overlaps(s, e):
            segs.append((s, e, disp, ansi, pair, bold, geo))
            covered.append((s, e))

    # MACs
    for m in MAC_RE.finditer(line):
        norm   = m.group().upper().replace(':', '').replace('-', '')
        vendor = vendors.get(norm[:6], 'Unknown')
        idx    = mac_color(norm, mac_map, ctr)
        add(m.start(), m.end(), f'{m.group()} ({vendor})',
            ANSI_MAC[idx], _P_MAC + idx, _MAC_BOLD[idx])

    # IPv4
    for m in IP4_RE.finditer(line):
        geo = geo_lookup(m.group())
        add(m.start(), m.end(), m.group(), ANSI_IP4, _P_IP4, geo=geo or '')

    # IPv6
    for m in IP6_RE.finditer(line):
        geo = geo_lookup(m.group())
        add(m.start(), m.end(), m.group(), ANSI_IP6, _P_IP6, geo=geo or '')

    # Severity
    for m in SEV_RE.finditer(line):
        lvl = SEV_LEVEL.get(m.group().upper(), -1)
        if lvl >= 0:
            add(m.start(), m.end(), m.group(), ANSI_SEV[lvl],
                _P_SEV + lvl, lvl <= 4)

    # Ports
    for m in PORT_RE.finditer(line):
        if m.group(1) is not None:
            num = int(m.group(1))
        elif m.group(2) is not None:
            num = int(m.group(2))
            # Skip timestamp-like :NN where NN<=59 and preceded by a digit
            if num <= 59 and m.start() > 0 and line[m.start() - 1].isdigit():
                continue
        else:
            continue
        if 1 <= num <= 65535:
            svc  = WELL_KNOWN_PORTS.get(num)
            disp = f'{m.group()} ({svc})' if svc else m.group()
            add(m.start(), m.end(), disp, ANSI_PORT, _P_PORT, False)

    # Interfaces
    for m in IFACE_RE.finditer(line):
        add(m.start(), m.end(), m.group(), ANSI_IFACE, _P_IFACE, False)

    if search_term:
        spans = search_spans(line, search_term, search_is_regex)
        if spans:
            for i, (s, e, disp, _ansi, _pair, _bold, geo) in enumerate(segs):
                if any(hs < e and s < he for hs, he in spans):
                    segs[i] = (s, e, disp, ANSI_SEARCH, _P_SRCH, True, geo)
            for hs, he in spans:
                pos = hs
                for cs, ce in sorted(covered):
                    if ce <= pos or cs >= he:
                        continue
                    if cs > pos:
                        add(pos, cs, line[pos:cs], ANSI_SEARCH, _P_SRCH, True)
                    pos = max(pos, ce)
                if pos < he:
                    add(pos, he, line[pos:he], ANSI_SEARCH, _P_SRCH, True)

    segs.sort(key=lambda s: s[0])
    return segs


def search_spans(line, term, regex=False):
    """(start, end) of every non-empty, case-insensitive match of term in line."""
    try:
        pat = _search_re(term, regex)
    except re.error:
        return []
    return [(m.start(), m.end()) for m in pat.finditer(line) if m.end() > m.start()]


@functools.lru_cache(maxsize=32)
def _search_re(term, regex):
    return re.compile(term if regex else re.escape(term), re.I)

# ── ANSI rendering (piped / tail) ─────────────────────────────────────────────

def highlight_ansi(line, vendors, mac_map, ctr, search_term=None, search_is_regex=False):
    ev   = _event_type(line)
    segs = _collect_segments(line, vendors, mac_map, ctr, search_term, search_is_regex)
    out  = [_a(ev[0], ev[1]) if ev else '  ']
    prev = 0
    for s, e, disp, ansi, _pair, _bold, geo in segs:
        out.append(line[prev:s])
        out.append(_a(disp, ansi))
        if geo:
            out.append(_a(f' ({geo})', ANSI_GEO))
        prev = e
    out.append(line[prev:])
    return ''.join(out)

# ── Search ────────────────────────────────────────────────────────────────────

def find_matches(view, term, regex=False):
    out = []
    for i, (text, _) in enumerate(view):
        try:
            hit = bool(re.search(term, text, re.I)) if regex else term.lower() in text.lower()
            if hit:
                out.append(i)
        except re.error:
            pass
    return out


def next_match(view, term, regex, start, step=1, matches=None):
    """Index of the first line from `start` (inclusive) in direction `step`
    that contains `term`, wrapping round the end. Uses the precomputed
    `matches` list when given, otherwise scans `view` (large files).
    Returns (index, wrapped) or (None, False)."""
    n = len(view)
    if not n or not term:
        return None, False
    start %= n
    if matches is not None:
        if not matches:
            return None, False
        if step > 0:
            i = bisect.bisect_left(matches, start)
            return (matches[i], False) if i < len(matches) else (matches[0], True)
        i = bisect.bisect_right(matches, start) - 1
        return (matches[i], False) if i >= 0 else (matches[-1], True)
    try:
        pat = _search_re(term, regex)
    except re.error:
        return None, False
    for k in range(n):
        i = (start + k * step) % n
        if pat.search(view[i][0]):
            return i, (i < start) if step > 0 else (i > start)
    return None, False

# ── Dedup / view helpers ──────────────────────────────────────────────────────

def dedup_lines(lines):
    if not lines:
        return []
    result = []
    cur, cnt = lines[0], 1
    for line in lines[1:]:
        if line == cur:
            cnt += 1
        else:
            result.append((cur, cnt))
            cur, cnt = line, 1
    result.append((cur, cnt))
    return result

def as_view(lines):
    return [(l, 1) for l in lines]

# ── Column helpers ────────────────────────────────────────────────────────────

def _file_base(path):
    """Base name before the first dot: firewall.log.10.gz → firewall"""
    name = Path(path).name
    dot  = name.find('.')
    return name[:dot] if dot != -1 else name

def _strip_cols(text, n):
    """Remove the first n columns (delimited by runs of space/tab/comma)."""
    if n <= 0:
        return text
    pos = 0
    L   = len(text)
    for _ in range(n):
        while pos < L and text[pos] in ' \t,':
            pos += 1
        if pos >= L:
            return ''
        while pos < L and text[pos] not in ' \t,':
            pos += 1
    while pos < L and text[pos] in ' \t,':
        pos += 1
    return text[pos:]

# ── Large-file buffered access ────────────────────────────────────────────────

class LargeFile:
    """Wraps a huge file with a mmap + byte-offset index so only the visible
    window is ever held in memory.  Index cost: 8 bytes per line."""

    def __init__(self, path):
        self._f   = open(path, 'rb')
        self._mm  = mmap.mmap(self._f.fileno(), 0, access=mmap.ACCESS_READ)
        size      = len(self._mm)
        offs      = array.array('Q', [0])
        pos       = 0
        while pos < size:
            nl = self._mm.find(b'\n', pos)
            if nl == -1:
                break
            offs.append(nl + 1)
            pos = nl + 1
        # Drop the phantom empty entry produced by a trailing newline
        if offs and offs[-1] >= size:
            offs.pop()
        self._offs = offs

    def __len__(self):
        return len(self._offs)

    def _line(self, i):
        start = self._offs[i]
        end   = self._offs[i + 1] if i + 1 < len(self._offs) else len(self._mm)
        return self._mm[start:end].rstrip(b'\r\n').decode('utf-8', errors='replace')

    def __getitem__(self, key):
        n = len(self._offs)
        if isinstance(key, slice):
            return [self._line(i) for i in range(*key.indices(n))]
        if key < 0:
            key += n
        return self._line(key)

    def __iter__(self):
        for i in range(len(self._offs)):
            yield self._line(i)

    def close(self):
        self._mm.close()
        self._f.close()


class LargeFileView:
    """Adapts a LargeFile to the (text, count) tuple interface used by
    _render and collect_stats, reading only requested lines from disk.
    With `idx` (an array of line numbers) it shows only those lines."""

    def __init__(self, lf, idx=None):
        self._lf  = lf
        self._idx = idx

    def __len__(self):
        return len(self._lf) if self._idx is None else len(self._idx)

    def __getitem__(self, key):
        if self._idx is None:
            if isinstance(key, slice):
                return [(t, 1) for t in self._lf[key]]
            return (self._lf[key], 1)
        if isinstance(key, slice):
            return [(self._lf[i], 1) for i in self._idx[key]]
        return (self._lf[self._idx[key]], 1)

    def __iter__(self):
        if self._idx is None:
            for text in self._lf:
                yield (text, 1)
        else:
            for i in self._idx:
                yield (self._lf[i], 1)


def make_line_filter(spec):
    """Predicate for a TUI filter. Plain text is case-insensitive and
    `a|b|c` matches any of the terms; `r:REGEX` is a regex; a leading `!`
    keeps the lines that do NOT match. Raises ValueError / re.error."""
    neg = spec.startswith('!')
    if neg:
        spec = spec[1:]
    if spec.startswith('r:'):
        pat = re.compile(spec[2:], re.I)
        def test(line):
            return pat.search(line) is not None
    else:
        terms = [t.strip().lower() for t in spec.split('|') if t.strip()]
        if not terms:
            raise ValueError('nothing to match')
        if len(terms) == 1:
            t0 = terms[0]
            def test(line):
                return t0 in line.lower()
        else:
            def test(line):
                low = line.lower()
                return any(t in low for t in terms)
    if neg:
        return lambda line: not test(line)
    return test


def make_grep(specs):
    """Load-time filter from one or more --grep specs (same syntax as the TUI
    filter); a line must match every spec. None when there are no specs."""
    preds = [make_line_filter(s) for s in specs or ()]
    if not preds:
        return None
    if len(preds) == 1:
        return preds[0]
    return lambda line: all(p(line) for p in preds)


def grep_label(specs):
    return ' & '.join(specs or ())


# ── Statistics ────────────────────────────────────────────────────────────────

def collect_stats(view, vendors, progress_cb=None):
    ip4, ip6, macs, ports, sevs = Counter(), Counter(), Counter(), Counter(), Counter()
    total = len(view)
    for i, (text, count) in enumerate(view):
        for m in MAC_RE.finditer(text):
            norm   = m.group().upper().replace(':', '').replace('-', '')
            vendor = vendors.get(norm[:6], 'Unknown')
            macs[f'{m.group()} ({vendor})'] += count
        for m in IP4_RE.finditer(text):
            ip4[m.group()] += count
        for m in IP6_RE.finditer(text):
            ip6[m.group()] += count
        for m in PORT_RE.finditer(text):
            num_str = next((g for g in m.groups() if g is not None), None)
            if num_str:
                num = int(num_str)
                if 1 <= num <= 65535:
                    svc  = WELL_KNOWN_PORTS.get(num, '')
                    key  = f'{num} ({svc})' if svc else str(num)
                    ports[key] += count
        for m in SEV_RE.finditer(text):
            sevs[m.group().upper()] += count
        if progress_cb and i % 200 == 0:
            progress_cb(i, total)
    return ip4, ip6, macs, ports, sevs

class StatsCancelled(Exception):
    pass


# Destination/service ports for statistics: named fields (source-port
# fields are left out) or a port straight after an IPv4 address.
_STAT_PORT_RE = re.compile(
    r'\b(?:dst_?port|dest_?port|d_?port|dpt|port)\s*[=: ]\s*"?(\d{1,5})\b'
    r'|[:/](\d{1,5})(?![\d.])', re.I)

# Program/tag after the syslog host: "dnsmasq[123]:", "kernel:", "%LINK-3-UPDOWN:".
_PROG_RE = re.compile(r'\s*%?([A-Za-z][\w./-]{0,39}?)(?:\[\d+\])?:(?:\s|$)')


def build_stats(view, vendors, progress_cb=None, color=True, label=''):
    """Statistics for a TUI view as a list of (ANSI-colored) text lines.

    One pass feeds the structured analyzer, whose summary adapts to the log
    types found (wireless, switching/routing, firewall, authentication,
    infrastructure), and also counts raw tokens: sending hosts, programs,
    IPs, MACs, ports and syslog severity words, which are useful for any log.
    `progress_cb(done, total)` may raise StatsCancelled."""
    an    = Analyzer(keep_raw=False)
    ip4, ip6, macs, ports, sevs = Counter(), Counter(), Counter(), Counter(), Counter()
    hosts, progs = Counter(), Counter()
    total = len(view)
    for i, (text, count) in enumerate(view):
        for _ in range(count):
            an.feed(text)
        m = _HDR_RE.match(text)
        if m:
            host = m.group(2)
            if host.endswith(':'):             # no host: "Mar 29 20:41:26 bsd: ..."
                tag = re.sub(r'\[\d+\]$', '', host[:-1]).lstrip('%')
                if tag:
                    progs[tag] += count
            elif not host.startswith(('%', '[', '<')):
                hosts[host] += count
                pm = _PROG_RE.match(text, m.end() - 1)
                if pm:
                    progs[pm.group(1)] += count
        taken, ip_ends = [], set()
        for mm in MAC_RE.finditer(text):
            norm = mm.group().upper().replace(':', '').replace('-', '')
            macs[f'{mm.group()} ({vendors.get(norm[:6], "Unknown")})'] += count
            taken.append(mm.span())
        for mm in IP4_RE.finditer(text):
            ip4[mm.group()] += count
            ip_ends.add(mm.end())
        if '::' in text or text.count(':') >= 7:      # cheap IPv6 pre-check
            for mm in IP6_RE.finditer(text):
                ip6[mm.group()] += count
                taken.append(mm.span())
        for mm in _STAT_PORT_RE.finditer(text):
            if mm.group(1) is not None:
                num = int(mm.group(1))           # dstport=, DPT=, "port 22", ...
            elif mm.start() in ip_ends:
                num = int(mm.group(2))           # 10.0.0.1:443 or 10.0.0.1/22
                if num >= 32768:
                    continue                     # ephemeral: almost always a source port
            else:
                continue                         # bare :NN (times, MAC pieces)
            if any(a < mm.end() and mm.start() < b for a, b in taken):
                continue
            if 1 <= num <= 65535:
                svc = WELL_KNOWN_PORTS.get(num, '')
                ports[f'{num} ({svc})' if svc else str(num)] += count
        for mm in SEV_RE.finditer(text):
            sevs[mm.group().upper()] += count
        if progress_cb and i % 500 == 0:
            progress_cb(i, total)

    rep  = Report(an)
    st   = _Style(color)
    top  = rep.rules.top
    out  = []
    if rep.parsed:
        out += format_summary(rep, vendors, color, label).split('\n')
    else:
        out += [st(f'netlog analytics{" — " + label if label else ""}', '1;36'),
                st('═' * 60, '2;37'),
                f'Lines: {total:,}   (no vendor or key=value events recognised; '
                '`netlog --formats` lists the supported formats)']

    def section(title, counter, n=top):
        if not counter:
            return
        out.extend(['', st(title, '1;37'), st('─' * len(title), '2;37')])
        rows = [[k, f'{c:,}'] for k, c in counter.most_common(n)]
        out.extend(_table(rows, st, 'lr'))

    if len(hosts) > 1 or (hosts and not rep.parsed):
        section('Top sending hosts', hosts)
    if progs:
        section('Top programs / message tags', progs)
    out += ['', st('▌ADDRESSES & PORTS (all lines)', '1;36')]
    section('Top IPv4 addresses', ip4)
    section('Top IPv6 addresses', ip6, min(top, 6))
    section('Top MAC addresses', macs)
    section('Top destination / service ports', ports)
    section('Syslog severity words', sevs, 8)
    return out


