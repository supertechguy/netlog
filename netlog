_INT_FIELDS = ('src_port', 'dst_port')


def _finish(fmt, d, line):
    """Turn a vendor parser's dict into a ParsedEvent."""
    hdr_sev, host = syslog_header(line)
    name = d.pop('name', '') or ''
    kind = d.pop('kind', None)
    vsev = d.pop('vsev', None)
    if vsev is None:
        vsev = hdr_sev
    when = d.pop('when', None)
    ts   = d.pop('ts', None)
    fields = {}
    intern = sys.intern
    for k, v in d.items():
        if v is None or v == '':
            continue
        v = str(v)
        if k in _MAC_FIELDS:
            v = norm_mac(v)
            if not v:
                continue
        fields[k] = intern(v) if len(v) < 64 else v
    if host and 'host' not in fields:
        fields['host'] = intern(host)
    if ts is None:
        ts = parse_timestamp(line, fields)
    if ts is None and when:
        ts = parse_timestamp(when)
    return ParsedEvent(intern(name[:80]), fields, kind, ts, fmt, vsev)


def _hint_ok(h, line):
    if h is None:
        return True
    if isinstance(h, tuple):
        for x in h:
            if x in line:
                return True
        return False
    return h.search(line) is not None      # compiled "gate" regex


def _parse_vendor(line):
    """Try the vendor formats whose cheap hint matches, in priority order
    (the format that matched the previous line first). Returns a
    ParsedEvent or None."""
    last = _LAST_FMT[0]
    if last is not None:
        d = _try_format(last, line)
        if d is not None:
            return d
    for i, subs, gate in _HINT_CHECKS:
        if i == last:
            continue
        if subs is not None:
            for x in subs:
                if x in line:
                    break
            else:
                continue
        elif gate is not None and gate(line) is None:
            continue
        d = _try_format(i, line, checked=True)
        if d is not None:
            return d
    return None


def _try_format(i, line, checked=False):
    fmt = FORMATS[i]
    if not checked and not _hint_ok(fmt.hint, line):
        return None
    try:
        d = fmt.parse(line)
    except (ValueError, IndexError, KeyError, AttributeError):
        d = None
    if not d:
        return None
    _LAST_FMT[0] = i
    return _finish(fmt.id, d, line)


# (index, substrings or None, gate regex .search or None) per format,
# precomputed so the per-line loop avoids isinstance checks and calls.
_HINT_CHECKS = [(i, f.hint if isinstance(f.hint, tuple) else None,
                 f.hint.search if f.hint is not None and not isinstance(f.hint, tuple)
                 else None)
                for i, f in enumerate(FORMATS)]


def _parse_event(line):
    """Vendor formats first, then the generic key=value parser."""
    return _parse_vendor(line) or _parse_generic(line)


def format_examples():
    """(format, line, expected kind, expected fields) for every documented example."""
    for fmt in FORMATS:
        for line, kind, fields in fmt.examples:
            yield fmt, line, kind, fields


def format_list(color=False):
    """Text for --formats."""
    s   = _Style(color)
    out = [s('Supported log formats', '1;36'), s('═' * 60, '2;37')]
    for fmt in FORMATS:
        out.append('')
        out.append(s(f'{fmt.label}', '1;37') + s(f'  [{fmt.id}]  {fmt.classes}', '2;37'))
        if fmt.note:
            out.append(textwrap.fill(fmt.note, 100, initial_indent='  ', subsequent_indent='  '))
        for line, kind, _ in fmt.examples[:2]:
            line = line.replace('\t', '\\t')
            out.append(s(f'  → {kind or "text":<12}', ANSI_EV_START) + s(line[:110] +
                                                                ('…' if len(line) > 110 else ''),
                                                                '2;37'))
    out.append('')
    out.append('Anything else with key=value fields (clientMac=, userName=, apName=, ssid=, '
               'srcip=, ...) is read by the generic parser.')
    return '\n'.join(out)


