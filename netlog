# AOS-S) last.
_ORDER = ['ruckus_sz', 'cef', 'leef', 'fortinet', 'paloalto', 'cisco_asa', 'os10', 'cisco',
          'sophos', 'sonicwall', 'checkpoint', 'ise', 'freeradius', 'meraki', 'aruba_os',
          'aruba_cx', 'junos', 'comware', 'filterlog', 'netfilter', 'unifi_sta', 'hostapd',
          'linux_auth', 'mikrotik', 'exos', 'icx', 'ruckus_zd', 'aruba_aoss']
FORMATS.sort(key=lambda f: _ORDER.index(f.id))
FORMAT_BY_ID = {f.id: f for f in FORMATS}
_GENERIC = LogFormat('kv', 'Generic', 'key=value', 'any', None, None, [])
FORMAT_BY_ID['kv'] = _GENERIC
_LAST_FMT = [None]


# Fields that must be normalized after a vendor parser runs.
_INT_FIELDS = ('src_port', 'dst_port')


def _finish(fmt, d, line):
    """Turn a vendor parser's dict into a ParsedEvent."""
    hdr_sev, host = syslog_header(line)
    name = d.pop('name', '') or ''
    kind = d.pop('kind', None)
    vsev = d.pop('vsev', None)
    if vsev is None:
        vsev = hdr_sev
    when = d.pop('when', None)
    fields = {}
    intern = sys.intern
    for k, v in d.items():
        if v is None or v == '':
            continue
        v = str(v)
        if k in _MAC_FIELDS:
            v = norm_mac(v)
            if not v:
                continue
        fields[k] = intern(v) if len(v) < 64 else v
    if host and 'host' not in fields:
        fields['host'] = intern(host)
    ts = parse_timestamp(line, fields)
    if ts is None and when:
        ts = parse_timestamp(when)
    return ParsedEvent(intern(name[:80]), fields, kind, ts, fmt, vsev)


def _hint_ok(h, line):
    if h is None:
        return True
    if isinstance(h, tuple):
        for x in h:
            if x in line:
                return True
        return False
    return h.search(line) is not None      # compiled "gate" regex


def _parse_vendor(line):
    """Try the vendor formats whose cheap hint matches, in priority order
    (the format that matched the previous line first). Returns a
    ParsedEvent or None."""
    last = _LAST_FMT[0]
    if last is not None:
        d = _try_format(last, line)
        if d is not None:
            return d
    for i, subs, gate in _HINT_CHECKS:
        if i == last:
            continue
        if subs is not None:
            for x in subs:
                if x in line:
                    break
            else:
                continue
        elif gate is not None and gate(line) is None:
            continue
        d = _try_format(i, line, checked=True)
        if d is not None:
            return d
    return None


def _try_format(i, line, checked=False):
    fmt = FORMATS[i]
    if not checked and not _hint_ok(fmt.hint, line):
        return None
    try:
        d = fmt.parse(line)
    except (ValueError, IndexError, KeyError, AttributeError):
        d = None
    if not d:
        return None
    _LAST_FMT[0] = i
    return _finish(fmt.id, d, line)


# (index, substrings or None, gate regex .search or None) per format,
# precomputed so the per-line loop avoids isinstance checks and calls.
_HINT_CHECKS = [(i, f.hint if isinstance(f.hint, tuple) else None,
                 f.hint.search if f.hint is not None and not isinstance(f.hint, tuple)
                 else None)
                for i, f in enumerate(FORMATS)]


def _parse_event(line):
    """Vendor formats first, then the generic key=value parser."""
    return _parse_vendor(line) or _parse_generic(line)


def format_examples():
    """(format, line, expected kind, expected fields) for every documented example."""
    for fmt in FORMATS:
        for line, kind, fields in fmt.examples:
            yield fmt, line, kind, fields


def format_list(color=False):
    """Text for --formats."""
    s   = _Style(color)
    out = [s('Supported log formats', '1;36'), s('═' * 60, '2;37')]
    for fmt in FORMATS:
        out.append('')
        out.append(s(f'{fmt.label}', '1;37') + s(f'  [{fmt.id}]  {fmt.classes}', '2;37'))
        if fmt.note:
            out.append(textwrap.fill(fmt.note, 100, initial_indent='  ', subsequent_indent='  '))
        for line, kind, _ in fmt.examples[:2]:
            line = line.replace('\t', '\\t')
            out.append(s(f'  → {kind:<12}', ANSI_EV_START) + s(line[:110] +
                                                                ('…' if len(line) > 110 else ''),
                                                                '2;37'))
    out.append('')
    out.append('Anything else with key=value fields (clientMac=, userName=, apName=, ssid=, '
               'srcip=, ...) is read by the generic parser.')
    return '\n'.join(out)


# Cached for the TUI, which re-classifies the same visible lines on every
# redraw. Batch analysis calls _parse_event directly: every line there is
# new, so a cache would only add overhead.
parse_event = functools.lru_cache(maxsize=8192)(_parse_event)


class Rules:
    """Thresholds for the diagnostic rules (all overridable from the CLI)."""
    def __init__(self, loop_threshold=3, loop_window=300,
                 legacy_ssid=r'[-_](?:old|legacy)$', low_rssi=-75,
                 roam_threshold=3, roam_window=60,
                 hotspot_min_failures=3, hotspot_factor=2.0, top=10,
                 flap_threshold=3, flap_window=600, brute_threshold=5, brute_window=300,
                 scan_ports=15, scan_hosts=15, scan_window=300):
        self.loop_threshold       = loop_threshold
        self.loop_window          = loop_window
        self.legacy_ssid          = legacy_ssid
        self.legacy_re            = re.compile(legacy_ssid, re.I)
        self.low_rssi             = low_rssi
        self.roam_threshold       = roam_threshold
        self.roam_window          = roam_window
        self.hotspot_min_failures = hotspot_min_failures
        self.hotspot_factor       = hotspot_factor
        self.top                  = top
        self.flap_threshold       = flap_threshold     # link downs on one port...
        self.flap_window          = flap_window        # ...within this many seconds
        self.brute_threshold      = brute_threshold    # login failures from one source...
        self.brute_window         = brute_window
        self.scan_ports           = scan_ports         # distinct denied ports from one source...
        self.scan_hosts           = scan_hosts         # ...or distinct denied hosts...
        self.scan_window          = scan_window        # ...within one window


RULES = Rules()


_RSSI_RE = re.compile(r'\s*(-?\d+)')


def rssi_value(fields):
    v = fields.get('rssi')
    return _rssi_int(v) if v else None


@functools.lru_cache(maxsize=1024)
def _rssi_int(text):
    m = _RSSI_RE.match(text)
    return int(m.group(1)) if m else None


def event_findings(p, rules=None):
    """Per-event (stateless) warnings: legacy SSID and low RSSI."""
    rules = rules or RULES
    out   = []
    ssid  = p.fields.get('ssid')
    if ssid and rules.legacy_re.search(ssid):
        out.append(f'legacy SSID {ssid}')
    rssi = rssi_value(p.fields)
    if rssi is not None and rssi < 0 and rssi < rules.low_rssi:
        out.append(f'low RSSI {rssi} dBm')
    return out


def _threat_tier(v):
    """Vendor threat severity (critical/high/medium/low, Meraki priority 1-3,
    Junos MAJOR/MINOR) → tier, or None."""
    v = (v or '').strip().lower()
    if v in ('critical', 'high', 'major', 'very-high', '1', 'emergency', 'alert'):
        return 'error'
    if v in ('medium', 'minor', 'warning', '2'):
        return 'warning'
    if v in ('low', 'informational', 'info', 'information', '3', '4', 'notice'):
        return 'info'
    return None


def event_severity(p, rules=None, findings=None):
    """'error' | 'warning' | 'success' | 'info' for a ParsedEvent.

    The event kind decides (a link-down is a warning however the device
    rates it); for hardware, STP, PoE and similar kinds the device's own
    syslog level decides; threats use the vendor's threat severity; events
    of unknown kind fall back to the syslog level.
    """
    kind = p.kind
    if kind == 'failure':
        return 'error'
    if kind == 'threat':
        return _threat_tier(p.fields.get('threat_sev')) or vendor_sev_tier(p.vsev) or 'error'
    if kind in _VENDOR_SEV_KINDS and p.vsev is not None:
        return vendor_sev_tier(p.vsev)
    base = KIND_SEVERITY.get(kind) if kind else None
    if base in (None, 'info', 'success') and \
            (findings if findings is not None else event_findings(p, rules)):
        return 'warning'
    if base:
        return base
    return vendor_sev_tier(p.vsev) or 'info'


