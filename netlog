def _duration_arg(text):
    """'300' / '90s' / '5m' / '1h' → seconds."""
    m = re.fullmatch(r'\s*(\d+(?:\.\d+)?)\s*([smh]?)\s*', text, re.I)
    if not m or float(m.group(1)) <= 0:
        raise argparse.ArgumentTypeError(f'invalid duration: {text!r} (try 300, 90s, 5m)')
    return float(m.group(1)) * {'': 1, 's': 1, 'm': 60, 'h': 3600}[m.group(2).lower()]


def parse_cli(argv=None):
    """Parse the command line. Returns the argparse namespace plus
    log_files (expanded globs) and egrep_pat."""
    p  = build_arg_parser()
    ns = p.parse_args(argv)
    if ns.follow and (ns.summary or ns.client):
        p.error('-f cannot be combined with --summary or --client')
    for opt in ('loop_threshold', 'flap_threshold', 'brute_threshold', 'scan_ports',
                'scan_hosts'):
        if getattr(ns, opt) < 1:
            p.error(f"--{opt.replace('_', '-')} must be at least 1")
    if ns.top < 1:
        p.error('--top must be at least 1')
    try:
        re.compile(ns.legacy_ssid)
    except re.error as e:
        p.error(f'invalid --legacy-ssid regex: {e}')

    positionals = ns.args
    if ns.follow and len(positionals) >= 2:
        ns.egrep_pat, *file_args = positionals
    else:
        ns.egrep_pat, file_args = None, positionals

    ns.log_files = []
    for a in file_args:
        matches = sorted(glob.glob(a))
        for f in (matches or [a]):
            ns.log_files.append(Path(f))
    return ns


def parse_args(argv=None):
    """Legacy tuple form of parse_cli()."""
    ns = parse_cli(argv)
    return ns.follow, ns.tail_lines, ns.log_files, ns.alert_pat, ns.egrep_pat, ns.setup_geoip


def main():
    global _GEO_READER, RULES
    opts = parse_cli()
    log_files, setup_geoip = opts.log_files, opts.setup_geoip
    RULES = Rules(loop_threshold=opts.loop_threshold, loop_window=opts.loop_window,
                  legacy_ssid=opts.legacy_ssid, low_rssi=opts.low_rssi, top=opts.top,
                  flap_threshold=opts.flap_threshold, flap_window=opts.flap_window,
                  brute_threshold=opts.brute_threshold, brute_window=opts.brute_window,
                  scan_ports=opts.scan_ports, scan_hosts=opts.scan_hosts,
                  scan_window=opts.scan_window)

    if opts.formats:
        print(format_list(sys.stdout.isatty() and 'NO_COLOR' not in os.environ))
        return

    cfg = load_config()
    if setup_geoip:
        setup_geoip_cmd(cfg)   # exits the process

    if opts.summary or opts.client:
        missing = [f for f in log_files if not f.exists()]
        if missing:
            sys.exit(f"File not found: {missing[0]}")
        if not log_files and sys.stdin.isatty():
            sys.exit('Usage: netlog --summary|--client MAC|USER <file> [file2 ...]  '
                     '(or pipe the log in)')
        analysis_mode(log_files, load_oui(OUI_FILE), opts.summary, opts.client)
        return

    vendors = load_oui(OUI_FILE)
    mac_map, idx, col_hidden = load_color_map(COLOR_FILE)
    ctr = [idx]

    # Never prompt interactively when stdin isn't a real terminal — e.g. piped
    # log input, cron, or CI would otherwise have input() read from the pipe.
    _GEO_READER = load_geoip(cfg, allow_prompt=sys.stdin.isatty())
    if _GEO_READER is None and not HAS_GEOIP:
        print("GeoIP: install 'maxminddb' for IP location lookup  (pip install maxminddb)",
              file=sys.stderr)

    prefs = {'wrap': opts.wrap if opts.wrap is not None else cfg.get('wrap', True)}
    start = dict(prefs)
    try:
        _run_view_mode(opts, prefs, vendors, mac_map, ctr, col_hidden)
    finally:
        if prefs != start:                     # toggled with l: remember it
            cfg = load_config()
            cfg.update(prefs)
            save_config(cfg)


def _run_view_mode(opts, prefs, vendors, mac_map, ctr, col_hidden):
    follow, tail_lines, log_files = opts.follow, opts.tail_lines, opts.log_files
    alert_pat, egrep_pat = opts.alert_pat, opts.egrep_pat
    if not sys.stdin.isatty():
        piped_mode(vendors, mac_map, ctr, prefs)
    elif follow:
        if not log_files:
            sys.exit('Usage: netlog -f [-n N] [--alert PATTERN] ["egrep_pattern"] <file>')
        lf = log_files[0]
        if not lf.exists():
            sys.exit(f"File not found: {lf}")
        file_base = _file_base(lf)
        tail_mode(lf, tail_lines, vendors, mac_map, ctr, alert_pat, col_hidden, file_base, egrep_pat,
                  prefs)
    elif log_files:
        missing = [f for f in log_files if not f.exists()]
        if missing:
            sys.exit(f"File not found: {missing[0]}")
        file_base = _file_base(log_files[0])
        interactive_mode(log_files, vendors, mac_map, ctr, alert_pat, col_hidden, file_base,
                         prefs)
    else:
        print('Usage: netlog [-f] [-n N] [--alert PATTERN] ["egrep_pattern"] <file> [file2 ...]',
              file=sys.stderr)
        print("Or:    cat file.log | netlog", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
