    '710003': 'access to device denied', '313001': 'ICMP denied', '411001': 'interface up',
    '411002': 'interface down', '419002': 'duplicate TCP SYN', '338001': 'botnet traffic'}


def _p_asa(line):
    m = _ASA_RE.search(line)
    if not m:
        return None
    prod, sev, mid, msg = m.groups()
    kind = _ASA_ID.get(mid)
    if mid == '106100':
        kind = 'deny' if 'denied' in msg else 'allow'
    if mid.startswith('4000') and kind is None:
        kind = 'threat'                      # IPS signature messages 400000-400050
    if kind is None:
        kind = classify_text('', msg)
    f = {}
    # "src outside:1.2.3.4/1234 dst inside:10.0.0.1/80"
    s = re.search(r'src (\S+?):([\d.a-fA-F:]+)/(\d+)\b.*?dst (\S+?):([\d.a-fA-F:]+)/(\d+)', msg)
    if s:
        f.update(src_zone=s.group(1), src_ip=s.group(2), src_port=s.group(3),
                 dst_zone=s.group(4), dst_ip=s.group(5), dst_port=s.group(6))
    else:
        # "denied tcp inside/10.0.0.1(1234) -> outside/8.8.8.8(80)"
        s = re.search(r'(\w+)/([\d.a-fA-F:]+)\((\d+)\)\s*->\s*(\w+)/([\d.a-fA-F:]+)\((\d+)\)', msg)
        if s:
            f.update(src_zone=s.group(1), src_ip=s.group(2), src_port=s.group(3),
                     dst_zone=s.group(4), dst_ip=s.group(5), dst_port=s.group(6))
        else:
            # "from 1.2.3.4/1234 to 10.0.0.1/80" / "for outside:1.2.3.4/123 (..) to inside:.."
            s = re.search(r'(?:from|for) (?:\w+:)?([\d.a-fA-F:]+)/(\d+)\b.*?\bto (?:\w+:)?'
                          r'([\d.a-fA-F:]+)/(\d+)', msg)
            if s:
                f.update(src_ip=s.group(1), src_port=s.group(2), dst_ip=s.group(3),
                         dst_port=s.group(4))
    p = re.search(r'\b(tcp|udp|icmp|gre|esp|ip)\b', msg, re.I)
    if p:
        f['proto'] = p.group(1).lower()
    rule = re.search(r'access-(?:group|list) "?([\w.\-]+)"?', msg)
    if rule:
        f['rule'] = rule.group(1)
    for k, v in _common_fields(msg, kind).items():
        f.setdefault(k, v)
    if kind in ('login_fail', 'login', 'logout'):
        u = re.search(r"\b[Uu]ser(?:name)?\s*=\s*'?<?([^\s,'>]+)", msg) or \
            re.search(r"\b[Uu]ser(?:name)?\s*:?\s*'?<?([^\s,'>]+)", msg)
        if u and u.group(1).lower() not in _NOT_USERS:
            f['user'] = u.group(1)
        elif f.get('user', '').lower() in _NOT_USERS:
            f.pop('user')
    if kind in ('vpn_up', 'vpn_down'):
        peer = re.search(r'\b(?:IP|peer|Peer|Remote)\s*=?\s*(\d{1,3}(?:\.\d{1,3}){3})', msg)
        if peer:
            f['peer'] = peer.group(1)
    desc = _ASA_DESC.get(mid)
    f.update(name=f'{prod}-{mid}' + (f' {desc}' if desc else ''), kind=kind, vsev=int(sev),
             msg=msg)
    return f


# Cisco IOS / IOS-XE / NX-OS / Catalyst 9800 / AireOS WLC, Arista EOS, Dell (FTOS):
#   %LINK-3-UPDOWN: Interface GigabitEthernet1/0/1, changed state to down
_CISCO_RE = re.compile(
    r'%([A-Z][A-Z0-9_]*(?:-[A-Z][A-Z0-9_]*)*?)-([0-7])-([A-Z][A-Z0-9_]*)\s*:\s*(.*)$')


def _p_cisco(line):
    m = _CISCO_RE.search(line)
    if not m or m.group(1) in ('ASA', 'FTD', 'PIX', 'FWSM'):
        return None
    fac, sev, mnem, msg = m.groups()
    msg  = re.sub(r'^(?:Chassis \d+ R\d/\d: \w+: |\w+\.c:\d+ )', '', msg)  # 9800 / AireOS
    tag  = f'{fac}-{mnem}'
    kind = classify_text(tag, msg)
    if tag == 'CLIENT_ORCH_LOG-CLIENT_ADDED_TO_RUN_STATE':
        kind = 'auth'
    f = _common_fields(msg, kind)
    if fac in ('CLIENT_ORCH_LOG', 'CLIENT_EXCLUSION_SERVER', 'SESSION_MGR', 'DOT1X', 'MAB',
               'AUTHMGR', 'APF', 'DOT11', 'WEBAUTH', 'EWLC_CLIENT', 'DOT1X_SWITCH'):
        mac = _first_mac(msg)
        if mac:
            f['client_mac'] = mac
        ssid = re.search(r'ssid \(([^)]+)\)', msg, re.I)
        if ssid:
            f['ssid'] = ssid.group(1)
        u = re.search(r'Username entry \(([^)]+)\)', msg)
        if u:
            f['user'] = u.group(1)
        r = re.search(r'(?:Authc failure|Failure) reason:\s*([^.]+)', msg)
        if r:
            f['reason'] = r.group(1)
    ap = re.search(r'AP Name:\s*([^,]+)', msg)
    if ap:
        f['ap_name'] = ap.group(1).strip()
        mac = _first_mac(msg)
        if mac:
            f['ap_mac'] = mac
            f.pop('client_mac', None)
    if kind == 'loop':
        v = re.search(r'\bvlan (\d+)', msg, re.I)
        if v:
            f['vlan'] = v.group(1)
    f.update(name=tag, kind=kind, vsev=int(sev), msg=msg)
    return f


# HPE Comware (H3C/FlexNetwork) and Huawei VRP:
#   IFNET/3/PHY_UPDOWN: Physical state on the interface GigabitEthernet1/0/1 changed to down.
#   %%01IFNET/4/LINK_STATE(l)[0]:The line protocol IP on the interface ... entered the DOWN state.
_COMWARE_RE = re.compile(
    r'(?:%%\d+)?\b([A-Z][A-Z0-9_]+)/([0-7])/([A-Za-z][A-Za-z0-9_]*)(?:\([a-z]+\))?'
    r'(?:\[\d+\])?:\s*(.*)$')


def _p_comware(line):
    m = _COMWARE_RE.search(line)
    if not m:
        return None
    mod, sev, mnem, msg = m.groups()
    tag  = f'{mod}/{mnem}'
    kind = classify_text(tag.replace('/', '-'), msg)
    f    = _common_fields(msg, kind)
    f.update(name=tag, kind=kind, vsev=int(sev), msg=msg)
    return f


# Juniper Junos (EX/QFX/MX/SRX):  rpd[1234]: RPD_OSPF_NBRDOWN: OSPF neighbor 10.0.0.2 ...
#   or RFC 5424 structured-data: ... RT_FLOW - RT_FLOW_SESSION_DENY [junos@2636.1.1.1.2.40 k="v" ...]
_JUNOS_TAGS = (r'RT_FLOW|RT_IDP|RT_SCREEN|RT_UTM|RT_AAMW|RT_SECINTEL|SNMP_TRAP|RPD_|BGP_|'
               r'UI_|SSHD_|LOGIN_|ESWD_|L2ALD_|LACPD_|CHASSISD_|KMD_|DOT1XD_|BFDD_|VRRPD_|'
               r'DCD_|MIB2D_|PFE_|JTASK_|COSD_|AUTHD_|LLDPD_|DHCPD_|JSRPD_|FLOW_|IDP_|'
               r'L2CPD_|STP_|ERRMSG|RPD_|PAM_|JDHCPD_|LICENSE_')
_JUNOS_RE = re.compile(r'(?:^|[\s:])((?:' + _JUNOS_TAGS + r')[A-Z0-9_]*)(?::\s+|\s+\[junos@[\d.]+\s+|\s*$)(.*)$')
_JUNOS_SD_RE = re.compile(r'\b(' + _JUNOS_TAGS + r')[A-Z0-9_]*\s+\[junos@')
_JUNOS_MAP = {'source-address': 'src_ip', 'destination-address': 'dst_ip',
              'source-port': 'src_port', 'destination-port': 'dst_port',
              'policy-name': 'rule', 'protocol-id': 'proto', 'username': 'user',
              'source-zone-name': 'src_zone', 'destination-zone-name': 'dst_zone',
              'attack-name': 'signature', 'threat-severity': 'threat_sev',
              'interface-name': 'iface', 'packet-incoming-interface': 'iface',
              'reason': 'reason', 'application': 'app'}


def _p_junos(line):
    m = _JUNOS_RE.search(line)
    if not m:
        return None
    tag, msg = m.group(1), m.group(2)
    inner = re.match(r'([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+):\s*(.*)$', msg)
    if inner:                       # "RT_FLOW: RT_FLOW_SESSION_DENY: ..." → the inner tag
        tag, msg = inner.groups()
    f = {}
    if '[junos@' in line:
        sd = line[line.index('[junos@'):]
        f  = _map_fields(_kv_pairs(sd), _JUNOS_MAP)
        msg = sd.split(']', 1)[1].strip() if ']' in sd else ''
    if tag.startswith('RT_FLOW_SESSION_DENY'):
        kind = 'deny'
    elif tag.startswith('RT_FLOW_SESSION_CREATE'):
        kind = 'allow'
    elif tag.startswith('RT_FLOW_SESSION_CLOSE'):
        kind = 'session'
    elif tag.startswith(('RT_IDP', 'RT_SCREEN', 'RT_AAMW', 'RT_SECINTEL', 'IDP_')):
        kind = 'threat'
    elif tag.startswith('RT_UTM') and re.search(r'block|deny|virus', tag + msg, re.I):
        kind = 'threat'
    elif tag.startswith('SNMP_TRAP_LINK_'):
        kind = 'link_down' if tag.endswith('DOWN') else 'link_up'
        n = re.search(r'ifName (\S+)', msg)
        if n:
            f['iface'] = n.group(1).rstrip(',')
    elif 'BGP' in tag and 'STATE_CHANGED' in tag:
        s = re.search(r'from (\w+) to (\w+)', msg)
        kind = ('neighbor_up' if s and s.group(2) == 'Established'
                else 'neighbor_down' if s and s.group(1) == 'Established'
                else None)
        n = re.search(r'peer ([\da-fA-F.:]+)', msg)
        if n:
            f['neighbor'] = n.group(1)
    else:
        kind = classify_text(tag, msg)
    if tag.startswith('RT_FLOW') and 'src_ip' not in f:
        s = re.search(r'([\da-fA-F.:]+)/(\d+)->([\da-fA-F.:]+)/(\d+)', msg)
        if s:
            f.update(src_ip=s.group(1), src_port=s.group(2), dst_ip=s.group(3),
                     dst_port=s.group(4))
        p = re.search(r'\s(\d+)\(\d+\)\s+(\S+)\s+(\S+)\s+(\S+)', msg)
        if p:
            f.update(proto=_PROTO_NUM.get(p.group(1), p.group(1)), rule=p.group(2),
                     src_zone=p.group(3), dst_zone=p.group(4))
    if tag.startswith('RT_SCREEN'):
        a = re.search(r'attack-name: ([^!]+)!?.*?source: ([\d.a-fA-F:]+)(?::(\d+))?'
                      r'.*?destination: ([\d.a-fA-F:]+)(?::(\d+))?', msg)
        if a:
            f.update(signature=a.group(1).strip(), src_ip=a.group(2), dst_ip=a.group(4))
            if a.group(5):
                f['dst_port'] = a.group(5)
    if kind in ('login_fail', 'login', 'config', 'logout'):
        u = re.search(r"user '([^']+)'", msg, re.I) or re.search(r"User '([^']+)'", msg)
        if u:
            f['user'] = u.group(1)
        h = re.search(r"from host '([^']+)'", msg)
        if h:
            f['src_ip'] = h.group(1)
    for k, v in _common_fields(msg, kind).items():
        f.setdefault(k, v)
    f.update(name=tag, kind=kind, msg=msg)
    return f


# Fortinet FortiGate (and FortiAP via FortiGate):
#   date=2024-03-01 time=12:00:00 devname="FGT" devid="FG.." logid="0000000013" type="traffic" ...
_FORTI_MAP = {'srcip': 'src_ip', 'dstip': 'dst_ip', 'srcport': 'src_port', 'dstport': 'dst_port',
              'srcintf': 'iface',
              'dstintf': 'out_iface', 'user': 'user', 'unauthuser': 'user', 'srcmac': 'client_mac',
              'stamac': 'client_mac', 'ssid': 'ssid', 'ap': 'ap_name', 'apname': 'ap_name',
              'signal': 'rssi', 'reason': 'reason', 'status': 'status', 'msg': 'msg',
              'attack': 'signature', 'virus': 'signature', 'remip': 'peer', 'vpntunnel': 'tunnel',
              'devname': 'host', 'service': 'service', 'action': 'action', 'crlevel': 'threat_sev',
              'severity': 'threat_sev', 'ui': 'ui', 'logdesc': 'logdesc', 'eventtime': 'epoch',
              'srcname': 'client_host'}


def _p_fortinet(line):
    if 'logid=' not in line or 'type=' not in line:
        return None
    raw = _kv_pairs(line)
    if 'logid' not in raw:
        return None
    f    = _map_fields(raw, _FORTI_MAP)
    typ  = raw.get('type', '')
    sub  = raw.get('subtype', '')
    act  = raw.get('action', '').lower()
    desc = raw.get('logdesc', '') or raw.get('msg', '')
    text = f"{desc} {raw.get('msg', '')} {act} {raw.get('status', '')}"
    kind = None
    if typ == 'traffic':
        kind = 'deny' if act in ('deny', 'block', 'blocked', 'dropped', 'drop') else 'allow'
    elif typ in ('utm', 'ips', 'virus', 'anomaly', 'webfilter', 'app-ctrl', 'dns', 'emailfilter',
                 'dlp', 'waf', 'ssl', 'file-filter') or sub in ('ips', 'virus', 'anomaly', 'botnet'):
        threatish = (sub in ('ips', 'virus', 'anomaly', 'botnet', 'malware') or
                     typ in ('ips', 'virus', 'anomaly'))
        if threatish:
            kind = 'threat'
        elif act in ('blocked', 'block', 'deny', 'dropped', 'reset'):
            kind = 'deny'
        else:
            kind = 'allow'
    elif typ == 'event':
        if sub == 'wireless':
            kind = (_kind_of(desc.replace(' ', '')) if desc else None) or classify_text('', text)
            if re.search(r'rogue', text, re.I):
                kind = 'violation'
        elif sub == 'vpn':
            kind = ('vpn_up' if act == 'tunnel-up' else
                    'vpn_down' if act in ('tunnel-down', 'tunnel-stats') and 'down' in act else
                    'vpn_down' if re.search(r'fail|error', raw.get('status', ''), re.I) else
                    classify_text('VPN', text) if act != 'tunnel-stats' else 'session')
        elif sub in ('user', 'endpoint', 'fortiextender') or act in ('login', 'logout', 'auth-logon'):
            st = raw.get('status', '').lower()
            if act == 'logout':
                kind = 'logout'
            elif st in ('failure', 'failed', 'fail', 'deny', 'denied') or 'fail' in text.lower():
                kind = 'login_fail'
            elif act in ('login', 'authentication', 'auth-logon') or st == 'success':
                kind = 'login'
        elif sub == 'ha':
            kind = 'failover'
        if kind is None:
            kind = classify_text(raw.get('logid', ''), text)
    if 'client_mac' in f:
        f['client_mac'] = norm_mac(f['client_mac']) or f.pop('client_mac')
    if raw.get('policyid'):
        f['rule'] = raw.get('policyname') or (
            'implicit deny (policy 0)' if raw['policyid'] == '0' else f'policy {raw["policyid"]}')
    if 'proto' not in f and raw.get('proto'):
        f['proto'] = _PROTO_NUM.get(raw['proto'], raw['proto'])
    if kind in ('login_fail', 'login') and 'src_ip' not in f:
        ip = re.search(r'\((\d{1,3}(?:\.\d{1,3}){3})\)', raw.get('ui', ''))
        if ip:
            f['src_ip'] = ip.group(1)
    if 'date' in raw and 'time' in raw:
        f['when'] = f"{raw['date']}T{raw['time']}"
    name = desc or f'{typ}/{sub}'
    f.update(name=name, kind=kind, vsev=SEV_NAMES.get(raw.get('level', '').lower()),
             code=raw.get('logid'))
    return f


# Palo Alto PAN-OS (CSV syslog). Field positions from the PAN-OS syslog field
# reference: 0 FUTURE_USE, 1 receive time, 2 serial, 3 type, 4 subtype, ...
_PAN_RE = re.compile(
    r'(?:^|[\s:])\d+,(\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}),([^,]*),(TRAFFIC|THREAT|SYSTEM|'
    r'CONFIG|GLOBALPROTECT|USERID|AUTH|HIPMATCH|DECRYPTION|CORRELATION|URL|IPTAG|TUNNEL|SCTP),')
_PAN_DENY   = {'deny', 'drop', 'drop icmp', 'drop-icmp', 'reset-both', 'reset-client',
               'reset-server', 'reset both', 'reset client', 'reset server', 'block-url',
               'block-ip', 'drop-all-packets', 'block', 'sinkhole', 'block-continue'}
_PAN_THREAT = {'virus', 'spyware', 'vulnerability', 'wildfire', 'wildfire-virus', 'flood',
               'scan', 'packet', 'ml-virus'}


def _p_paloalto(line):
    m = _PAN_RE.search(line)
    if not m:
        return None
    try:
        row = next(csv.reader([line[m.start() + (line[m.start()] in ' :'):]]))
    except (csv.Error, StopIteration):
        return None
    g = lambda i: row[i] if len(row) > i and row[i] not in ('', 'N/A') else None
    typ, sub = row[3], (g(4) or '')
    f = {'when': row[1].replace('/', '-')}
    kind = None
    if typ in ('TRAFFIC', 'THREAT', 'DECRYPTION', 'URL'):
        f.update({k: v for k, v in (
            ('src_ip', g(7)), ('dst_ip', g(8)), ('rule', g(11)), ('user', g(12)),
            ('app', g(14)), ('src_zone', g(16)), ('dst_zone', g(17)), ('iface', g(18)),
            ('src_port', g(24)), ('dst_port', g(25)), ('proto', g(29)), ('action', g(30)))
            if v and v != '0'})
        act = (g(30) or '').lower()
        if typ == 'TRAFFIC':
            kind = 'deny' if act in _PAN_DENY or sub in ('deny', 'drop') else (
                'allow' if sub == 'start' else 'session')
        elif typ == 'THREAT':
            f['signature'] = g(32)
            f['threat_sev'] = g(34)
            if sub in _PAN_THREAT:
                kind = 'threat'
            else:
                kind = 'deny' if act in _PAN_DENY else 'allow'
        else:
            kind = 'deny' if act in _PAN_DENY else 'session'
        name = f'{typ.lower()}/{sub}' + (f' {act}' if act else '')
        if typ == 'THREAT' and f.get('signature'):
            name = f.get('signature')
    elif typ == 'SYSTEM':
        # 7 vsys, 8 event id, 9 object, 12 module, 13 severity, 14 description
        eid, desc = g(8) or sub, g(14) or ''
        f['msg'] = desc
        f['threat_sev'] = g(13)
        if 'auth-fail' in eid or re.search(r'auth(?:entication)? fail', desc, re.I):
            kind = 'login_fail'
        elif 'auth-success' in eid or 'login' in eid:
            kind = 'login'
        elif eid.startswith('link-change') or 'link' in eid:
            kind = _updown(desc, 'link_down', 'link_up')
        elif eid.startswith(('ike-', 'ipsec-', 'tunnel-')) or 'vpn' in eid or sub == 'vpn':
            kind = 'vpn_down' if re.search(r'fail|down|delete|expire', eid + desc, re.I) \
                else 'vpn_up' if re.search(r'success|up\b|established', eid + desc, re.I) else None
        elif eid.startswith(('bgp', 'ospf', 'routed')) or sub == 'routing':
            kind = _neighbor_kind(desc)
        elif eid.startswith('ha') or sub == 'ha':
            kind = 'failover'
        else:
            kind = classify_text(eid.upper(), desc)
        for k, v in _common_fields(desc, kind).items():
            f.setdefault(k, v)
        u = re.search(r"[Uu]ser(?:name)?[: ]+'?([^\s',.]+)", desc)
        if u and kind in ('login_fail', 'login'):
            f['user'] = u.group(1)
        name = eid
    elif typ == 'CONFIG':
        # 7 host, 8 vsys, 9 command, 10 admin, 11 client, 12 result, 13 path
        kind = 'config'
        f.update({k: v for k, v in (('src_ip', g(7)), ('user', g(10)), ('status', g(12)))
                  if v})
        name = f'config {g(9) or ""}'.strip()
    elif typ == 'GLOBALPROTECT':
        # 8 event id, 9 stage, 10 auth method, 12 source user, 15 public IP, ... status later
        st   = next((c for c in row[24:] if c in ('success', 'failure')), '')
        kind = 'login_fail' if st == 'failure' else ('login' if st == 'success' else None)
        f.update({k: v for k, v in (('user', g(12)), ('src_ip', g(15)), ('status', st)) if v})
        name = f'globalprotect {g(8) or sub}'
    elif typ in ('USERID', 'AUTH'):
        kind = 'login_fail' if re.search(r'fail', ','.join(row[4:]), re.I) else 'login'
        name = f'{typ.lower()}/{sub}'
    else:
        name = f'{typ.lower()}/{sub}'
    f.update(name=name, kind=kind)
    return f


# Cisco Meraki (MR/MS/MX):  <134>1 1709294400.123456789 MR42 events type=association ...
