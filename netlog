def _client_key(f):
    if f.get('client_mac'):
        return f['client_mac']
    return f'user:{norm_user(f["user"])}' if 'user' in f else None


def _login_key(f):
    if f.get('src_ip'):
        return f['src_ip']
    return f'user:{f["user"]}' if 'user' in f else None


def _link_key(f):
    return f'{f.get("host", "?")} {f["iface"]}' if f.get('iface') else None


# (id, failure kinds, recovery kinds, key, threshold rule, window rule, banner title)
_LIVE_TRACKERS = (
    ('client', {'failure'}, {'join', 'auth'}, _client_key,
     'loop_threshold', 'loop_window', 'FAILURE LOOP'),
    ('login', {'login_fail'}, {'login'}, _login_key,
     'brute_threshold', 'brute_window', 'LOGIN ATTACK'),
    ('link', {'link_down'}, set(), _link_key,
     'flap_threshold', 'flap_window', 'INTERFACE FLAPPING'),
)


class LiveCorrelator:
    """Groups related problem lines visually as they stream past.

    Three trackers: a client's failure loop (keyed by client MAC/user), login
    failures from one source (brute force), and link-downs on one interface
    (flapping). When one hits its threshold a banner is printed, and the
    following lines for that key get a side bar until it recovers (successful
    join/auth or login) or the window passes quietly.
    """
    def __init__(self, mac_map, ctr, rules=None, color=True):
        self.rules   = rules or RULES
        self.mac_map = mac_map
        self.ctr     = ctr
        self.s       = _Style(color)
        self.state   = {}

    def _code(self, tid, key):
        if tid == 'client' and not key.startswith('user:'):
            return ANSI_MAC[mac_color(key.replace(':', '').upper(), self.mac_map, self.ctr)]
        return '1;33' if tid == 'link' else '1;31'

    def process(self, line):
        """Return (before_lines, gutter, suffix) to decorate `line` with."""
        p = parse_event(line)
        if p is None or p.kind is None:
            return [], '', ''
        before, gutter, suffix = [], '', ''
        for tracker in _LIVE_TRACKERS:
            key = tracker[3](p.fields)
            if key is None:
                continue
            b, g, sfx = self._track(tracker, key, p)
            before += b
            if g and not gutter:
                gutter, suffix = g, sfx
        return before, gutter, suffix

    def _track(self, tracker, key, p):
        tid, fails, recovers, _keyfn, thr_name, win_name, title = tracker
        threshold = getattr(self.rules, thr_name)
        window    = getattr(self.rules, win_name)
        sk = (tid, key)
        st = self.state.get(sk)
        if st is None:
            if p.kind not in fails:
                return [], '', ''
            st = self.state[sk] = {'fails': collections.deque(), 'loop': None, 'last': None}
        ts = p.ts if p.ts is not None else (st['last'] if st['last'] is not None else 0.0)
        st['last'] = ts

        s, f   = self.s, p.fields
        code   = self._code(tid, key)
        who    = key[5:] if key.startswith('user:') else key
        if tid in ('client', 'login') and 'user' in f and not key.startswith('user:'):
            who += f' ({f["user"]})'
        before, gutter, suffix = [], '', ''
        lp = st['loop']
        if lp and ts - lp['last'] > window:
            before.append(s(f'┗━ {who}: {title.lower()} ended — {lp["count"]} events over '
                            f'{_fmt_dur(lp["last"] - lp["start"])}'
                            + (', no recovery seen' if recovers else ''), code))
            st['loop'] = lp = None

        kind = p.kind
        if tid == 'link':
            # LINK + LINEPROTO both report each flap; only a down after an up counts.
            if kind == 'link_down' and st.get('down'):
                kind = 'repeat'
            st['down'] = kind in ('link_down', 'repeat') or (st.get('down') and kind != 'link_up')
        if kind in fails:
            dq = st['fails']
            dq.append(ts)
            while ts - dq[0] > window:
                dq.popleft()
            if lp:
                lp['count'] += 1
                lp['last']   = ts
                gutter = s('┃ ', code)
            elif len(dq) >= threshold:
                st['loop'] = {'start': dq[0], 'last': ts, 'count': len(dq)}
                where = f.get('ap_name') or f.get('ap_mac') if tid == 'client' else None
                before.append(s(f'┏━ ⚠ {title}: {who} — {len(dq)} '
                                f'{"failures" if tid != "link" else "link downs"} in '
                                f'{_fmt_dur(ts - dq[0])}' + (f' @ {where}' if where else ''), code))
                gutter = s('┃ ', code)
        elif kind in recovers:
            st['fails'].clear()
            if lp:
                gutter = s('┗━', code)
                dur = _fmt_dur(ts - lp['start'])
                suffix = (s(f'  ✓ recovered after {lp["count"]} failures ({dur})', ANSI_EV_ALLOW)
                          if tid == 'client' else
                          s(f'  ⚠ login succeeded after {lp["count"]} failures ({dur})', '1;31'))
                st['loop'] = None
        elif lp:
            gutter = s('┃ ', code)
        return before, gutter, suffix


def _prefix_last_line(text, prefix):
    """Put `prefix` on the last line of `text` (after any loop banners)."""
    head, nl, last = text.rpartition('\n')
    return head + nl + prefix + last


def render_live(line, display, corr, vendors, mac_map, ctr):
    """ANSI output for one streamed line: loop banners + side bar + highlight.
    `line` is the original text (for correlation), `display` what to show
    (e.g. with columns hidden)."""
    before, gutter, suffix = corr.process(line) if corr else ([], '', '')
    return '\n'.join(before + [gutter + highlight_ansi(display, vendors, mac_map, ctr) + suffix])


def iter_log_lines(files):
    """Lines from the given files (.gz transparently), or stdin if none."""
    if not files:
        for line in sys.stdin:
            yield line.rstrip('\r\n')
        return
    for f in files:
        opener = gzip.open if f.name.endswith('.gz') else open
        with opener(f, 'rt', errors='replace') as fh:
            for line in fh:
                yield line.rstrip('\r\n')


def analysis_mode(files, vendors, summary=False, client=None, keep=None, grep='', xform=None):
    color = sys.stdout.isatty() and 'NO_COLOR' not in os.environ
    ctx   = {norm_mac(client)} if client and norm_mac(client) else None
    an    = Analyzer(context_macs=ctx)
    try:
        for line in iter_log_lines(files):
            if xform:
                line = xform(line)
            if keep is None or keep(line):
                an.feed(line)
    except OSError as e:
        sys.exit(f'Error reading log: {e}')
    rep = Report(an)
    if summary:
        sources = ', '.join(str(f) for f in files) if files else 'stdin'
        if keep:
            sources += f'  (grep: {grep})'
        if xform:
            sources += f'  (times: UTC → {local_tz_label()})'
        print(format_summary(rep, vendors, color, sources))
    if client:
        if summary:
            print()
        text, found = format_timeline(rep, client, vendors, color)
        print(text)
        if not found:
            sys.exit(1)


